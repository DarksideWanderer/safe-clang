+
+void CircleMatchExpr::initialize(const ASTContext &C, SourceLocation L,
+                                 QualType Result, Expr *Operand) {
+  Loc = L;
+  ResultType = Result;
+  unsigned I = 0;
+  Children[I++] = Operand;
+  auto Dependence = ExprDependence::TypeValueInstantiation | Operand->getDependence();
+  for (const auto &P : patterns()) {
+    Children[I++] = P.Low;
+    Children[I++] = P.High;
+  }
+  for (const auto &A : arms()) {
+    Children[I++] = A.Guard;
+    if (A.Guard) Dependence |= A.Guard->getDependence();
+    Children[I++] = A.Body;
+    Dependence |= A.Body->getDependence();
+  }
+  setDependence(Dependence);
+}
