+//===-- CircleSafety.h - Native Circle safety boundaries ---------*- C++ -*-===//
+#ifndef LLVM_CLANG_AST_CIRCLESAFETY_H
+#define LLVM_CLANG_AST_CIRCLESAFETY_H
+
+#include "clang/AST/Attr.h"
+#include "clang/AST/Decl.h"
+#include "clang/AST/ExprCXX.h"
+#include "clang/AST/Stmt.h"
+
+namespace clang {
+// This bit is produced only by the native whole-tuple syntax, never by a
+// source annotation or by ordinary parenthesization.
+inline bool circleTupleSplatPattern(const Expr *E) {
+  while (E) {
+    if (const auto *P = dyn_cast<ParenExpr>(E)) {
+      if (P->isCircleTupleSplat()) return true;
+      E = P->getSubExpr();
+    } else if (const auto *U = dyn_cast<UnaryOperator>(E);
+               U && U->getOpcode() == UO_Relocate) E = U->getSubExpr();
+    else return false;
+  }
+  return false;
+}
+// Source declarations cannot create implicit variables. Template substitution
+// retains that property even when it recreates an annotation attribute.
+inline const CompoundStmt *circleUnsafeBody(const IfStmt *S) {
+  if (!S || S->getInit() || S->getElse()) return nullptr;
+  const VarDecl *V = S->getConditionVariable();
+  if (!V || !V->isImplicit() || !V->getType().isConstQualified())
+    return nullptr;
+  const auto *Value = dyn_cast_or_null<CXXBoolLiteralExpr>(V->getInit());
+  if (!Value || !Value->getValue()) return nullptr;
+  for (const auto *A : V->specific_attrs<AnnotateAttr>())
+    if (A->getAnnotation() == "safecpp.unsafe.scope")
+      return dyn_cast<CompoundStmt>(S->getThen());
+  return nullptr;
+}
+} // namespace clang
+#endif
