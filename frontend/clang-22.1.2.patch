+CXXRecordDecl *Sema::getCircleImplementation(QualType Target,
+                                             QualType Interface,
+                                             SourceLocation Loc) {
+  return circleMemberImpl(*this, Context.getTranslationUnitDecl(), Target,
+                          Interface, Loc);
+}
