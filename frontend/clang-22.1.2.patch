+bool Sema::ActOnCircleMatchArm(SourceLocation Loc,
+                               std::unique_ptr<CirclePattern> Pattern,
+                               bool IntroduceBindings) {
+  if (CircleMatches.empty())
+    return true;
+  CircleMatches.back().Arms.emplace_back();
+  CircleMatchArm &Arm = CircleMatches.back().Arms.back();
+  Arm.Loc = Loc;
+  Arm.Pattern = std::move(Pattern);
+  if (!Arm.Pattern)
+    return true;
+  Expr *Operand = CircleMatches.back().Operand;
+  QualType Subject =
+      Operand ? Operand->getType().getNonReferenceType().getUnqualifiedType()
+              : QualType();
+  return BuildCirclePatternBindings(*this, Subject, *Arm.Pattern, false,
+                                    IntroduceBindings);
+}
