+Value *ScalarExprEmitter::EmitCircleCheckedSignedArithmetic(
+    const BinOpInfo &Ops, llvm::Intrinsic::ID ID) {
+  if (!CGF.ShouldEmitCircleSafetyChecks() ||
+      !Ops.Ty->isSignedIntegerOrEnumerationType() ||
+      !Ops.LHS->getType()->isIntegerTy())
