+    if (const auto *Pack = Type->getAs<PackExpansionType>()) Type = Pack->getPattern();
+    if (const auto *Borrow = Type->getAs<BorrowValueType>())
+      Type = Borrow->getPointeeType();
+    if (circleIsCallableValue(Type)) {
+      unsigned Region = 0;
+      for (unsigned Capture : circleCallableCaptures(Type)) {
+        unsigned Binding;
+        if (circleCaptureDepth(Capture) == 1) {
+          unsigned Slot = circleCaptureSlot(Capture);
+          if (!Slot || Slot > D.NativeLifetimeParameters.size()) return false;
+          Binding = ID(Slot - 1);
+        } else {
