+    if (ExpectAndConsume(tok::r_square))
+      return nullptr;
+    return Pattern;
+  }
+  if (Tok.is(tok::period)) {
+    ConsumeToken();
+    if (!Tok.is(tok::identifier))
+      return Fail("expected an alternative name after '.'");
+    Pattern->K = Sema::CirclePattern::Alternative;
+    Pattern->Name = Tok.getIdentifierInfo();
+    ConsumeToken();
+    if (!TryConsumeToken(tok::l_paren))
+      return Pattern;
+    if (TryConsumeToken(tok::caret)) {
+      Pattern->Borrow = true;
+      if (!Tok.is(tok::identifier))
+        return Fail("expected the name the payload binds to");
+      if (!Tok.getIdentifierInfo()->isStr("_"))
+        Pattern->BindingName = Tok.getIdentifierInfo();
+      ConsumeToken();
+    } else if (Tok.is(tok::l_square) || Tok.is(tok::l_paren) ||
+               Tok.is(tok::minus) || Tok.is(tok::plus) ||
+               Tok.is(tok::period) || Tok.is(tok::kw_default) ||
+               Tok.is(tok::kw_true) || Tok.is(tok::kw_false) ||
+               Tok.is(tok::numeric_constant)) {
