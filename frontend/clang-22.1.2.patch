+/// `__rel_write(T*, T)` stores a fresh value into an owning place whose old
+/// contents the caller has already relocated out. It lowers to a direct store,
+/// so the value is written without invoking assignment operators.
+static ExprResult CircleRelWrite(Sema &S, CallExpr *TheCall) {
+  if (S.checkArgCount(TheCall, 2))
+    return ExprError();
+  if (TheCall->getArg(0)->containsErrors() ||
+      TheCall->getArg(1)->containsErrors())
+    return ExprError();
+  QualType P = TheCall->getArg(0)->getType().getNonReferenceType();
+  if (!P->isPointerType()) {
+    S.Diag(TheCall->getBeginLoc(), S.getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "native relocation write requires a pointer to an owning place"));
+    return ExprError();
+  }
+  ExprResult Place = S.BuildUnaryOp(nullptr, TheCall->getExprLoc(), UO_Deref,
+                                    TheCall->getArg(0));
+  if (Place.isInvalid())
+    return ExprError();
+  QualType Value = P->getPointeeType().getNonReferenceType();
+  if (Place.get()->isTypeDependent() || TheCall->getArg(1)->isTypeDependent())
+    return TheCall;
