+/// The elements of a tuple value written as a parenthesized list. Such a list
+/// is a comma expression — `(a, b, c)` — or an explicit paren list; its
+/// elements are the operands in order. Returns false when the expression is
+/// not a parenthesized list.
+static bool circleTupleElements(Expr *E, llvm::SmallVectorImpl<Expr *> &Out) {
+  E = E->IgnoreParenImpCasts();
+  if (auto *List = dyn_cast<ParenListExpr>(E)) {
+    Out.append(List->exprs().begin(), List->exprs().end());
+    return true;
+  }
+  auto *Comma = dyn_cast<BinaryOperator>(E);
+  if (!Comma || Comma->getOpcode() != BO_Comma)
+    // A single element without a comma is not a list.
+    return false;
+  // `(a, b, c)` is a left spine of comma expressions: everything the left
+  // operand holds comes first and its last operand is the final element.
+  if (!circleTupleElements(Comma->getLHS(), Out))
+    Out.push_back(Comma->getLHS()->IgnoreParenImpCasts());
+  Out.push_back(Comma->getRHS()->IgnoreParenImpCasts());
+  return true;
