+/// The `choice` type named by an alternative, searched from the innermost
+/// declaration context outwards. Circle infers the type from the expected
+/// type; a member of the choice type itself is the common case.
+static bool circleChoiceForAlternative(Sema &S, IdentifierInfo *Name,
+                                       CircleChoice &Out) {
+  for (DeclContext *DC = S.CurContext; DC; DC = DC->getParent()) {
+    auto *Record = dyn_cast<CXXRecordDecl>(DC);
+    if (!Record)
+      continue;
+    CircleChoice Choice;
