+      ++Region;
+      if (!Argument) return false;
+      unsigned Binding = 0x40000000u;
+      bool Static = Argument->isStr("static") ||
+          llvm::any_of(D.NativeStaticLifetimeConstraints, [&](auto Constraint) {
+            return Constraint.first == Argument;
+          });
+      if (!Static) {
+        auto Node = Resolve(Argument->getName());
+        if (!Node) return false;
+        Binding = ID(*Node);
+      }
+      // Static result provenance is already canonicalized by ReturnBorrow.
+      // Keep explicit /static and an equivalent static-bound result identical.
+      if (Position || !Static || MultiRegionResult)
