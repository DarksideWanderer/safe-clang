+    : Expr(CircleMatchExprClass, T, VK_PRValue, OK_Ordinary),
+      NumPatterns(NP), NumArms(NA),
+      Patterns(static_cast<Pattern *>(C.Allocate(sizeof(Pattern) * NP, alignof(Pattern)))),
+      Arms(static_cast<Arm *>(C.Allocate(sizeof(Arm) * NA, alignof(Arm)))),
+      Children(static_cast<Stmt **>(C.Allocate(sizeof(Stmt *) * (1 + NP * 2 + NA * 2), alignof(Stmt *)))) {
