+static bool isCircleImplQueryTemplate(const ClassTemplateDecl *Template) {
+  return llvm::any_of(Template->specific_attrs<AnnotateAttr>(),
+                      [](const AnnotateAttr *A) {
+                        return A->getAnnotation() ==
+                               "safecpp.native.impl.query";
+                      });
 }
 
+static bool prepareCircleImplQuery(Sema &S, ClassTemplateDecl *Template,
+                                   TemplateArgumentListInfo &Args,
+                                   SourceLocation Loc) {
+  if (!Template || Args.size() != 2 ||
+      !Args[0].getTypeSourceInfo() || !Args[1].getTypeSourceInfo())
+    return false;
+  QualType Target = Args[0].getTypeSourceInfo()->getType();
+  QualType Interface = Args[1].getTypeSourceInfo()->getType();
+  auto *Implementation =
+      S.getCircleImplementation(Target, Interface, Loc);
+  if (!Implementation) {
+    S.Diag(Loc, S.getDiagnostics().getCustomDiagID(
+                    DiagnosticsEngine::Error,
+                    "no unique Circle impl for this target and interface"));
+    return true;
+  }
+
+  ASTContext &C = S.Context;
+  SmallVector<TemplateArgument, 2> Canonical{
+      TemplateArgument(C.getCanonicalType(Target)),
+      TemplateArgument(C.getCanonicalType(Interface))};
+  void *InsertPos = nullptr;
+  auto *Specialization =
+      Template->findSpecialization(Canonical, InsertPos);
+  if (!Specialization) {
+    Specialization = ClassTemplateSpecializationDecl::Create(
+        C, Template->getTemplatedDecl()->getTagKind(),
+        Template->getDeclContext(), Loc, Loc, Template, Canonical,
+        /*StrictPackMatch=*/false, nullptr);
+    Template->AddSpecialization(Specialization, InsertPos);
+  }
+  if (!Specialization->hasDefinition()) {
+    Specialization->startDefinition();
+    Specialization->setImplicit(true);
+    for (auto *Decl : Implementation->decls()) {
+      auto *Alias = dyn_cast<TypeAliasDecl>(Decl);
+      if (!Alias || !Alias->getIdentifier())
+        continue;
+      bool ContractAlias = llvm::any_of(
+          Alias->specific_attrs<AnnotateAttr>(), [](const AnnotateAttr *A) {
+            return A->getAnnotation().starts_with("safecpp.native.impl.");
+          });
+      if (ContractAlias)
+        continue;
+      TypeSourceInfo *TI = Alias->getTypeSourceInfo();
+      if (!TI)
+        TI = C.getTrivialTypeSourceInfo(Alias->getUnderlyingType(), Loc);
+      auto *Copy = TypeAliasDecl::Create(
+          C, Specialization, Alias->getBeginLoc(), Alias->getLocation(),
+          Alias->getIdentifier(), TI);
+      Copy->setImplicit(true);
+      Copy->setAccess(AS_public);
+      Specialization->addDecl(Copy);
+    }
+    Specialization->completeDefinition();
+  }
+  return false;
+}
