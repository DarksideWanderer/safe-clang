+  // that variable. Keep the synthetic condition a constant expression so
+  // the unsafe body remains unconditional in CFG and CodeGen.
+  QualType MarkerType = C.getConstType(C.BoolTy);
+  auto *Marker = VarDecl::Create(C, Actions.CurContext, Loc, Loc,
+                                &C.Idents.get("__safecpp_unsafe_scope"), MarkerType,
+                                C.getTrivialTypeSourceInfo(MarkerType, Loc), SC_None);
+  Marker->setImplicit();
+  Marker->setInit(Value);
+  Marker->addAttr(AnnotateAttr::CreateImplicit(C, "safecpp.unsafe.scope", nullptr, 0));
+  return IfStmt::Create(C, Loc, IfStatementKind::Ordinary, nullptr, Marker,
+                        Value, Loc, Loc, Body.get());
