+ExprResult Sema::ActOnCircleChoiceConstruct(Scope *S, SourceLocation OpLoc,
+                                            IdentifierInfo *Name,
+                                            ArrayRef<Expr *> Args,
+                                            ParsedType Expected) {
+  CircleChoice Choice;
+  QualType ExpectedChoiceType;
+  // The expected type names the choice when the caller wrote one, as in an
+  // initializer; otherwise the alternative is looked up by name.
+  if (QualType ExpectedType = GetTypeFromParser(Expected); !ExpectedType.isNull()) {
+    QualType Expected =
+        ExpectedType.getNonReferenceType().getUnqualifiedType();
+    // A choice template's generated alternatives and storage only exist once
+    // the specialization is instantiated, so name the type before describing
+    // it. A dependent expected type names the pattern, which is described as
+    // it stands.
+    if (!Expected->isDependentType() &&
+        isa_and_nonnull<ClassTemplateSpecializationDecl>(
+            Expected->getAsCXXRecordDecl()) &&
+        RequireCompleteType(OpLoc, Expected, diag::err_incomplete_type))
+      return ExprError();
+    CXXRecordDecl *Record = Expected->getAsCXXRecordDecl();
+    if (!Record) {
+      QualType Canonical = Expected.getCanonicalType();
+      Record = Canonical->getAsCXXRecordDecl();
+    }
+    if (!Record)
+      if (auto *TST = Expected->getAs<TemplateSpecializationType>())
+        if (auto *CTD = dyn_cast_or_null<ClassTemplateDecl>(
+                TST->getTemplateName().getAsTemplateDecl()))
+          Record = CTD->getTemplatedDecl();
+    if (Record) {
+      CircleChoice Candidate;
+      bool Described = describeChoice(Record, Candidate);
+      unsigned Alternative =
+          Described ? circleAlternativeIndex(Candidate, Name) : ~0u;
+      if (Alternative != ~0u) {
+        Choice = Candidate;
+        // Keep the expected type's template arguments so a dependent choice
+        // value can be substituted when its template is instantiated. The
+        // record's canonical tag type drops those arguments.
+        ExpectedChoiceType = Expected;
+      }
+    }
+  }
+  if (!Choice.valid() && !circleChoiceForAlternative(*this, Name, Choice))
+    return ExprError(Diag(OpLoc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "no choice alternative '%0' is in scope"))
+                     << Name);
+  unsigned Index = circleAlternativeIndex(Choice, Name);
+  FieldDecl *Field = Choice.payloadField(Index);
+  QualType PayloadType = Field ? Field->getType() : QualType();
+  if (!Field)
+    PayloadType = Choice.Alternatives[Index]->getUnderlyingType();
+  // A dependent choice's generated payload field names the choice's own
+  // template parameter, not the argument the expected specialization supplies.
+  // For a direct parameter alternative, take the corresponding argument so the
+  // payload and its union member agree once the template is instantiated.
+  if (!ExpectedChoiceType.isNull())
+    if (auto *TST = ExpectedChoiceType->getAs<TemplateSpecializationType>()) {
+      auto Alternative = Choice.Alternatives[Index]->getUnderlyingType();
+      if (auto *Parameter = Alternative->getAs<TemplateTypeParmType>()) {
+        unsigned Argument = Parameter->getIndex();
+        auto Arguments = TST->template_arguments();
+        if (Argument < Arguments.size() &&
+            Arguments[Argument].getKind() == TemplateArgument::Type)
+          PayloadType = Arguments[Argument].getAsType();
+      }
+    }
+
+  SmallVector<Expr *, 2> Init;
+  auto &C = Context;
+  auto *TagValue = IntegerLiteral::Create(
+      C, llvm::APInt(C.getIntWidth(C.UnsignedIntTy), Index), C.UnsignedIntTy,
+      OpLoc);
+  Init.push_back(TagValue);
+
+  if (!PayloadType->isVoidType()) {
+    if (Args.size() != 1)
+      return ExprError(Diag(OpLoc, getDiagnostics().getCustomDiagID(
+                                    DiagnosticsEngine::Error,
+                                    "choice alternative '%0' takes one payload"))
+                       << Name);
+    ExprResult Payload = PerformCopyInitialization(
+        InitializedEntity::InitializeTemporary(PayloadType), OpLoc, Args[0]);
+    if (Payload.isInvalid())
+      return ExprError();
+    // Initializing one member of the generated storage union is a union
+    // initializer: the list has the union's type and names the member it
+    // initializes, exactly as a designated union initializer would. The
+    // payload type would make the list a second, spurious aggregate
+    // initialization of the member's own value.
+    auto *Inner = new (C) InitListExpr(C, OpLoc, {Payload.get()}, OpLoc);
+    // A dependent choice value cannot name its generated storage record yet.
+    // Leave the list void; CodeGen uses the instantiated union destination
+    // and selects the member by the payload's type.
+    if (ExpectedChoiceType.isNull() ||
+        !ExpectedChoiceType->isDependentType()) {
+      Inner->setType(Choice.Payload->getType());
+      Inner->setInitializedFieldInUnion(Field);
+    }
+    Inner->setValueKind(VK_PRValue);
+    Init.push_back(Inner);
+  } else if (!Args.empty()) {
+    return ExprError(Diag(OpLoc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "choice alternative '%0' takes no payload"))
+                     << Name);
+  }
+
+  QualType ChoiceType = ExpectedChoiceType.isNull()
+      ? C.getCanonicalTagType(Choice.Record)
+      : ExpectedChoiceType;
+  // A choice template's alternatives are dependent, so the value's type is
+  // only known once the caller names the specialization. Nothing does outside
+  // a dependent context, and the template's own type is not a type an object
+  // can hold: report it rather than build a value that is sized later.
+  if (ChoiceType->isDependentType() && !CurContext->isDependentContext())
+    return ExprError(Diag(OpLoc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "the choice type of alternative '%0' is not "
+                                  "known here; name it through an initializer, "
+                                  "a direct initialization or a return"))
+                     << Name);
+  auto *Result = new (C) InitListExpr(C, OpLoc, Init, OpLoc);
+  Result->setType(ChoiceType);
+  Result->setValueKind(VK_PRValue);
+  // The construction is a value, not a braced initializer written by the
+  // caller, so it is not re-checked as list-initialization of the choice.
+  return ImplicitCastExpr::Create(C, ChoiceType, CK_NoOp, Result, nullptr,
+                                  VK_PRValue, FPOptionsOverride());
+}
