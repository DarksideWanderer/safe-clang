+/// Whether a record's destructor is the one the checked object model generates
+/// for a `choice`. It destroys the active alternative, so the class's members
+/// are never destroyed one by one the way an ordinary class's are: the
+/// generated storage union has no destructor to run at all.
+static bool circleGeneratedDestructor(const CXXRecordDecl *Record) {
+  auto *Dtor = Record->getDestructor();
+  if (!Dtor)
+    return false;
+  for (const auto *A : Dtor->specific_attrs<AnnotateAttr>())
+    if (A->isImplicit() &&
+        A->getAnnotation() == "safecpp.native.choice.destructor")
+      return true;
+  return false;
