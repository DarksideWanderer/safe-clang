+  Value *Result = Builder.CreateExtractValue(Pair, 0);
+  Value *Overflow = Builder.CreateExtractValue(Pair, 1);
+  CGF.EmitCircleSafetyCheck(Builder.CreateNot(Overflow));
+  return Result;
