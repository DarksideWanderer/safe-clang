+static bool stmtExprCannotReturn(const Expr *E) {
+  if (!E) return false;
+  E = E->IgnoreParenImpCasts();
+  if (auto *Statement = dyn_cast<StmtExpr>(E))
+    if (auto *Body = Statement->getSubStmt())
+      return stmtExprCannotReturn(
