+  // A borrow of a concrete slice names the generated record, exactly as the
+  // declarator path builds it: the pattern's borrow was of the unsized native
+  // slice while its element was dependent, and the substitution is where the
+  // element becomes known.
+  if (const auto *Slice = Pointee->getAs<NativeSliceType>()) {
+    QualType Element = Slice->getElementType();
+    if (Pointee.isConstQualified())
+      Element = SemaRef.Context.getConstType(Element);
+    if (!Element->isInstantiationDependentType()) {
+      // The qualifiers written on the borrow belong to the referent, exactly
+      // as the declarator path builds them: the handle itself carries none, so
+      // a borrow, a borrow of a const slice and a borrow that came out of a
+      // pattern are all the same type.
+      if (Pointee.isConstQualified())
+        Element = SemaRef.Context.getConstType(Element);
+      return SemaRef.Context.getBorrowValueType(
+          SemaRef.Context.getCircleSliceType(Element));
