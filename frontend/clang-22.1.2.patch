+  auto *Adjusted = S.Context.CreateTypeSourceInfo(T);
+  // The rebuilt type usually has the same type-location layout as the parsed
+  // one, but a native borrow whose referent was rewritten (a slice borrow is
+  // the generated record) may not: copying through a larger source would write
+  // past the destination, so the source locations are copied only when the two
+  // layouts agree.
+  if (Adjusted->getTypeLoc().getFullDataSize() ==
+      Info->getTypeLoc().getFullDataSize())
+    memcpy(Adjusted->getTypeLoc().getOpaqueData(),
+           Info->getTypeLoc().getOpaqueData(),
+           Info->getTypeLoc().getFullDataSize());
+  return Adjusted;
+}
