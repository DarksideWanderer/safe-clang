+/// Declares the names a pattern binds, and checks the pattern against the type
+/// it matches. The binding takes the payload's type, and the names are visible
+/// to the arm's own body.
+bool BuildCirclePatternBindings(Sema &S, QualType Subject,
+                                Sema::CirclePattern &Pattern, bool Borrow,
+                                bool IntroduceBindings) {
+  // `^name` borrows the alternative's payload. Preserve that choice both in
+  // the binding's native type and in lowering; treating it as an owned value
+  // would make the pattern body ill-typed and give it the wrong drop duty.
+  Borrow |= Pattern.Borrow;
+  Pattern.Borrow = Borrow;
+  auto DiagAt = [&]<unsigned N>(SourceLocation Loc, const char (&Message)[N]) {
+    S.Diag(Loc, S.getDiagnostics().getCustomDiagID(
+                    DiagnosticsEngine::Error, Message));
+    return true;
+  };
+  if (Subject.isNull())
+    return false;
+  QualType SubjectTy = Subject.getNonReferenceType().getUnqualifiedType();
+  // A subject whose type is not known yet — `match(p(x))` inside the template
+  // that declares `p` — is what the tests are built against once it is, so the
+  // tests a pattern makes are not judged here. The names it binds are still
+  // declared: the arm's body names them, and what they name is the payload of
+  // an alternative the pattern itself named.
+  bool Known = !SubjectTy->isDependentType() &&
+               !SubjectTy->isInstantiationDependentType();
+  switch (Pattern.K) {
+  case Sema::CirclePattern::CatchAll:
+    return false;
+  case Sema::CirclePattern::Bind: {
+    if (!Pattern.Binding && Pattern.BindingName) {
+      QualType BindingType =
+          Known ? S.Context.getLValueReferenceType(SubjectTy)
+                : (Borrow ? S.Context.getBorrowValueType(S.Context.DependentTy)
+                          : S.Context.DependentTy);
+      auto *VD = VarDecl::Create(
+          S.Context, S.CurContext, Pattern.Loc, Pattern.Loc, Pattern.BindingName,
+          BindingType,
+          S.Context.getTrivialTypeSourceInfo(BindingType, Pattern.Loc), SC_None);
+      VD->setImplicit();
+      VD->addAttr(AnnotateAttr::CreateImplicit(
+          S.Context, "safecpp.native.match.binding", nullptr, 0));
+      Pattern.Binding = VD;
+      if (IntroduceBindings)
+        S.PushOnScopeChains(VD, S.getCurScope(), /*AddToContext=*/false);
+    }
+    if (Pattern.Payload)
+      return BuildCirclePatternBindings(S, Subject, *Pattern.Payload, Borrow,
+                                        IntroduceBindings);
+    return false;
+  }
+  case Sema::CirclePattern::Tuple: {
+    CXXRecordDecl *Record =
+        Known && S.IsCircleTupleType(SubjectTy)
+            ? SubjectTy->getAsCXXRecordDecl()
+            : nullptr;
+    if (Known && !Record)
+      return DiagAt(Pattern.Loc, "a tuple pattern needs a tuple operand");
+    if (Record && Pattern.Elements.size() != Record->getNumFields())
+      return DiagAt(Pattern.Loc,
+                    "a tuple pattern must name every element of its operand");
+    for (unsigned I = 0; I != Pattern.Elements.size(); ++I) {
+      QualType ElementType = S.Context.DependentTy;
+      if (Record)
+        ElementType = std::next(Record->field_begin(), I)->getType();
+      if (BuildCirclePatternBindings(S, ElementType, *Pattern.Elements[I],
+                                     Borrow, IntroduceBindings))
+        return true;
+    }
+    return false;
+  }
+  case Sema::CirclePattern::Or: {
+    using Bindings = std::map<IdentifierInfo *, VarDecl *>;
+    auto Collect = [&](auto &&Self, Sema::CirclePattern &P, Bindings &Out) -> bool {
+      if (P.BindingName && P.Binding && P.K != Sema::CirclePattern::Or) {
+        if (!Out.emplace(P.BindingName, P.Binding).second)
+          return DiagAt(P.Loc, "a pattern binds the same name more than once");
+      }
+      if (P.Payload && Self(Self, *P.Payload, Out)) return true;
+      // Nested OR branches share their declarations; collect only one branch.
+      if (P.K == Sema::CirclePattern::Or) {
+        if (!P.Alternatives.empty()) return Self(Self, *P.Alternatives.front(), Out);
+      } else for (auto &E : P.Elements) if (Self(Self, *E, Out)) return true;
+      return false;
+    };
+    Bindings First;
+    for (unsigned I = 0; I < Pattern.Alternatives.size(); ++I) {
+      auto &Alternative = *Pattern.Alternatives[I];
+      if (BuildCirclePatternBindings(S, Subject, Alternative, Borrow,
+                                     I == 0 && IntroduceBindings)) return true;
+      Bindings Current;
+      if (Collect(Collect, Alternative, Current)) return true;
+      if (!I) { First = std::move(Current); continue; }
+      if (Current.size() != First.size())
+        return DiagAt(Alternative.Loc, "every alternative of an '|' pattern must bind the same names");
+      for (auto [Name, VD] : Current) {
+        auto It = First.find(Name);
+        if (It == First.end())
+          return DiagAt(Alternative.Loc, "every alternative of an '|' pattern must bind the same names");
+        if (Known && !S.Context.hasSameType(VD->getType(), It->second->getType()))
+          return DiagAt(Alternative.Loc, "every alternative of an '|' pattern must bind the same types");
+      }
+      auto Rebind = [&](auto &&Self, Sema::CirclePattern &P) -> void {
+        if (P.BindingName && P.Binding) P.Binding = First.at(P.BindingName);
+        if (P.Payload) Self(Self, *P.Payload);
+        for (auto &A : P.Alternatives) Self(Self, *A);
+        for (auto &E : P.Elements) Self(Self, *E);
+      };
+      Rebind(Rebind, Alternative);
+    }
+    return false;
+  }
+  case Sema::CirclePattern::Bool:
+    if (Known && !SubjectTy->isBooleanType())
+      return DiagAt(Pattern.Loc,
+                    "a true/false pattern needs a bool operand");
+    return false;
+  case Sema::CirclePattern::Value:
+  case Sema::CirclePattern::Range:
+    if (Known && !SubjectTy->isIntegralType(S.Context))
+      return DiagAt(Pattern.Loc,
+                    "a value or range pattern needs an integer operand");
+    return false;
+
+  case Sema::CirclePattern::Alternative:
+    break;
+  }
+
+  CircleChoice Choice;
+  auto *Record = SubjectTy->getAsCXXRecordDecl();
+  bool KnownSubject = Record && !SubjectTy->isPlaceholderType() &&
+                      describeChoice(Record, Choice);
+  if (!KnownSubject && !Known) {
+    // The subject is the current instantiation's own type, or one whose
+    // definition is not instantiated yet: the names the pattern binds are
+    // declared with the type the instantiation supplies, and the payload each
+    // one names is found again when the alternatives are known.
+    if (Pattern.BindingName && !Pattern.Binding) {
+      QualType Deferred = S.Context.DependentTy;
+      if (Borrow)
+        Deferred = S.Context.getBorrowValueType(Deferred);
+      auto *VD = VarDecl::Create(
+          S.Context, S.CurContext, Pattern.Loc, Pattern.Loc,
+          Pattern.BindingName, Deferred,
+          S.Context.getTrivialTypeSourceInfo(Deferred, Pattern.Loc), SC_None);
+      VD->setImplicit();
+      VD->addAttr(AnnotateAttr::CreateImplicit(
+          S.Context, "safecpp.native.match.binding", nullptr, 0));
+      Pattern.Binding = VD;
+      if (IntroduceBindings)
+        S.PushOnScopeChains(VD, S.getCurScope(), /*AddToContext=*/false);
+    }
+    if (Pattern.Payload)
+      return BuildCirclePatternBindings(S, S.Context.DependentTy,
+                                        *Pattern.Payload, Borrow,
+                                        IntroduceBindings);
+    return false;
+  }
+  if (!KnownSubject)
+    return DiagAt(Pattern.Loc,
+                  "a choice alternative pattern needs a choice operand");
+  unsigned Index = circleAlternativeIndex(Choice, Pattern.Name);
+  if (Index == ~0u) {
+    S.Diag(Pattern.Loc, S.getDiagnostics().getCustomDiagID(
+                            DiagnosticsEngine::Error,
+                            "no choice alternative '%0' is in scope"))
+        << Pattern.Name;
+    return true;
+  }
+  FieldDecl *Field = Choice.payloadField(Index);
+  QualType PayloadType =
+      Field ? Field->getType()
+            : Choice.Alternatives[Index]->getUnderlyingType();
+  if (Pattern.BindingName || Pattern.Binding) {
+    if (PayloadType->isVoidType())
+      return DiagAt(Pattern.Loc,
+                    "match binding requires an alternative with a payload");
+    QualType BindingType = PayloadType;
+    if (Borrow) {
+      // A `^` pattern binds a borrow of the payload, which is shared when the
+      // operand the arm matches is const.
+      bool Shared = false;
+      if (!S.CircleMatches.empty() && S.CircleMatches.back().Operand)
+        Shared = S.CircleMatches.back().Operand->getType().isConstQualified();
+      if (Shared)
+        BindingType = S.Context.getConstType(BindingType);
+      BindingType = S.Context.getBorrowValueType(BindingType);
+    }
+    auto *VD = VarDecl::Create(
+        S.Context, S.CurContext, Pattern.Loc, Pattern.Loc, Pattern.BindingName,
+        BindingType, S.Context.getTrivialTypeSourceInfo(BindingType, Pattern.Loc),
+        SC_None);
+    VD->setImplicit();
+    VD->addAttr(AnnotateAttr::CreateImplicit(
+        S.Context, "safecpp.native.match.binding", nullptr, 0));
+    Pattern.Binding = VD;
+    if (IntroduceBindings)
+      S.PushOnScopeChains(VD, S.getCurScope(), /*AddToContext=*/false);
+  }
+  if (Pattern.Payload)
+    return BuildCirclePatternBindings(S, PayloadType, *Pattern.Payload, Borrow,
+                                      IntroduceBindings);
+  return false;
+}
