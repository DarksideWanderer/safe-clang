+namespace clang {
+// Capture identities are de Bruijn scope distances and one-based binder
+// slots. Local binder IDs occupy the low range; static and elided durations
+// retain their existing disjoint tags. Spelling is never a type identity.
+inline bool circleRegionIsCapture(unsigned ID) { return (ID & 0xe0000000u) == 0x20000000u; }
+inline unsigned circleCaptureDepth(unsigned ID) { return (ID >> 16) & 0x1fffu; }
+inline unsigned circleCaptureSlot(unsigned ID) { return ID & 0xffffu; }
+inline unsigned circleCapturedRegion(unsigned Depth, unsigned Slot) {
+  assert(Depth && Depth < 8192 && Slot && Slot < 65536);
+  return 0x20000000u | (Depth << 16) | Slot;
+}
+
+// The free regions of a callable value, including captures used by callbacks
+// nested in its parameters/results. A nested binder discharges only its own
+// scope. The sorted identities form a stable carried-region layout.
+inline SmallVector<unsigned, 4> circleCallableCaptures(QualType Root) {
+  std::set<unsigned> Result;
+  std::set<std::pair<const Type *, unsigned>> Seen;
+  SmallVector<std::pair<QualType, unsigned>, 8> Work{{Root, 0}};
+  while (!Work.empty()) {
+    auto Item = Work.pop_back_val();
+    QualType T = Item.first;
+    unsigned Nested = Item.second;
+    if (T.isNull() || !Seen.emplace(T.getTypePtr(), Nested).second) continue;
+    if (const auto *F = T->getAs<FunctionProtoType>()) {
+      auto Add = [&](unsigned ID) {
+        if (circleRegionIsCapture(ID) && circleCaptureDepth(ID) > Nested)
+          Result.insert(circleCapturedRegion(circleCaptureDepth(ID) - Nested,
+                                             circleCaptureSlot(ID)));
+      };
+      for (unsigned ID : F->getLifetimeBindings()) Add(ID);
+      for (unsigned ID : F->getLifetimeOutlives()) Add(ID);
+      auto P = F->getClassLifetimeBindings();
+      for (unsigned I = 2; I < P.size(); I += 3) Add(P[I]);
+      Work.emplace_back(F->getReturnType(), Nested + 1);
+      for (auto P : F->getParamTypes()) Work.emplace_back(P, Nested + 1);
+    } else if (T->getAs<BorrowValueType>() || T->isPointerType() || T->isReferenceType())
+      Work.emplace_back(T->getPointeeType(), Nested);
+    else if (const auto *M = T->getAs<MemberPointerType>())
+      Work.emplace_back(M->getPointeeType(), Nested);
+    else if (const auto *A = T->getAsArrayTypeUnsafe())
+      Work.emplace_back(A->getElementType(), Nested);
+  }
+  return SmallVector<unsigned, 4>(Result.begin(), Result.end());
+}
+inline bool circleIsCallableValue(QualType T) {
+  T = T.getNonReferenceType();
+  if (T->isPointerType() || T->getAs<BorrowValueType>() || T->isMemberPointerType())
+    T = T->getPointeeType();
+  return T->isFunctionType();
+}
+
+// Rebind references to exactly one surrounding scope. Nested prototypes
+// retain their own binders and references to every other surrounding scope.
+// Memoization includes the scope depth: the same type DAG may occur at
+// several lexical levels.
+template<class Mapping>
+inline QualType circleRebindCaptures(ASTContext &C, QualType Root, Mapping Map,
+                                    unsigned InitialDepth = 0,
+                                    unsigned RebasedInitialDepth = 0) {
+  std::map<std::pair<QualType, unsigned>, QualType> Cache;
+  auto Rewrite = [&](auto &&Self, QualType T, unsigned Depth) -> QualType {
+    auto Key = std::make_pair(T, Depth);
+    if (auto I = Cache.find(Key); I != Cache.end()) return I->second;
+    auto Original = T;
+    if (const auto *F = T->getAs<FunctionProtoType>()) {
+      auto EPI = F->getExtProtoInfo();
+      SmallVector<unsigned, 8> Bindings(EPI.LifetimeBindings);
+      SmallVector<unsigned, 12> Projections(EPI.ClassLifetimeBindings);
+      SmallVector<unsigned, 8> Outlives(EPI.LifetimeOutlives);
+      auto Rebind = [&](unsigned ID) {
+        if (circleRegionIsCapture(ID) && circleCaptureDepth(ID) == Depth) {
+          unsigned Slot = Map(circleCaptureSlot(ID));
+          return Slot == 0x40000000u ? Slot : circleCapturedRegion(
+              RebasedInitialDepth ? Depth - InitialDepth + RebasedInitialDepth : Depth, Slot);
+        }
+        return ID;
+      };
+      for (auto &ID : Bindings) ID = Rebind(ID);
+      for (unsigned I = 2; I < Projections.size(); I += 3) Projections[I] = Rebind(Projections[I]);
+      for (auto &ID : Outlives) ID = Rebind(ID);
+      EPI.LifetimeBindings = Bindings;
+      EPI.ClassLifetimeBindings = Projections;
+      EPI.LifetimeOutlives = Outlives;
+      SmallVector<QualType, 8> Params;
+      for (auto P : F->getParamTypes()) Params.push_back(Self(Self, P, Depth + 1));
+      T = C.getFunctionType(Self(Self, F->getReturnType(), Depth + 1), Params, EPI);
+    } else if (const auto *B = T->getAs<BorrowValueType>())
+      T = C.getBorrowValueType(Self(Self, B->getPointeeType(), Depth));
+    else if (T->isPointerType()) T = C.getPointerType(Self(Self, T->getPointeeType(), Depth));
+    else if (const auto *R = T->getAs<LValueReferenceType>())
+      T = C.getLValueReferenceType(Self(Self, R->getPointeeType(), Depth),
+                                  R->isSpelledAsLValue(), R->isSafetyBorrow());
+    else if (T->isRValueReferenceType()) T = C.getRValueReferenceType(Self(Self, T->getPointeeType(), Depth));
+    else if (const auto *A = C.getAsConstantArrayType(T))
+      T = C.getConstantArrayType(Self(Self, A->getElementType(), Depth), A->getSize(),
+                                A->getSizeExpr(), A->getSizeModifier(), A->getIndexTypeCVRQualifiers());
+    else if (const auto *A = C.getAsIncompleteArrayType(T))
+      T = C.getIncompleteArrayType(Self(Self, A->getElementType(), Depth), A->getSizeModifier(), A->getIndexTypeCVRQualifiers());
+    else if (const auto *M = T->getAs<MemberPointerType>())
+      T = C.getMemberPointerType(Self(Self, M->getPointeeType(), Depth), M->getQualifier(), M->getMostRecentCXXRecordDecl());
+    T = C.getQualifiedType(T, Original.getLocalQualifiers());
+    Cache.emplace(Key, T);
+    return T;
+  };
+  return Rewrite(Rewrite, Root, InitialDepth);
+}
+
+// A callable's carried-region layout is sorted by its rebound identities.
+// Declaration normalization and template substitution must derive the same
+// position map after binder removal, merging or renumbering.
+inline QualType circleRefreshCallableProjections(ASTContext &C, QualType T) {
+  const auto *F = T->castAs<FunctionProtoType>();
+  auto EPI = F->getExtProtoInfo();
+  SmallVector<unsigned, 12> Projections;
+  for (unsigned Position = 0; Position <= F->getNumParams(); ++Position) {
+    QualType Value = Position ? F->getParamType(Position - 1) : F->getReturnType();
+    if (circleIsCallableValue(Value)) {
+      unsigned Region = 0;
+      for (unsigned Capture : circleCallableCaptures(Value)) {
+        unsigned Binding = circleCaptureDepth(Capture) == 1 ? circleCaptureSlot(Capture)
+            : circleCapturedRegion(circleCaptureDepth(Capture) - 1, circleCaptureSlot(Capture));
+        Projections.append({Position, ++Region, Binding});
+      }
+    } else for (unsigned I = 0; I + 2 < EPI.ClassLifetimeBindings.size(); I += 3)
+      if (EPI.ClassLifetimeBindings[I] == Position)
+        Projections.append(EPI.ClassLifetimeBindings.begin() + I,
+                           EPI.ClassLifetimeBindings.begin() + I + 3);
+  }
+  EPI.ClassLifetimeBindings = Projections;
+  return C.getFunctionType(F->getReturnType(), F->getParamTypes(), EPI);
+}
+
+// T+ hoists the free regions of a callable argument into the class's region
+// parameter list. The nominal specialization uses formal slots, so choosing
+// /a rather than /b does not manufacture a different C++ class specialization.
+// Local higher-ranked binders remain part of the argument's exact type.
+inline QualType circleHoistCallableType(ASTContext &C, QualType T) {
+  auto Captures = circleCallableCaptures(T);
+  std::set<unsigned> Depths;
+  for (unsigned ID : Captures) Depths.insert(circleCaptureDepth(ID));
+  for (unsigned Depth : Depths)
+    T = circleRebindCaptures(C, T, [&](unsigned Slot) {
+      unsigned ID = circleCapturedRegion(Depth, Slot);
+      auto I = llvm::find(Captures, ID);
+      return I == Captures.end() ? Slot : unsigned(I - Captures.begin()) + 1;
+    }, Depth, 1);
+  return T;
+}
+
+// These predicates compare contracts belonging to separate binder scopes.
+// Sema has already alpha-normalized the IDs and closed the outlives graph.
+// They deliberately do not implement higher-ranked subtyping.
+inline bool circleSameLifetimeBindings(const FunctionProtoType *A,
+                                       const FunctionProtoType *B) {
+  return A && B && A->getLifetimeBindings() == B->getLifetimeBindings() &&
+         A->getClassLifetimeBindings() == B->getClassLifetimeBindings() &&
+         A->getLifetimeOutlives() == B->getLifetimeOutlives();
+}
+inline bool circleSameReturnBorrowContract(const FunctionProtoType *A,
+                                           const FunctionProtoType *B) {
+  return A && B && A->getReturnBorrow() == B->getReturnBorrow() &&
+         A->getReturnBorrowClassRegion() == B->getReturnBorrowClassRegion() &&
+         A->getReturnBorrowSources() == B->getReturnBorrowSources();
+}
+inline bool circleSameStaticParameterContracts(const FunctionProtoType *A,
+                                               const FunctionProtoType *B) {
+  if (!A || !B || A->getNumParams() != B->getNumParams()) return false;
+  for (unsigned I = 0; I < A->getNumParams(); ++I) {
+    auto X = A->getExtParameterInfo(I), Y = B->getExtParameterInfo(I);
+    if (X.hasStaticLifetime() != Y.hasStaticLifetime() ||
+        X.hasStaticTypeLifetimes() != Y.hasStaticTypeLifetimes()) return false;
+  }
+  return true;
+}
+inline bool circleSameFunctionLifetimeContract(const FunctionProtoType *A,
+                                                const FunctionProtoType *B) {
+  return circleSameLifetimeBindings(A, B) &&
+         circleSameReturnBorrowContract(A, B) &&
+         circleSameStaticParameterContracts(A, B);
+}
+inline bool circleSameFunctionValueTypes(ASTContext &C,
+                                         const FunctionProtoType *A,
+                                         const FunctionProtoType *B) {
+  if (!A || !B || A->getNumParams() != B->getNumParams() ||
+      A->isVariadic() != B->isVariadic() ||
+      A->getMethodQuals() != B->getMethodQuals() ||
+      A->getRefQualifier() != B->getRefQualifier() ||
+      !C.hasSameType(A->getReturnType(), B->getReturnType())) return false;
+  for (unsigned I = 0; I < A->getNumParams(); ++I)
+    if (!C.hasSameType(A->getParamType(I), B->getParamType(I))) return false;
+  return true;
+}
+inline bool circleFunctionHasStaticContract(const FunctionProtoType *T) {
+  if (!T) return false;
+  if (T->getReturnBorrow() == 0x40000000u) return true;
+  for (unsigned I = 0; I < T->getNumParams(); ++I) {
+    auto P = T->getExtParameterInfo(I);
+    if (P.hasStaticLifetime() || P.hasStaticTypeLifetimes()) return true;
+  }
+  return false;
+}
+inline bool circleFunctionHasLifetimeContract(const FunctionProtoType *T) {
+  return T && (!T->getLifetimeBindings().empty() ||
+               !T->getClassLifetimeBindings().empty() ||
+               !T->getLifetimeOutlives().empty() || T->getReturnBorrow() ||
+               T->getReturnBorrowClassRegion() || circleFunctionHasStaticContract(T));
+}
+// Buffers outlive rebuilding the function type; ASTContext copies their data.
+struct CircleFunctionContractStorage {
+  llvm::SmallVector<unsigned, 8> Bindings, Projections, Outlives, Sources;
+  std::map<unsigned, unsigned> RegionIDs;
+};
+
+// Substitution can replace one parameter pack with zero or many parameters.
+// Rewrite positions using the expansion's actual origin map, rather than
+// guessing offsets from parameter names or retaining the pattern's indices.
+inline void circleRemapFunctionParameterContracts(
+    const FunctionProtoType *F, ArrayRef<unsigned> Origins,
+    FunctionProtoType::ExtProtoInfo &EPI, CircleFunctionContractStorage &Storage) {
+  if (!circleFunctionHasLifetimeContract(F)) return;
+  bool Identity = Origins.size() == F->getNumParams();
+  for (unsigned I = 0; I < Origins.size(); ++I) Identity &= Origins[I] == I;
+  if (Identity) return;
+
+  auto OldBindings = F->getLifetimeBindings();
+  if (!OldBindings.empty()) {
+    Storage.Bindings.push_back(OldBindings.front());
+    for (unsigned Origin : Origins)
+      Storage.Bindings.push_back(Origin + 1 < OldBindings.size()
+                                     ? OldBindings[Origin + 1] : 0);
+  }
+  auto OldProjections = F->getClassLifetimeBindings();
+  llvm::SmallVector<std::tuple<unsigned, unsigned, unsigned>, 8> Projections;
+  for (unsigned I = 0; I + 2 < OldProjections.size(); I += 3) {
+    unsigned Position = OldProjections[I];
+    if (!Position) Projections.emplace_back(0, OldProjections[I + 1], OldProjections[I + 2]);
+    else for (unsigned J = 0; J < Origins.size(); ++J)
+      if (Origins[J] + 1 == Position)
+        Projections.emplace_back(J + 1, OldProjections[I + 1], OldProjections[I + 2]);
+  }
+  llvm::sort(Projections);
+  auto &IDs = Storage.RegionIDs;
+  auto Canonical = [&](unsigned ID) {
+    if (!ID || ID == 0x40000000u || circleRegionIsCapture(ID)) return ID;
+    return IDs.emplace(ID, IDs.size() + 1).first->second;
+  };
+  // Match declaration normalization: inputs, result, then class projections.
+  for (unsigned I = 1; I < Storage.Bindings.size(); ++I)
+    Storage.Bindings[I] = Canonical(Storage.Bindings[I]);
+  if (!Storage.Bindings.empty()) Storage.Bindings[0] = Canonical(Storage.Bindings[0]);
+  for (auto [Position, Region, ID] : Projections)
+    Storage.Projections.append({Position, Region, Canonical(ID)});
+
+  std::set<unsigned> Static;
+  for (unsigned I = 0; I < F->getNumParams(); ++I)
+    if (F->getExtParameterInfo(I).hasStaticLifetime() && I + 1 < OldBindings.size())
+      Static.insert(OldBindings[I + 1]);
+  auto Retained = [&](unsigned ID) {
+    if (ID == 0x40000000u || circleRegionIsCapture(ID)) return ID;
+    if (auto I = IDs.find(ID); I != IDs.end()) return I->second;
+    return Static.count(ID) ? 0x40000000u : 0u;
+  };
+  std::set<std::pair<unsigned, unsigned>> Relations;
+  auto OldEdges = F->getLifetimeOutlives();
+  for (unsigned I = 0; I + 1 < OldEdges.size(); I += 2) {
+    unsigned Long = Retained(OldEdges[I]), Short = Retained(OldEdges[I + 1]);
+    if (Long && Short && Long != Short) Relations.emplace(Long, Short);
+  }
+  for (auto [Long, Short] : Relations) Storage.Outlives.append({Long, Short});
+
+  auto OldSources = F->getReturnBorrowSources();
+  if (!OldSources.empty()) {
+    for (unsigned I = 0; I < Origins.size(); ++I)
+      if (llvm::is_contained(OldSources, Origins[I])) Storage.Sources.push_back(I);
+    FunctionProtoType::setReturnBorrowSources(EPI, Storage.Sources);
+    // With an empty source pack, a result-only binder stays universally
+    // selected by the caller. It must not become an uncontracted result.
+    if (Storage.Sources.empty() && !Storage.Bindings.empty() && Storage.Bindings[0])
+      EPI.ReturnBorrow = 0x10000000u;
+  }
+  if (llvm::all_of(Storage.Bindings, [](unsigned ID) { return !ID; }))
+    Storage.Bindings.clear();
+  EPI.LifetimeBindings = Storage.Bindings;
+  EPI.ClassLifetimeBindings = Storage.Projections;
+  EPI.LifetimeOutlives = Storage.Outlives;
+}
+// Inspect type structure, including callbacks nested in other callbacks,
+// arrays, pointer storage and template arguments. Record object layouts remain
+// the responsibility of the checked storage model, not function subtyping.
+inline bool circleContainsFunctionLifetimeContract(QualType Type,
+                                                   bool QuantifiedOnly = false) {
+  llvm::SmallVector<QualType, 8> Work{Type};
+  llvm::SmallPtrSet<const clang::Type *, 16> Seen;
+  while (!Work.empty()) {
+    QualType T = Work.pop_back_val();
+    if (T.isNull() || !Seen.insert(T.getTypePtr()).second) continue;
+    if (const auto *F = T->getAs<FunctionProtoType>()) {
+      if (QuantifiedOnly ? (!F->getLifetimeBindings().empty() ||
+                            !F->getClassLifetimeBindings().empty() ||
+                            !F->getLifetimeOutlives().empty())
+                         : circleFunctionHasLifetimeContract(F)) return true;
+      Work.push_back(F->getReturnType());
+      llvm::append_range(Work, F->getParamTypes());
+    } else if (T->getAs<BorrowValueType>() || T->isPointerType() ||
+               T->isReferenceType() || T->isBlockPointerType()) {
+      Work.push_back(T->getPointeeType());
+    } else if (const auto *M = T->getAs<MemberPointerType>()) {
+      Work.push_back(M->getPointeeType());
+    } else if (const auto *A = dyn_cast<ArrayType>(T.getCanonicalType().getTypePtr())) {
+      Work.push_back(A->getElementType());
+    } else {
+      auto AddArguments = [&](ArrayRef<TemplateArgument> Args) {
+        llvm::SmallVector<const TemplateArgument *, 8> Pending;
+        for (const auto &A : Args) Pending.push_back(&A);
+        while (!Pending.empty()) {
+          const auto *A = Pending.pop_back_val();
+          if (A->getKind() == TemplateArgument::Type) Work.push_back(A->getAsType());
+          else if (A->getKind() == TemplateArgument::Pack)
+            for (const auto &E : A->pack_elements()) Pending.push_back(&E);
+        }
+      };
+      if (const auto *S = T->getAs<TemplateSpecializationType>())
+        AddArguments(S->template_arguments());
+      else if (const auto *S = dyn_cast_or_null<ClassTemplateSpecializationDecl>(
+                   T->getAsCXXRecordDecl()))
+        AddArguments(S->getTemplateArgs().asArray());
+    }
+  }
+  return false;
+}
+// Preserve a protected callable's structure. The outermost function decay or
+// function reference does not alter its contract. Additional storage layers
+// cannot be erased, even if the innermost function has an identical signature.
+inline bool circleSameFunctionContractTree(ASTContext &C, QualType A, QualType B) {
+  if (A.isNull() || B.isNull()) return false;
+  A = A.getNonReferenceType(); B = B.getNonReferenceType();
+  if (A->isFunctionType() && B->isFunctionPointerType()) B = B->getPointeeType();
+  if (B->isFunctionType() && A->isFunctionPointerType()) A = A->getPointeeType();
+  auto Same = [&](auto &&Self, QualType X, QualType Y) -> bool {
+    if (C.hasSameType(X, Y)) return true;
+    if (!circleContainsFunctionLifetimeContract(X) &&
+        !circleContainsFunctionLifetimeContract(Y)) return true;
+    auto *F = X->getAs<FunctionProtoType>(), *G = Y->getAs<FunctionProtoType>();
+    if (F || G)
+      return circleSameFunctionLifetimeContract(F, G) &&
+             circleSameFunctionValueTypes(C, F, G);
+    if (X->getAs<BorrowValueType>() || Y->getAs<BorrowValueType>())
+      return X->getAs<BorrowValueType>() && Y->getAs<BorrowValueType>() &&
+             Self(Self, X->getPointeeType(), Y->getPointeeType());
+    if ((X->isPointerType() && Y->isPointerType()) ||
+        (X->isReferenceType() && Y->isReferenceType()) ||
+        (X->isBlockPointerType() && Y->isBlockPointerType()))
+      return Self(Self, X->getPointeeType(), Y->getPointeeType());
+    auto *M = X->getAs<MemberPointerType>(), *N = Y->getAs<MemberPointerType>();
+    if (M && N) return Self(Self, M->getPointeeType(), N->getPointeeType());
+    // Arrays and template arguments retain their exact canonical identity.
+    return false;
+  };
+  return Same(Same, A, B);
+}
+inline unsigned circleProjectedFunctionRegion(const FunctionProtoType *T,
+                                               unsigned Position, unsigned Region) {
+  if (!T) return 0;
+  auto Bindings = T->getClassLifetimeBindings();
+  for (unsigned I = 0; I + 2 < Bindings.size(); I += 3)
+    if (Bindings[I] == Position && Bindings[I + 1] == Region)
+      return Bindings[I + 2];
+  return 0;
+}
+inline bool circleFunctionHasClassProjection(const FunctionProtoType *T,
+                                              unsigned Position) {
+  if (!T) return false;
+  auto Bindings = T->getClassLifetimeBindings();
+  for (unsigned I = 0; I + 2 < Bindings.size(); I += 3)
+    if (Bindings[I] == Position) return true;
+  return false;
+}
+inline bool circleRegionOutlives(ArrayRef<unsigned> Edges,
+                                 unsigned Long, unsigned Short) {
+  if (!Long || !Short) return false;
+  if (Long == Short || Long == 0x40000000u) return true;
+  // Sema stores the transitive closure; zero remains an unknown region.
+  for (unsigned I = 0; I + 1 < Edges.size(); I += 2)
+    if (Edges[I] == Long && Edges[I + 1] == Short) return true;
+  return false;
+}
+inline bool circleFunctionRegionOutlives(const FunctionProtoType *T,
+                                         unsigned Long, unsigned Short) {
+  return T && circleRegionOutlives(T->getLifetimeOutlives(), Long, Short);
+}
+inline unsigned circleFunctionRegion(const FunctionProtoType *T, unsigned Position) {
+  if (!T) return 0;
+  auto Bindings = T->getLifetimeBindings();
+  return Position < Bindings.size() ? Bindings[Position] : 0;
+}
+// Static kind constraints are implications of the whole region graph, not
+// just flags on the parameter that spelled `a:static`. Substitution may also
+// remove that parameter and retain an edge to the static sentinel instead.
+inline bool circleFunctionRegionIsStatic(const FunctionProtoType *T,
+                                         unsigned Region) {
+  if (!T || !Region) return false;
+  if (circleFunctionRegionOutlives(T, Region, 0x40000000u)) return true;
+  for (unsigned I = 0; I < T->getNumParams(); ++I)
+    if (T->getExtParameterInfo(I).hasStaticLifetime() &&
+        circleFunctionRegionOutlives(T, Region, circleFunctionRegion(T, I + 1)))
+      return true;
+  return false;
+}
+inline std::optional<unsigned>
+circleUniqueBorrowParameter(const FunctionProtoType *T) {
+  if (!T) return std::nullopt;
+  std::optional<unsigned> Source;
+  for (unsigned I = 0; I < T->getNumParams(); ++I) {
+    auto P = T->getParamType(I);
+    if (!P->isReferenceType() && !P->getAs<BorrowValueType>()) continue;
+    if (Source) return std::nullopt;
+    Source = I;
+  }
+  return Source;
+}
+// Region == 0 denotes a parameter's own borrow; a positive region denotes
+// data carried by that class parameter. All callers use this one enumeration.
+template<class Visit>
+inline void circleForEachFunctionRegionSource(const FunctionProtoType *T,
+                                               unsigned Destination, Visit V) {
+  if (!T || !Destination) return;
+  for (unsigned I = 0; I < T->getNumParams(); ++I)
+    if (circleFunctionRegionOutlives(T, circleFunctionRegion(T, I + 1), Destination))
+      V(I, 0);
+  auto Projections = T->getClassLifetimeBindings();
+  for (unsigned I = 0; I + 2 < Projections.size(); I += 3)
+    if (Projections[I] && Projections[I] <= T->getNumParams() &&
+        circleFunctionRegionOutlives(T, Projections[I + 2], Destination))
+      V(Projections[I] - 1, Projections[I + 1]);
+}
+inline bool circleFunctionParameterSuppliesRegion(const FunctionProtoType *T,
+                                                   unsigned Index,
+                                                   unsigned Destination) {
+  if (!T || Index >= T->getNumParams()) return false;
+  bool Found = false;
+  circleForEachFunctionRegionSource(T, Destination,
+      [&](unsigned Parameter, unsigned) { Found |= Parameter == Index; });
+  return Found;
+}
+inline const ClassLifetimeType *circleClassLifetimeBinding(QualType T) {
+  const ClassLifetimeType *Bound = nullptr;
+  while (!T.isNull()) {
+    if ((Bound = dyn_cast<ClassLifetimeType>(T.getTypePtr()))) break;
+    if (const auto *Alias = dyn_cast<TypedefType>(T.getTypePtr())) T = Alias->desugar();
+    else if (const auto *Paren = dyn_cast<ParenType>(T.getTypePtr())) T = Paren->getInnerType();
+    else if (const auto *Attr = dyn_cast<AttributedType>(T.getTypePtr())) T = Attr->getModifiedType();
+    else if (const auto *Subst = dyn_cast<SubstTemplateTypeParmType>(T.getTypePtr())) T = Subst->getReplacementType();
+    else break;
+  }
+  return Bound;
+}
+inline unsigned circleTypeLifetimeCount(QualType T, unsigned Depth = 0);
+inline bool circleClassHasStaticArguments(QualType T) {
+  const auto *Bound = circleClassLifetimeBinding(T);
+  return Bound && !Bound->getArguments().empty() &&
+      llvm::all_of(Bound->getArguments(), [](const IdentifierInfo *I) {
+        return I && I->isStr("static");
+      });
+}
+// Whether a substitution still carries a lifetime that a `where T: static`
+// constraint can constrain. A dependent parameter is unknown until it is
+// substituted; a scalar or a class without region arguments contributes no
+// lifetime, so the constraint is vacuous for it.
+inline bool circleTypeCarriesLifetimes(QualType T, unsigned = 0) {
+  llvm::SmallVector<QualType, 16> Pending{T};
+  llvm::SmallPtrSet<const Type *, 32> Seen;
+  while (!Pending.empty()) {
+    QualType Current = Pending.pop_back_val();
+    if (Current.isNull() || !Seen.insert(Current.getTypePtr()).second) continue;
+    if (circleIsCallableValue(Current) && !circleCallableCaptures(Current).empty()) return true;
+    if (Current->getAs<BorrowValueType>() || Current->isDependentType() ||
+        Current->isReferenceType()) return true;
+    if (const auto *Binding = circleClassLifetimeBinding(Current))
+      if (!Binding->getArguments().empty()) return true;
+    if (const auto *Array = Current->getAsArrayTypeUnsafe()) {
+      Pending.push_back(Array->getElementType());
+      continue;
+    }
+    if (const auto *Record = Current->getAsCXXRecordDecl()) {
+      if (!Record->hasDefinition()) continue;
+      Record = Record->getDefinition();
+      for (const auto &Base : Record->bases()) Pending.push_back(Base.getType());
+      for (const auto *Field : Record->fields()) Pending.push_back(Field->getType());
+    }
+  }
+  return false;
+}
+inline FunctionProtoType::ExtParameterInfo circleNormalizeStaticTypeLifetimes(
+    QualType T, FunctionProtoType::ExtParameterInfo Info) {
+  if (Info.hasStaticTypeLifetimes() && !circleTypeCarriesLifetimes(T))
+    return Info.withStaticTypeLifetimes(false);
+  return Info;
+}
+inline const CXXRecordDecl *circleClassRecord(QualType T) {
+  if (T.isNull()) return nullptr;
+  if (const auto *Binding = circleClassLifetimeBinding(T))
+    T = Binding->getWrappedType();
+  if (const auto *B = T->getAs<BorrowValueType>()) T = B->getPointeeType();
+  else if (T->isReferenceType()) T = T->getPointeeType();
+  return T->getAsCXXRecordDecl();
+}
+inline const CXXRecordDecl *circleClassPatternRecord(QualType T) {
+  if (auto *R = circleClassRecord(T)) {
+    if (R->hasDefinition() && !R->fields().empty()) return R;
+    if (auto *Spec = dyn_cast<ClassTemplateSpecializationDecl>(R))
+      if (auto *Template = Spec->getSpecializedTemplate())
+        return Template->getTemplatedDecl();
+    return R;
+  }
+  if (const auto *Spec = T->getAs<TemplateSpecializationType>())
+    if (auto *Template = dyn_cast_or_null<ClassTemplateDecl>(
+            Spec->getTemplateName().getAsTemplateDecl()))
+      return Template->getTemplatedDecl();
+  return nullptr;
+}
+inline llvm::SmallVector<llvm::StringRef, 4>
+circleClassLifetimeNames(const CXXRecordDecl *R) {
+  llvm::SmallVector<llvm::StringRef, 4> Names;
+  if (!R) return Names;
+  if (R->hasDefinition()) R = R->getDefinition();
+  for (const auto *A : R->specific_attrs<AnnotateAttr>()) {
+    auto Text = A->getAnnotation();
+    if (A->isImplicit() && Text.consume_front("safecpp.native.class.lifetimes:")) {
+      Text.split(Names, ',');
+      break;
+    }
+  }
+  if (Names.empty()) {
+    // `typename T+` invents a template lifetime parameter for every region
+    // carried by the argument. Give the invented parameters stable internal
+    // names so field regions and the hoisted specialization arguments share
+    // one index space. The user-facing names remain those written on the
+    // specialization (`Holder<View>/a`).
+    auto *Spec = llvm::dyn_cast<ClassTemplateSpecializationDecl>(R);
+    if (Spec) {
+      auto *Template = Spec->getSpecializedTemplate();
+      auto *List = Template->getTemplateParameters();
+      auto &Args = Spec->getTemplateArgs();
+      auto &Idents = R->getASTContext().Idents;
+      unsigned ArgIndex = 0;
+      for (unsigned I = 0; I < List->size(); ++I) {
+        auto *P = List->getParam(I);
+        bool Binder = false;
+        if (llvm::isa<TemplateTypeParmDecl>(P))
+          for (const auto *A : P->specific_attrs<AnnotateAttr>())
+            Binder |= A->isImplicit() &&
+                      A->getAnnotation() == "safecpp.native.lifetime_binder";
+        if (P->isParameterPack()) {
+          unsigned Trailing = List->size() - I - 1;
+          unsigned End =
+              Args.size() >= Trailing ? Args.size() - Trailing : ArgIndex;
+          if (End < ArgIndex) End = ArgIndex;
+          if (Binder && End == ArgIndex) {
+            // An unexpanded dependent pack still needs one stable identity.
+            Names.push_back(Idents.get("T" + std::to_string(I)).getName());
+          } else if (Binder) {
+            unsigned Slot = 0;
+            for (unsigned J = ArgIndex; J < End; ++J) {
+              if (Args[J].getKind() != TemplateArgument::Type &&
+                  Args[J].getKind() != TemplateArgument::Pack)
+                continue;
+              unsigned Count = Args[J].getKind() == TemplateArgument::Type
+                  ? circleTypeLifetimeCount(Args[J].getAsType())
+                  : 0;
+              if (Args[J].getKind() == TemplateArgument::Pack)
+                for (const auto &Element : Args[J].pack_elements())
+                  if (Element.getKind() == TemplateArgument::Type)
+                    Count += circleTypeLifetimeCount(Element.getAsType());
+              for (unsigned K = 0; K < Count; ++K) {
+                std::string Name = "T" + std::to_string(I) + "." +
+                                   std::to_string(Slot++);
+                Names.push_back(Idents.get(Name).getName());
+              }
+            }
+          }
+          ArgIndex = End;
+          continue;
+        }
+        if (Binder && ArgIndex < Args.size() &&
+            Args[ArgIndex].getKind() == TemplateArgument::Type) {
+          unsigned Count = circleTypeLifetimeCount(Args[ArgIndex].getAsType());
+          for (unsigned J = 0; J < Count; ++J) {
+            std::string Name = "T" + std::to_string(I);
+            if (Count > 1) Name += "." + std::to_string(J);
+            Names.push_back(Idents.get(Name).getName());
+          }
+        }
+        if (ArgIndex < Args.size()) ++ArgIndex;
+      }
+    }
+  }
+  return Names;
+}
+inline unsigned circleClassLifetimeIndex(const CXXRecordDecl *R,
+                                         llvm::StringRef Name) {
+  auto Names = circleClassLifetimeNames(R);
+  for (unsigned I = 0; I < Names.size(); ++I)
+    if (Names[I] == Name) return I + 1;
+  return 0;
+}
+inline bool circleRecordHasLifetimeBinderParameter(const CXXRecordDecl *R) {
+  if (!R) return false;
+  const clang::TemplateParameterList *List = nullptr;
+  if (auto *Spec = llvm::dyn_cast<ClassTemplateSpecializationDecl>(R))
+    if (auto *Template = Spec->getSpecializedTemplate())
+      List = Template->getTemplateParameters();
+  if (!List)
+    if (auto *Template = R->getDescribedClassTemplate())
+      List = Template->getTemplateParameters();
+  if (!List) return false;
+  for (auto *P : List->asArray())
+    if (llvm::isa<TemplateTypeParmDecl>(P))
+      for (const auto *A : P->specific_attrs<AnnotateAttr>())
+        if (A->isImplicit() &&
+            A->getAnnotation() == "safecpp.native.lifetime_binder")
+          return true;
+  return false;
+}
+inline bool circleFieldIsLifetimeProjection(const FieldDecl *F) {
+  if (!F) return false;
+  for (const auto *A : F->specific_attrs<AnnotateAttr>())
+    if (A->isImplicit() &&
+        A->getAnnotation() == "safecpp.native.lifetime_projection")
+      return true;
+  return false;
+}
+// The number of regions a type contributes to a lifetime-binder template
+// argument. A `T+` parameter contributes the regions of its actual argument;
+// a dependent binder contributes one region until substitution. This is the
+// count used when a class specialization writes the hoisted lifetime
+// arguments explicitly (`Holder<T>/a`).
+inline unsigned circleTypeLifetimeCount(QualType T, unsigned) {
+  // Query-local memoization follows the finite type graph. A nesting depth is
+  // not evidence that a well-formed T+ specialization has no regions.
+  std::map<const Type *, unsigned> Counts;
+  llvm::SmallPtrSet<const Type *, 32> Active;
+  auto Count = [&](auto &&Self, QualType Type) -> unsigned {
+    if (Type.isNull()) return 0;
+    const auto *Key = Type.getTypePtr();
+    if (auto I = Counts.find(Key); I != Counts.end()) return I->second;
+    if (!Active.insert(Key).second) return 0;
+    auto Inspect = [&]() -> unsigned {
+      if (const auto *Bound = circleClassLifetimeBinding(Type))
+        return Bound->getArguments().size();
+      if (Type->getAs<BorrowValueType>() || Type->isReferenceType()) return 1;
+      if (circleIsCallableValue(Type)) return circleCallableCaptures(Type).size();
+      if (const auto *Array = Type->getAsArrayTypeUnsafe())
+        return Self(Self, Array->getElementType());
+      if (const auto *Parm = Type->getAs<TemplateTypeParmType>()) {
+        if (const auto *D = Parm->getDecl())
+          for (const auto *A : D->specific_attrs<AnnotateAttr>())
+            if (A->isImplicit() && A->getAnnotation() == "safecpp.native.lifetime_binder")
+              return 1;
+        return 0;
+      }
+      if (const auto *Subst = Type->getAs<SubstTemplateTypeParmType>())
+        return Self(Self, Subst->getReplacementType());
+      if (const auto *Alias = dyn_cast<TemplateSpecializationType>(Key);
+          Alias && Alias->isTypeAlias()) return Self(Self, Alias->getAliasedType());
+      if (const auto *Record = circleClassPatternRecord(Type))
+        for (const auto *A : Record->specific_attrs<AnnotateAttr>()) {
+          auto Text = A->getAnnotation();
+          if (A->isImplicit() && Text.consume_front("safecpp.native.class.lifetimes:")) {
+            llvm::SmallVector<llvm::StringRef, 4> Names;
+            Text.split(Names, ',');
+            return Names.size();
+          }
+        }
+      const TemplateParameterList *Params = nullptr;
+      ArrayRef<TemplateArgument> Args;
+      if (const auto *Spec = Type->getAs<TemplateSpecializationType>()) {
+        if (const auto *Template = Spec->getTemplateName().getAsTemplateDecl())
+          Params = Template->getTemplateParameters();
+        Args = Spec->template_arguments();
+      } else if (const auto *Spec = dyn_cast_or_null<ClassTemplateSpecializationDecl>(
+                     circleClassRecord(Type))) {
+        Params = Spec->getSpecializedTemplate()->getTemplateParameters();
+        Args = Spec->getTemplateArgs().asArray();
+      }
+      if (!Params) return 0;
+      auto Binder = [](const NamedDecl *P) {
+        if (!isa<TemplateTypeParmDecl>(P)) return false;
+        for (const auto *A : P->specific_attrs<AnnotateAttr>())
+          if (A->isImplicit() && A->getAnnotation() == "safecpp.native.lifetime_binder")
+            return true;
+        return false;
+      };
+      auto Argument = [&](auto &&Visit, const TemplateArgument &A) -> unsigned {
+        if (A.getKind() == TemplateArgument::Type) return Self(Self, A.getAsType());
+        unsigned N = 0;
+        if (A.getKind() == TemplateArgument::Pack)
+          for (const auto &Element : A.pack_elements()) N += Visit(Visit, Element);
+        return N;
+      };
+      unsigned Result = 0, Next = 0;
+      for (unsigned I = 0; I < Params->size(); ++I) {
+        const auto *P = Params->getParam(I);
+        if (!P->isParameterPack()) {
+          if (Binder(P)) Result += Next < Args.size() ? Argument(Argument, Args[Next]) : 1;
+          if (Next < Args.size()) ++Next;
+          continue;
+        }
+        unsigned Trailing = Params->size() - I - 1;
+        unsigned End = std::max<unsigned>(Next, Args.size() >= Trailing ? Args.size() - Trailing : Next);
+        if (Binder(P) && Next == End && Type->isDependentType()) ++Result;
+        for (; Next < End; ++Next)
+          if (Binder(P)) Result += Argument(Argument, Args[Next]);
+      }
+      return Result;
+    };
+    unsigned Result = Inspect();
+    Active.erase(Key);
+    Counts.emplace(Key, Result);
+    return Result;
+  };
+  return Count(Count, T);
+}
+inline unsigned circleFieldLifetime(const FieldDecl *F) {
+  if (!F) return 0;
+  for (const auto *A : F->specific_attrs<AnnotateAttr>()) {
+    auto Text = A->getAnnotation();
+    if (A->isImplicit() && Text.consume_front("safecpp.native.class.field_lifetime:"))
+      return circleClassLifetimeIndex(dyn_cast<CXXRecordDecl>(F->getParent()), Text);
+  }
+  return 0;
+}
+// Map a field's local carried regions to the declaring record's region
+// space. A template parameter's identity survives substitution even when two
+// arguments have the same canonical type. Field order cannot recover it.
+class CircleClassRegionProjection {
+  using Regions = llvm::SmallVector<unsigned, 4>;
+  using Elements = llvm::SmallVector<Regions, 2>;
+  using Environment = std::map<const TemplateTypeParmDecl *, Elements>;
+  const CXXRecordDecl *Owner;
+  Environment Parameters;
+  using Query = std::pair<const Type *, Environment>;
+  mutable std::map<Query, Regions> Completed;
+  mutable std::set<Query> Active;
+
+  mutable std::map<Query, Regions> Traced;
+  mutable std::set<Query> Tracing;
+  Regions trace(QualType T, const Environment &Env) const {
+    if (T.isNull()) return {};
+    Query Key(T.getTypePtr(), Env);
+    if (auto I = Traced.find(Key); I != Traced.end()) return I->second;
+    if (!Tracing.insert(Key).second) return {};
+    auto Inspect = [&]() -> Regions {
+      if (T->isPointerType() || T->isReferenceType()) return trace(T->getPointeeType(), Env);
+      if (const auto *A = T->getAsArrayTypeUnsafe()) return trace(A->getElementType(), Env);
+      if (const auto *A = dyn_cast<PackExpansionType>(T.getTypePtr())) return trace(A->getPattern(), Env);
+      if (const auto *P = dyn_cast<TemplateTypeParmType>(T.getTypePtr())) {
+        auto I = Env.find(P->getDecl());
+        if (!P->getDecl())
+          for (auto Candidate = Env.begin(); Candidate != Env.end(); ++Candidate)
+            if (Candidate->first->getDepth() == P->getDepth() && Candidate->first->getIndex() == P->getIndex()) {
+              if (I != Env.end()) return {};
+              I = Candidate;
+            }
+        if (I != Env.end()) {
+          Regions Result;
+          for (const auto &E : I->second) llvm::append_range(Result, E);
+          return Result;
+        }
+      }
+      if (const auto *P = dyn_cast<SubstTemplateTypeParmPackType>(T.getTypePtr())) {
+        auto I = Env.find(P->getReplacedParameter());
+        if (I != Env.end()) {
+          Regions Result;
+          for (const auto &E : I->second) llvm::append_range(Result, E);
+          return Result;
+        }
+      }
+      if (const auto *S = dyn_cast<SubstTemplateTypeParmType>(T.getTypePtr())) {
+        auto I = Env.find(S->getReplacedParameter());
+        if (I != Env.end()) return project(T, Env);
+        return trace(S->getReplacementType(), Env);
+      }
+      ArrayRef<TemplateArgument> Args;
+      if (const auto *A = T->getAs<TemplateSpecializationType>(); A && !A->isTypeAlias())
+        Args = A->template_arguments();
+      else if (const auto *A = dyn_cast_or_null<ClassTemplateSpecializationDecl>(T->getAsCXXRecordDecl()))
+        Args = A->getTemplateArgs().asArray();
+      if (!Args.empty()) {
+        Regions Result;
+        auto Add = [&](auto &&Self, const TemplateArgument &A) -> void {
+          if (A.getKind() == TemplateArgument::Type) {
+            auto Part = trace(A.getAsType(), Env);
+            if (Part.empty()) Part.resize(circleTypeLifetimeCount(A.getAsType()), 0);
+            llvm::append_range(Result, Part);
+          } else if (A.getKind() == TemplateArgument::Pack)
+            for (const auto &E : A.pack_elements()) Self(Self, E);
+        };
+        for (const auto &A : Args) Add(Add, A);
+        return Result;
+      }
+      auto Result = project(T, Env);
+      if (Result.empty()) Result.resize(circleTypeLifetimeCount(T), 0);
+      return Result;
+    };
+    auto Result = Inspect();
+    Tracing.erase(Key); Traced.emplace(std::move(Key), Result); return Result;
+  }
+  Elements metaRanges(const TemplateArgument &A, unsigned &Next) const {
+    Elements Result;
+    auto Add = [&](const TemplateArgument &E) {
+      Regions R;
+      if (E.getKind() == TemplateArgument::Type)
+        for (unsigned I = 0, N = trace(E.getAsType(), {}).size(); I < N; ++I) R.push_back(Next++);
+      Result.push_back(std::move(R));
+    };
+    if (A.getKind() == TemplateArgument::Pack)
+      for (const auto &E : A.pack_elements()) Add(E);
+    else Add(A);
+    return Result;
+  }
+
+  Environment inherited(QualType T, Environment Env) const {
+    auto *R = T->getAsCXXRecordDecl();
+    if (!R || !R->hasDefinition()) return Env;
+    auto Original = Env;
+    std::set<const TemplateTypeParmDecl *> Added;
+    for (const auto &Base : R->getDefinition()->bases()) {
+      auto Scope = qualified(NestedNameSpecifier(Base.getType().getTypePtr()), Original);
+      for (auto &[P, Values] : Scope) {
+        if (Original.count(P)) continue;
+        if (Added.insert(P).second) Env[P] = std::move(Values);
+        else if (Env[P] != Values)
+          for (auto &Value : Env[P]) for (auto &ID : Value) ID = 0;
+      }
+    }
+    return Env;
+  }
+
+  // Alias declarations are shared by equal specializations. Their qualifier,
+  // unlike their canonical replacement, retains the caller's parameter sugar.
+  // Compose that environment before following the associated declaration.
+  Environment qualified(NestedNameSpecifier Q, const Environment &Env) const {
+    if (!Q || Q.getKind() != NestedNameSpecifier::Kind::Type) return Env;
+    QualType T(Q.getAsType(), 0);
+    const auto *A = T->getAs<TemplateSpecializationType>();
+    if (!A) return inherited(T, Env);
+    auto Local = qualified(A->getTemplateName().getQualifier(), Env);
+    auto *Template = A->getTemplateName().getAsTemplateDecl();
+    if (!Template) return Local;
+    auto *List = Template->getTemplateParameters();
+    auto Args = A->template_arguments();
+    unsigned Next = 0;
+    Environment Bound;
+    for (unsigned I = 0; I < List->size() && Next < Args.size(); ++I) {
+      const auto *P = dyn_cast<TemplateTypeParmDecl>(List->getParam(I));
+      unsigned End = List->getParam(I)->isParameterPack()
+          ? Args.size() - std::min<unsigned>(Args.size() - Next, List->size() - I - 1)
+          : Next + 1;
+      Elements Values;
+      auto Add = [&](const TemplateArgument &Arg) {
+        Regions R;
+        if (Arg.getKind() == TemplateArgument::Type) {
+          R = trace(Arg.getAsType(), Local);
+          if (R.empty()) R.resize(circleTypeLifetimeCount(Arg.getAsType()), 0);
+        }
+        Values.push_back(std::move(R));
+      };
+      for (; Next < End; ++Next)
+        if (Args[Next].getKind() == TemplateArgument::Pack)
+          for (const auto &Arg : Args[Next].pack_elements()) Add(Arg);
+        else Add(Args[Next]);
+      if (P) Bound[P] = std::move(Values);
+    }
+    // A selected partial specialization has its own binder declarations. Map
+    // its pattern to the primary slots before entering its member aliases.
+    if (const auto *Spec = dyn_cast_or_null<ClassTemplateSpecializationDecl>(
+            T->getAsCXXRecordDecl()))
+      if (auto *Partial = Spec->getSpecializedTemplateOrPartial()
+                              .dyn_cast<ClassTemplatePartialSpecializationDecl *>()) {
+        Environment Deduced;
+        unsigned Token = 1;
+        auto Values = Spec->getTemplateInstantiationArgs().asArray();
+        auto *Params = Partial->getTemplateParameters();
+        for (unsigned I = 0; I < Params->size() && I < Values.size(); ++I)
+          if (const auto *P = dyn_cast<TemplateTypeParmDecl>(Params->getParam(I)))
+            Deduced[P] = metaRanges(Values[I], Token);
+        std::map<unsigned, std::set<unsigned>> Images;
+        auto Pattern = Partial->getTemplateArgs().asArray();
+        for (unsigned I = 0; I < List->size() && I < Pattern.size(); ++I) {
+          const auto *P = dyn_cast<TemplateTypeParmDecl>(List->getParam(I));
+          if (!P) continue;
+          Regions Part;
+          auto TraceArgument = [&](auto &&Self, const TemplateArgument &A) -> void {
+            if (A.getKind() == TemplateArgument::Type)
+              llvm::append_range(Part, trace(A.getAsType(), Deduced));
+            else if (A.getKind() == TemplateArgument::Pack)
+              for (const auto &E : A.pack_elements()) Self(Self, E);
+          };
+          TraceArgument(TraceArgument, Pattern[I]);
+          auto Image = Bound.find(P);
+          if (Image == Bound.end()) continue;
+          Regions Flattened;
+          for (const auto &Element : Image->second) llvm::append_range(Flattened, Element);
+          if (Part.size() != Flattened.size()) continue;
+          for (unsigned J = 0; J < Part.size(); ++J)
+            if (Part[J]) Images[Part[J]].insert(Flattened[J]);
+        }
+        Bound.clear();
+        for (auto &[P, Values] : Deduced) {
+          for (auto &Value : Values)
+            for (auto &ID : Value) {
+              auto I = Images.find(ID);
+              ID = I != Images.end() && I->second.size() == 1 ? *I->second.begin() : 0;
+            }
+          Bound[P] = std::move(Values);
+        }
+      }
+    for (auto &[P, Values] : Bound) Local[P] = std::move(Values);
+    return inherited(T, std::move(Local));
+  }
+
+  static bool binder(const NamedDecl *P) {
+    for (const auto *A : P->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == "safecpp.native.lifetime_binder")
+        return true;
+    return false;
+  }
+  static Elements ranges(const TemplateArgument &A, unsigned &Next) {
+    Elements Result;
+    auto Add = [&](const TemplateArgument &E) {
+      Regions R;
+      if (E.getKind() == TemplateArgument::Type)
+        for (unsigned I = 0, N = circleTypeLifetimeCount(E.getAsType()); I < N; ++I)
+          R.push_back(Next++);
+      Result.push_back(std::move(R));
+    };
+    if (A.getKind() == TemplateArgument::Pack)
+      for (const auto &E : A.pack_elements()) Add(E);
+    else Add(A);
+    return Result;
+  }
+  Regions project(QualType T, const Environment &Env) const {
+    if (T.isNull()) return {};
+    Query Key(T.getTypePtr(), Env);
+    if (auto I = Completed.find(Key); I != Completed.end()) return I->second;
+    if (!Active.insert(Key).second) return {};
+    auto Result = projectImpl(T, Env);
+    Active.erase(Key);
+    Completed.emplace(std::move(Key), Result);
+    return Result;
+  }
+  Regions projectImpl(QualType T, const Environment &Env) const {
+    // Inspect sugar before desugaring: the replacement alone loses which of
+    // several equal arguments supplied this field.
+    if (const auto *S = dyn_cast<SubstTemplateTypeParmType>(T.getTypePtr())) {
+      auto I = Env.find(S->getReplacedParameter());
+      if (I != Env.end()) {
+        unsigned Slot = 0;
+        if (auto Pack = S->getPackIndex()) {
+          if (*Pack >= I->second.size()) return {};
+          Slot = I->second.size() - 1 - *Pack; // Clang stores reverse indices.
+        }
+        return Slot < I->second.size() ? I->second[Slot] : Regions();
+      }
+      return project(S->getReplacementType(), Env);
+    }
+    if (const auto *P = dyn_cast<TemplateTypeParmType>(T.getTypePtr())) {
+      auto I = Env.find(P->getDecl());
+      // Partial-specialization argument lists are canonicalized: their
+      // parameter types can omit the declaration pointer while retaining
+      // the semantic depth/index identity in this pattern's environment.
+      if (!P->getDecl())
+        for (auto Candidate = Env.begin(); Candidate != Env.end(); ++Candidate)
+          if (Candidate->first->getDepth() == P->getDepth() &&
+              Candidate->first->getIndex() == P->getIndex()) {
+            if (I != Env.end()) return {};
+            I = Candidate;
+          }
+      if (I == Env.end()) return {};
+      if (P->isParameterPack()) {
+        Regions Result;
+        for (const auto &Element : I->second) llvm::append_range(Result, Element);
+        return Result;
+      }
+      return I->second.size() == 1 ? I->second.front() : Regions();
+    }
+    if (const auto *P = dyn_cast<SubstTemplateTypeParmPackType>(T.getTypePtr())) {
+      auto I = Env.find(P->getReplacedParameter());
+      if (I == Env.end()) return {};
+      Regions Result;
+      for (const auto &Element : I->second) llvm::append_range(Result, Element);
+      return Result;
+    }
+    if (const auto *P = dyn_cast<PackExpansionType>(T.getTypePtr()))
+      return project(P->getPattern(), Env);
+    if (const auto *A = Owner->getASTContext().getAsArrayType(T))
+      return project(A->getElementType(), Env);
+    if (const auto *B = dyn_cast<ClassLifetimeType>(T.getTypePtr())) {
+      Regions Result;
+      for (const auto *Name : B->getArguments())
+        Result.push_back(!Name ? 0 : Name->isStr("static") ? 0x40000000u
+            : circleClassLifetimeIndex(Owner, Name->getName()));
+      return Result;
+    }
+    if (const auto *A = dyn_cast<TypedefType>(T.getTypePtr()))
+      return project(A->desugar(), qualified(A->getQualifier(), Env));
+    if (const auto *A = dyn_cast<UsingType>(T.getTypePtr()))
+      return project(A->desugar(), qualified(A->getQualifier(), Env));
+    if (const auto *A = dyn_cast<ParenType>(T.getTypePtr()))
+      return project(A->getInnerType(), Env);
+    if (const auto *A = dyn_cast<AttributedType>(T.getTypePtr()))
+      return project(A->getModifiedType(), Env);
+    if (const auto *A = dyn_cast<TemplateSpecializationType>(T.getTypePtr())) {
+      if (A->isTypeAlias()) {
+        auto Q = NestedNameSpecifier(A);
+        return project(A->getAliasedType(), qualified(Q, Env));
+      }
+      auto *Template = dyn_cast_or_null<ClassTemplateDecl>(
+          A->getTemplateName().getAsTemplateDecl());
+      if (!Template) return {};
+      auto Args = A->template_arguments();
+      auto *List = Template->getTemplateParameters();
+      Regions Result;
+      unsigned ArgIndex = 0;
+      for (unsigned I = 0; I < List->size() && ArgIndex < Args.size(); ++I) {
+        const auto *P = List->getParam(I);
+        auto Add = [&](const TemplateArgument &Arg) {
+          if (!binder(P) || Arg.getKind() != TemplateArgument::Type) return;
+          auto Part = project(Arg.getAsType(), Env);
+          // Preserve unknown spans so later arguments never shift left.
+          if (Part.empty()) Part.resize(circleTypeLifetimeCount(Arg.getAsType()), 0);
+          Result.append(Part.begin(), Part.end());
+        };
+        unsigned End = P->isParameterPack()
+            ? Args.size() - std::min<unsigned>(Args.size() - ArgIndex, List->size() - I - 1)
+            : ArgIndex + 1;
+        for (; ArgIndex < End; ++ArgIndex)
+          if (Args[ArgIndex].getKind() == TemplateArgument::Pack)
+            for (const auto &E : Args[ArgIndex].pack_elements()) Add(E);
+          else Add(Args[ArgIndex]);
+      }
+      return Result;
+    }
+    return {};
+  }
+
+public:
+  explicit CircleClassRegionProjection(const CXXRecordDecl *R) : Owner(R) {
+    if (!R) return;
+    const auto *Spec = dyn_cast<ClassTemplateSpecializationDecl>(R);
+    auto *Template = Spec ? Spec->getSpecializedTemplate() : R->getDescribedClassTemplate();
+    if (!Template) return;
+    auto *List = Template->getTemplateParameters();
+    unsigned Next = 1;
+    if (!Spec) {
+      for (const auto *D : List->asArray())
+        if (const auto *P = dyn_cast<TemplateTypeParmDecl>(D); P && binder(P))
+          Parameters[P] = Elements{Regions{Next++}};
+      return;
+    }
+    auto Args = Spec->getTemplateArgs().asArray();
+    for (unsigned I = 0; I < List->size() && I < Args.size(); ++I)
+      if (const auto *P = dyn_cast<TemplateTypeParmDecl>(List->getParam(I)); P && binder(P))
+        Parameters[P] = ranges(Args[I], Next);
+    if (auto *Partial = Spec->getSpecializedTemplateOrPartial()
+                            .dyn_cast<ClassTemplatePartialSpecializationDecl *>()) {
+      // Give each deduced partial parameter a temporary identity, project the
+      // specialization pattern onto primary argument slots, then replace the
+      // temporary identities with their unique enclosing-region images.
+      Environment Deduced;
+      unsigned Token = 1;
+      auto Values = Spec->getTemplateInstantiationArgs().asArray();
+      auto *Params = Partial->getTemplateParameters();
+      for (unsigned I = 0; I < Params->size() && I < Values.size(); ++I)
+        if (const auto *P = dyn_cast<TemplateTypeParmDecl>(Params->getParam(I)))
+          Deduced[P] = ranges(Values[I], Token);
+      std::map<unsigned, std::set<unsigned>> Images;
+      auto Pattern = Partial->getTemplateArgs().asArray();
+      for (unsigned I = 0; I < List->size() && I < Pattern.size(); ++I) {
+        auto *P = dyn_cast<TemplateTypeParmDecl>(List->getParam(I));
+        if (!P || !binder(P)) continue;
+        Regions Part;
+        auto ProjectArgument = [&](auto &&Self, const TemplateArgument &A) -> void {
+          if (A.getKind() == TemplateArgument::Type)
+            llvm::append_range(Part, project(A.getAsType(), Deduced));
+          else if (A.getKind() == TemplateArgument::Pack)
+            for (const auto &E : A.pack_elements()) Self(Self, E);
+        };
+        ProjectArgument(ProjectArgument, Pattern[I]);
+        auto Image = Parameters.find(P);
+        if (Image == Parameters.end()) continue;
+        Regions Flattened;
+        for (const auto &Element : Image->second) llvm::append_range(Flattened, Element);
+        if (Part.size() != Flattened.size()) continue;
+        for (unsigned J = 0; J < Part.size(); ++J)
+          if (Part[J]) Images[Part[J]].insert(Flattened[J]);
+      }
+      Parameters.clear();
+      for (auto &[P, Values] : Deduced) {
+        for (auto &Value : Values)
+          for (auto &ID : Value) {
+            auto I = Images.find(ID);
+            ID = I != Images.end() && I->second.size() == 1 ? *I->second.begin() : 0;
+          }
+        Parameters[P] = std::move(Values);
+      }
+    }
+  }
+  Regions field(const FieldDecl *F) const {
+    if (!Owner || !F) return {};
+    auto Result = project(F->getType(), Parameters);
+    if (!Result.empty()) return Result;
+    // A fully explicit specialization has no substituted parameter sugar.
+    // Preserve its existing single-argument projection only when the actual
+    // type identifies a unique region span. Repeated equal arguments are
+    // ambiguous and cannot be resolved by field names or declaration order.
+    const auto *Spec = dyn_cast<ClassTemplateSpecializationDecl>(Owner);
+    if (!Spec || !Spec->isExplicitSpecialization()) return {};
+    auto Args = Spec->getTemplateArgs().asArray();
+    auto *List = Spec->getSpecializedTemplate()->getTemplateParameters();
+    unsigned Next = 1;
+    bool Found = false;
+    for (unsigned I = 0; I < List->size() && I < Args.size(); ++I) {
+      if (!binder(List->getParam(I))) continue;
+      auto Spans = ranges(Args[I], Next);
+      if (Args[I].getKind() != TemplateArgument::Type || Spans.size() != 1 ||
+          !Owner->getASTContext().hasSameUnqualifiedType(F->getType(), Args[I].getAsType())) continue;
+      if (Found) return {};
+      Result = Spans.front(); Found = true;
+    }
+    return Result;
+  }
+};
+
+// Compose explicit class arguments, borrow durations and type-parameter
+// projections through the same field map used by provenance and variance.
+inline unsigned circleMappedFieldRegion(const FieldDecl *F, unsigned Region) {
+  if (!F || !Region) return 0;
+  auto *Parent = dyn_cast<CXXRecordDecl>(F->getParent());
+  QualType Element = F->getType();
+  while (const auto *Array = F->getASTContext().getAsArrayType(Element))
+    Element = Array->getElementType();
+  if (const auto *B = circleClassLifetimeBinding(Element);
+      B && Region <= B->getArguments().size()) {
+    auto *Name = B->getArguments()[Region - 1];
+    if (Name && Name->isStr("static")) return 0x40000000u;
+    if (Name)
+      if (unsigned I = circleClassLifetimeIndex(Parent, Name->getName())) return I;
+  }
+  if (Region == 1) {
+    if (unsigned I = circleFieldLifetime(F)) return I;
+    for (const auto *A : F->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == "safecpp.native.class.field_lifetime:static")
+        return 0x40000000u;
+  }
+  if (circleIsCallableValue(Element) && !circleClassLifetimeNames(Parent).empty()) {
+    auto Captures = circleCallableCaptures(Element);
+    if (Region <= Captures.size() && circleCaptureDepth(Captures[Region - 1]) == 1)
+      return circleCaptureSlot(Captures[Region - 1]);
+  }
+  if (!circleRecordHasLifetimeBinderParameter(Parent)) return 0;
+  auto Projection = CircleClassRegionProjection(Parent).field(F);
+  return Region <= Projection.size() ? Projection[Region - 1] : 0;
+}
+inline unsigned circleProjectedFieldOrdinal(const FieldDecl *F) {
+  return circleMappedFieldRegion(F, 1);
+}
+inline unsigned circleProjectedFieldRegion(QualType OwnerType, const FieldDecl *F) {
+  auto *Binding = circleClassLifetimeBinding(OwnerType);
+  if (!Binding || !F || circleTypeLifetimeCount(F->getType()) != 1) return 0;
+  unsigned Region = circleMappedFieldRegion(F, 1);
+  return Region && Region <= Binding->getArguments().size() ? Region : 0;
+}
+// The field shape of a modeled class value: every field is either a direct
+// scalar borrow that declares its own region here, or a nested class value of
+// the same shape whose regions are projected onto this record. CarriesFirst
+// reports whether some field carries this record's first region, AnyRegion
+// whether some field carries a region at all (a field may instead carry a
+// static region).
+inline bool circleRegionFieldShape(const CXXRecordDecl *Root, bool &First,
+                                   bool &Any, unsigned = 0) {
+  struct Shape { bool Valid, First, Any; };
+  std::map<const CXXRecordDecl *, Shape> Shapes;
+  llvm::SmallPtrSet<const CXXRecordDecl *, 32> Active;
+  auto Inspect = [&](auto &&Self, const CXXRecordDecl *R,
+                     bool &CarriesFirst, bool &AnyRegion) -> bool {
+    if (!R || !R->hasDefinition()) return false;
+    R = R->getDefinition();
+    if (auto I = Shapes.find(R); I != Shapes.end()) {
+      CarriesFirst |= I->second.First; AnyRegion |= I->second.Any;
+      return I->second.Valid;
+    }
+    if (!Active.insert(R).second) return false;
+    bool Valid = [&]() {
+      if (R->getNumBases()) return false;
+      for (auto *Field : R->fields()) {
+        auto Type = Field->getType();
+        unsigned TypeRegions = circleTypeLifetimeCount(Type);
+        if (Type->isPointerType() && circleRecordHasLifetimeBinderParameter(R) &&
+            circleTypeLifetimeCount(Type->getPointeeType()) == 1 &&
+            circleClassLifetimeNames(R).size() == 1) {
+          CarriesFirst = AnyRegion = true;
+          continue;
+        }
+        if (circleIsCallableValue(Type) && TypeRegions) {
+          for (unsigned I = 1; I <= TypeRegions; ++I) {
+            unsigned Region = circleMappedFieldRegion(Field, I);
+            if (!Region) return false;
+            CarriesFirst |= Region == 1;
+            AnyRegion |= Region != 0x40000000u;
+          }
+          continue;
+        }
+        bool Projected =
+            (circleFieldIsLifetimeProjection(Field) ||
+             circleTypeCarriesLifetimes(Type)) &&
+            circleRecordHasLifetimeBinderParameter(R);
+        bool Static = false;
+        for (auto *A : Field->specific_attrs<AnnotateAttr>())
+          Static |= A->isImplicit() &&
+                    A->getAnnotation() == "safecpp.native.class.field_lifetime:static";
+        if (Type->getAs<BorrowValueType>()) {
+          // A borrow field names one object or slice region regardless of the
+          // pointee's kind. `ref_cell::ref` stores a borrow to its `cell<int>`
+          // counter, which is a record rather than a slice or scalar.
+          unsigned Region = circleFieldLifetime(Field);
+          if (!Region && Projected && TypeRegions == 1)
+            Region = 1;
+          if (!Region && !Static) return false;
+          CarriesFirst |= Region == 1;
+          AnyRegion |= Region != 0;
+          continue;
+        }
+        const auto *Binding = circleClassLifetimeBinding(Type);
+        const auto *Nested = circleClassPatternRecord(Type);
+        unsigned Region = circleFieldLifetime(Field);
+        if (!Region && Projected && TypeRegions == 1)
+          Region = 1;
+        bool NestedBound =
+            Binding && Binding->getArguments().size() == 1 &&
+            Binding->getArguments()[0] &&
+            !Binding->getArguments()[0]->isStr("static");
+        if (Nested && (Region || (Projected && TypeRegions > 1)) &&
+            (NestedBound || !Binding)) {
+          bool NestedFirst = false, NestedAny = false;
+          if (!Self(Self, Nested, NestedFirst, NestedAny))
+            return false;
+          CarriesFirst |= Region == 1 ||
+                          (Region == 0 && Projected && TypeRegions > 1);
+          AnyRegion |= Region != 0 || (Projected && TypeRegions > 1);
+          continue;
+        }
+        if (Type->isArrayType()) {
+          // An array of borrow slots binds the field's declared region through
+          // every element. The elements keep separate origins in the flow
+          // analysis; the class value projects the one region this field names.
+          if (!(Region || (Projected && TypeRegions == 1)) ||
+              !circleTypeCarriesLifetimes(Type))
+            return false;
+          CarriesFirst |= Region == 1 || (Region == 0 && Projected);
+          AnyRegion = true;
+          continue;
+        }
+        if (Static || Type->isRecordType() || Type->isReferenceType() ||
+            Type->isArrayType())
+          return false;
+      }
+      return true;
+    }();
+    Active.erase(R);
+    Shapes.emplace(R, Shape{Valid, CarriesFirst, AnyRegion});
+    return Valid;
+  };
+  return Inspect(Inspect, Root, First, Any);
+}
+// The first class-value summary: a single carried region in direct scalar
+// borrow fields. Other shapes need field-by-field source roles.
+inline const IdentifierInfo *circleSimpleClassValueRegion(QualType T) {
+  auto *Binding = circleClassLifetimeBinding(T);
+  auto *Record = circleClassRecord(T);
+  if (!Record && Binding)
+    if (auto *Specialization = Binding->getWrappedType()->getAs<TemplateSpecializationType>())
+      if (auto *Template = dyn_cast_or_null<ClassTemplateDecl>(Specialization->getTemplateName().getAsTemplateDecl()))
+        Record = Template->getTemplatedDecl();
+  if (!Binding || Binding->getArguments().size() != 1 || !Record ||
+      !Record->hasDefinition())
+    return nullptr;
+  if (circleClassLifetimeNames(Record).size() != 1 &&
+      !circleRecordHasLifetimeBinderParameter(Record))
+    return nullptr;
+  auto *Name = Binding->getArguments()[0];
+  if (!Name || Name->isStr("static")) return nullptr;
+  bool CarriesFirst = false, AnyRegion = false;
+  if (!circleRegionFieldShape(Record, CarriesFirst, AnyRegion)) return nullptr;
+  return CarriesFirst ? Name : nullptr;
+}
+inline bool circleClassRegionOutlives(const CXXRecordDecl *R, unsigned Long,
+                                      unsigned Short) {
+  if (!R || !Long || !Short) return false;
+  if (Long == Short) return true;
+  if (R->hasDefinition()) R = R->getDefinition();
+  auto Names = circleClassLifetimeNames(R);
+  unsigned Static = Names.size()+1;
+  auto Index = [&](llvm::StringRef Name) {
+    return Name == "static" ? Static : circleClassLifetimeIndex(R, Name);
+  };
+  llvm::SmallVector<unsigned, 8> Work{Long}, Seen;
+  while (!Work.empty()) {
+    unsigned Current = Work.pop_back_val();
+    if (llvm::is_contained(Seen, Current)) continue;
+    Seen.push_back(Current);
+    for (const auto *A : R->specific_attrs<AnnotateAttr>()) {
+      auto Text = A->getAnnotation();
+      if (!A->isImplicit() || !Text.consume_front("safecpp.native.class.outlives:")) continue;
+      auto Edge = Text.split(':');
+      if (Index(Edge.first) != Current) continue;
+      unsigned Next = Index(Edge.second);
+      if (Next == Short) return true;
+      if (Next) Work.push_back(Next);
+    }
+  }
+  return false;
+}
+inline bool circleClassRegionIsStatic(const CXXRecordDecl *R, unsigned Region) {
+  return Region && circleClassRegionOutlives(R, Region, circleClassLifetimeNames(R).size()+1);
+}
+// A class value that carries more than one region through direct scalar borrow
+// fields. Such a result has no single region identity: every region the record
+// declares is bound at the declaration, and the per-field correspondence is
+// recovered from the result type's region arguments, so each field can be
+// checked against the parameter bound to its own region.
+inline bool circleMultiRegionClassValue(QualType T) {
+  const auto *Binding = circleClassLifetimeBinding(T);
+  auto *Record = circleClassRecord(T);
+  if (!Record && Binding)
+    if (auto *Specialization = Binding->getWrappedType()->getAs<TemplateSpecializationType>())
+      if (auto *Template = dyn_cast_or_null<ClassTemplateDecl>(
+              Specialization->getTemplateName().getAsTemplateDecl()))
+        Record = Template->getTemplatedDecl();
+  if (!Binding || Binding->getArguments().size() < 2 || !Record)
+    return false;
+  if (!Record->hasDefinition() &&
+      !circleRecordHasLifetimeBinderParameter(Record))
+    return false;
+  auto Names = circleClassLifetimeNames(Record);
+  bool Positional =
+      circleRecordHasLifetimeBinderParameter(Record);
+  if (!Positional && Names.size() != Binding->getArguments().size())
+    return false;
+  // Arguments belong to the use site's binder, not the record's declaration.
+  // Their correspondence to fields is positional, independent of spelling.
+  for (auto *Argument : Binding->getArguments())
+    if (!Argument) return false;
+  // An entirely static value uses the static-result contract. Mixed values
+  // retain a projection for every region, including their static leaves.
+  if (circleClassHasStaticArguments(T)) return false;
+  bool CarriesFirst = false, AnyRegion = false;
+  const CXXRecordDecl *ShapeRecord = Record;
+  if ((!ShapeRecord->hasDefinition() || ShapeRecord->fields().empty()) &&
+      isa<ClassTemplateSpecializationDecl>(ShapeRecord))
+    if (auto *Template =
+            cast<ClassTemplateSpecializationDecl>(ShapeRecord)
+                ->getSpecializedTemplate())
+      ShapeRecord = Template->getTemplatedDecl();
+  if (!circleRegionFieldShape(ShapeRecord, CarriesFirst, AnyRegion))
+    return false;
+  return AnyRegion;
+}
