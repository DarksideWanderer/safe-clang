+static TypeSourceInfo *normalizeNativeLifetimes(Sema &S, Declarator &D,
+                                              TypeSourceInfo *Info) {
+  if (!Info) return Info;
+  QualType Leaf = Info->getType();
+  SmallVector<QualType, 4> Shells;
+  while (Leaf->isPointerType() || Leaf->isReferenceType() || Leaf->getAs<BorrowValueType>() ||
+         Leaf->isMemberPointerType()) {
+    Shells.push_back(Leaf); Leaf = Leaf->getPointeeType();
+  }
+  bool DeclaresPrototype = llvm::any_of(D.type_objects(), [](const DeclaratorChunk &Chunk) {
+    return Chunk.Kind == DeclaratorChunk::Function;
+  });
+  if (Shells.empty() || !Leaf->isFunctionProtoType() || !DeclaresPrototype)
+    return normalizeNativeFunctionLifetimes(S, D, Info);
+  auto *Function = normalizeNativeFunctionLifetimes(S, D,
+      S.Context.getTrivialTypeSourceInfo(Leaf, D.getBeginLoc()));
+  if (!Function) return nullptr;
+  QualType Rebuilt = Function->getType();
+  for (auto Shell : llvm::reverse(Shells)) {
+    if (Shell->isPointerType()) Rebuilt = S.Context.getPointerType(Rebuilt);
+    else if (const auto *R = Shell->getAs<LValueReferenceType>())
+      Rebuilt = S.Context.getLValueReferenceType(Rebuilt, R->isSpelledAsLValue(), R->isSafetyBorrow());
+    else if (Shell->isRValueReferenceType()) Rebuilt = S.Context.getRValueReferenceType(Rebuilt);
+    else if (const auto *M = Shell->getAs<MemberPointerType>())
+      Rebuilt = S.Context.getMemberPointerType(Rebuilt, M->getQualifier(), M->getMostRecentCXXRecordDecl());
+    else Rebuilt = S.Context.getBorrowValueType(Rebuilt);
+    Rebuilt = S.Context.getQualifiedType(Rebuilt, Shell.getLocalQualifiers());
+  }
+  auto *Adjusted = S.Context.CreateTypeSourceInfo(Rebuilt);
+  if (Adjusted->getTypeLoc().getFullDataSize() == Info->getTypeLoc().getFullDataSize())
+    memcpy(Adjusted->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getOpaqueData(),
+           Info->getTypeLoc().getFullDataSize());
+  return Adjusted;
 }
 
