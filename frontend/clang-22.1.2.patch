+const CXXRecordDecl *findCircleImplDefinition(ASTContext &C, DeclContext *DC,
+                                             CXXRecordDecl *Current,
+                                             QualType Self, QualType Contract) {
+  for (auto *D : DC->decls()) {
+    if (auto *Export = dyn_cast<ExportDecl>(D)) {
+      if (auto *Found = findCircleImplDefinition(C, Export, Current, Self, Contract))
+        return Found;
+      continue;
+    }
+    if (auto *NS = dyn_cast<NamespaceDecl>(D)) {
+      if (auto *Found = findCircleImplDefinition(C, NS, Current, Self, Contract))
+        return Found;
+      continue;
+    }
+    auto *R = dyn_cast<CXXRecordDecl>(D);
+    if (!R || R == Current || R->isDependentContext() ||
+        isa<ClassTemplateSpecializationDecl>(R) || !R->isCompleteDefinition() ||
+        !circleOwnedMarker(R, "safecpp.native.impl")) continue;
+    QualType OtherSelf = circleImplBinding(R, "safecpp.native.impl.self");
+    QualType OtherContract = circleImplBinding(R, "safecpp.native.impl.interface");
+    if (!OtherSelf.isNull() && !OtherContract.isNull() &&
+        C.hasSameType(Self, OtherSelf) && C.hasSameType(Contract, OtherContract))
+      return R;
