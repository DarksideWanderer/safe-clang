+/// The generated slice record stores the element address and element count, so
+/// that a slice borrow has an ordinary, ABI-stable record layout.
+QualType ASTContext::getCircleSliceType(QualType Element) const {
+  // A slice whose element is not known yet has no record to name. The native
+  // slice is the representation the substitution maps to the generated record
+  // once the element is concrete, so materialising a record here — with the
+  // element's spelling, a typedef or a template parameter — would bake a type
+  // that no later substitution can match.
+  // The element's spelling is not its type: a typedef of a template parameter
+  // is sugar, so the canonical type is what decides whether the element is
+  // known. A template parameter is instantiation dependent rather than
+  // dependent, so both tests must hold the record back until substitution
+  // names the element: materialising one here would name it after the
+  // parameter and no later substitution could match it.
+  QualType Canonical = getCanonicalType(Element);
+  if (Canonical->isDependentType() || Canonical->isInstantiationDependentType())
+    return getNativeSliceType(Element);
+  // Keying the record on the canonical element keeps one record for every
+  // spelling of an element, including a substituted template parameter, which
+  // would otherwise look up as a distinct type and materialise a second record
+  // with the same name.
+  auto Found = CircleSliceTypes.find(Canonical);
+  if (Found != CircleSliceTypes.end())
+    return Found->second;
+
+  // Imported function signatures can already name a generated slice record.
+  // The per-context cache is not serialized, so recover that record before
+  // creating one for the same element in the importing translation unit.
+  // Loading its definition may append types: index the vector instead of
+  // keeping an iterator across lazy AST deserialization.
+  for (unsigned I = 0; I < Types.size(); ++I) {
+    const auto *Tag = dyn_cast<RecordType>(Types[I]);
+    if (!Tag)
+      continue;
+    auto *Record = dyn_cast<CXXRecordDecl>(Tag->getDecl());
+    if (!Record || !Record->isImplicit())
+      continue;
+    QualType Imported = getCanonicalTagType(Record);
+    QualType ImportedElement = circleSliceElement(Imported);
+    if (!ImportedElement.isNull() &&
+        hasSameType(ImportedElement, Canonical)) {
+      CircleSliceTypes[Canonical] = Imported;
+      return Imported;
+    }
+  }
+
+  // The name must be stable across translation units: slices of the same
+  // element type are the same type when modules are combined.
+  std::string Spelling = Canonical.getAsString(getPrintingPolicy());
+  std::string Name = "__circle_slice";
+  for (char Ch : Spelling)
+    Name += llvm::isAlnum(Ch) ? Ch : '_';
+  if (Name.size() > 200)
+    Name = "__circle_slice_unnamed";
+
+  // Forming the record adds nodes to the context rather than changing what it
+  // already describes, so the lookup stays a const operation.
+  ASTContext &Mutable = const_cast<ASTContext &>(*this);
+  IdentifierInfo *II = &Idents.get(Name);
+  CXXRecordDecl *Record = CXXRecordDecl::Create(
+      *this, TagTypeKind::Struct, getTranslationUnitDecl(), SourceLocation(),
+      SourceLocation(), II);
+  Record->setImplicit();
+  // This is a compiler builtin type shared by translation units, even when
+  // first requested inside a named module. Its ABI name must not acquire that
+  // module's prefix when another module reuses the same slice element type.
+  Record->setModuleOwnershipKind(Decl::ModuleOwnershipKind::Unowned);
+  Record->setLexicalDeclContext(getTranslationUnitDecl());
+  Record->addAttr(AnnotateAttr::CreateImplicit(Mutable, "safecpp.native.slice",
+                                               nullptr, 0));
+  Record->startDefinition();
+
+  auto AddField = [&](StringRef FieldName, QualType FieldType,
+                      StringRef Marker) {
+    FieldDecl *Field = FieldDecl::Create(
+        *this, Record, SourceLocation(), SourceLocation(),
+        &Idents.get(FieldName), FieldType,
+        getTrivialTypeSourceInfo(FieldType, SourceLocation()), nullptr,
+        /*Mutable=*/false, ICIS_NoInit);
+    Field->setImplicit();
+    // The compiler's own lowering reads these fields from outside the record,
+    // so they are public: the record is generated, not written.
+    Field->setAccess(AS_public);
+    Field->addAttr(AnnotateAttr::CreateImplicit(Mutable, Marker, nullptr, 0));
+    Record->addDecl(Field);
+  };
+  AddField("__circle_data", getPointerType(Canonical), "safecpp.native.slice.data");
+  AddField("__circle_len", getSizeType(), "safecpp.native.slice.len");
+  Record->completeDefinition();
+
+  QualType Slice = getCanonicalTagType(Record);
+  CircleSliceTypes[Element] = Slice;
+  // The element's spelling is not its type: a typedef and the type it names are
+  // the same element, so both spellings map to the one record. Otherwise a
+  // slice built from one spelling would not be the same slice as one built from
+  // the other, and no conversion between them would be possible.
+  CircleSliceTypes[Element.getCanonicalType()] = Slice;
+  return Slice;
+}
+
+/// Whether a type is itself the generated record a slice borrow names. A
+/// borrow of a *borrow* is a borrow of the handle's storage, which is an
+/// ordinary place, so unlike `circleSliceElement` this reads the record
+/// directly instead of looking through a borrow.
+bool ASTContext::isCircleSliceRecord(QualType T) const {
+  if (T.isNull())
+    return false;
+  T = T.getNonReferenceType().getUnqualifiedType();
+  if (T->getAs<NativeSliceType>())
+    return true;
+  auto *Record = T->getAsCXXRecordDecl();
+  if (!Record)
+    return false;
+  for (const auto *A : Record->specific_attrs<AnnotateAttr>())
+    if (A->getAnnotation() == "safecpp.native.slice")
+      return true;
+  return false;
+}
+
+QualType ASTContext::circleSliceElement(QualType T) const {
+  if (T.isNull())
+    return QualType();
+  T = T.getNonReferenceType().getUnqualifiedType();
+  // A borrow of a slice names the generated record, so the element is read
+  // through the borrow exactly as it is through the record itself.
+  if (const auto *Borrow = T->getAs<BorrowValueType>())
+    T = Borrow->getPointeeType().getUnqualifiedType();
+  auto *Record = T->getAsCXXRecordDecl();
+  if (!Record)
+    return QualType();
+  bool Slice = false;
+  for (const auto *A : Record->specific_attrs<AnnotateAttr>())
+    Slice |= A->isImplicit() && A->getAnnotation() == "safecpp.native.slice";
+  if (!Slice)
+    return QualType();
+  for (FieldDecl *Field : Record->fields())
+    for (const auto *A : Field->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == "safecpp.native.slice.data")
+        return Field->getType()->getPointeeType();
+  return QualType();
+}
+
+bool ASTContext::circleBorrowIsShared(const BorrowValueType *Borrow) const {
+  QualType Pointee = Borrow->getPointeeType();
+  if (Pointee.isConstQualified())
+    return true;
+  // A borrow of the generated record is shared when the record's element is
+  // const, since that is where a slice's mutability lives. A borrow of a
+  // *borrow* borrows the handle's storage, which is an ordinary object, so its
+  // own qualifiers are what decide.
+  if (const auto *Slice = Pointee->getAs<NativeSliceType>())
+    return Slice->getElementType().isConstQualified();
+  if (!isCircleSliceRecord(Pointee))
+    return false;
+  QualType Element = circleSliceElement(Pointee);
+  return !Element.isNull() && Element.isConstQualified();
+}
+
+FieldDecl *ASTContext::circleSliceField(QualType T, bool Count) const {
+  if (T.isNull())
+    return nullptr;
+  T = T.getNonReferenceType().getUnqualifiedType();
+  if (const auto *Borrow = T->getAs<BorrowValueType>())
+    T = Borrow->getPointeeType().getUnqualifiedType();
+  auto *Record = T->getAsCXXRecordDecl();
+  if (!Record || !Record->hasDefinition())
+    return nullptr;
+  StringRef Marker =
+      Count ? "safecpp.native.slice.len" : "safecpp.native.slice.data";
+  for (FieldDecl *Field : Record->getDefinition()->fields())
+    for (const auto *A : Field->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == Marker)
+        return Field;
+  return nullptr;
+}
+
+QualType ASTContext::getNativeSliceType(QualType Element) const {
+  llvm::FoldingSetNodeID ID;
+  NativeSliceType::Profile(ID, Element);
+  void *InsertPos = nullptr;
+  if (auto *Existing = NativeSliceTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(Existing, 0);
+  QualType Canonical;
+  if (!Element.isCanonical()) {
+    Canonical = getNativeSliceType(getCanonicalType(Element));
+    NativeSliceTypes.FindNodeOrInsertPos(ID, InsertPos);
+  }
+  auto *New = new (*this, alignof(NativeSliceType)) NativeSliceType(Element, Canonical);
+  Types.push_back(New);
+  NativeSliceTypes.InsertNode(New, InsertPos);
   return QualType(New, 0);
 }
 
