+ExprResult Parser::ParseCircleMatchExpression() {
+  SourceLocation Loc = ConsumeToken();  // 'match'
+  BalancedDelimiterTracker Tracker(*this, tok::l_paren);
+  Tracker.consumeOpen();
+  ExprResult Operand = ParseExpression();
+  if (Tracker.consumeClose())
+    return ExprError();
+  Actions.ActOnStartCircleMatch(Loc, Operand);
+  if (Operand.isInvalid()) {
+    Actions.ActOnCircleMatchFinish(Loc, nullptr);
+    return ExprError();
+  }
+
+  ParsedType ResultTy;
+  if (TryConsumeToken(tok::arrow)) {
+    TypeResult Result = ParseTypeName();
+    if (Result.isInvalid()) {
+      Actions.ActOnCircleMatchFinish(Loc, nullptr);
+      return ExprError();
+    }
+    ResultTy = Result.get();
+  }
+
+  if (ExpectAndConsume(tok::l_brace)) {
+    SkipUntil(tok::r_brace, StopAtSemi);
+    Actions.ActOnCircleMatchFinish(Loc, nullptr);
+    return ExprError();
+  }
+
+  // The match result names the choice each `.alternative` arm constructs.
+  // Keep it as the expected type while parsing every arm body, including
+  // dependent result types whose template arguments must survive until the
+  // enclosing template is instantiated.
+  QualType MatchResultType = Actions.GetTypeFromParser(ResultTy);
+  CircleChoiceExpectationRAII ChoiceExpectation(*this);
+
+  bool AnyError = false;
+  while (Tok.isNot(tok::r_brace) && Tok.isNot(tok::eof)) {
+    // A pattern's binding is visible to its own arm only.
+    ParseScope ArmScope(this, Scope::DeclScope);
+    SourceLocation ArmLoc = Tok.getLocation();
+    std::unique_ptr<Sema::CirclePattern> Pattern = ParseCircleMatchPattern();
+    if (!Pattern) {
+      AnyError = true;
+      break;
+    }
+    if (Actions.ActOnCircleMatchArm(ArmLoc, std::move(Pattern))) {
+      AnyError = true;
+      break;
+    }
+    if (TryConsumeToken(tok::kw_if)) {
+      ExprResult Guard = ParseConditionalExpression();
+      Actions.ActOnCircleMatchArmGuard(Guard);
+      if (Guard.isInvalid()) {
+        AnyError = true;
+        break;
+      }
+    }
+    // `=>` is spelled as '=' followed by '>'.
+    if (!TryConsumeToken(tok::equal) || ExpectAndConsume(tok::greater)) {
+      AnyError = true;
+      break;
+    }
+    if (!MatchResultType.isNull())
+      enterCircleChoiceExpectationAt(Tok.getLocation(), MatchResultType);
+    ExprResult Body = ParseAssignmentExpression();
+    Actions.ActOnCircleMatchArmBody(Body);
+    if (Body.isInvalid())
+      AnyError = true;
+    if (!TryConsumeToken(tok::semi))
+      break;
+  }
+  if (ExpectAndConsume(tok::r_brace))
+    AnyError = true;
+
+  ExprResult Result = Actions.ActOnCircleMatchFinish(Loc, ResultTy);
+  if (AnyError || Result.isInvalid())
+    return ExprError();
+  return Result;
+}
