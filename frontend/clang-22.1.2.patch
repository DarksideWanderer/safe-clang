+struct CircleImplCandidate {
+  CXXRecordDecl *Pattern;
+  ClassTemplateDecl *Template;
+  QualType Self, Interface, Instance;
+};
+void collectCircleImpls(DeclContext *DC, SmallVectorImpl<CircleImplCandidate> &Out,
+                       llvm::SmallPtrSetImpl<const Decl *> &Seen) {
+  for (auto *D : DC->decls()) {
+    if (auto *Export = dyn_cast<ExportDecl>(D)) {
+      collectCircleImpls(Export, Out, Seen);
+      continue;
+    }
+    if (auto *NS = dyn_cast<NamespaceDecl>(D)) {
+      collectCircleImpls(NS, Out, Seen);
+      continue;
+    }
+    auto *Template = dyn_cast<ClassTemplateDecl>(D);
+    auto *R = Template ? Template->getTemplatedDecl() : dyn_cast<CXXRecordDecl>(D);
+    if (!R || isa<ClassTemplateSpecializationDecl>(R) ||
+        (!Template && R->isDependentContext()) || !R->isCompleteDefinition() ||
+        !circleMemberMarker(R, "safecpp.native.impl") ||
+        !Seen.insert(R->getCanonicalDecl()).second) continue;
+    QualType Self, Interface;
+    for (auto *Member : R->decls())
+      if (auto *A = dyn_cast<TypeAliasDecl>(Member)) {
+        if (circleMemberMarker(A, "safecpp.native.impl.self")) Self = A->getUnderlyingType();
+        if (circleMemberMarker(A, "safecpp.native.impl.interface")) Interface = A->getUnderlyingType();
+      }
+    if (!Self.isNull() && !Interface.isNull())
+      Out.push_back({R, Template, Self, Interface, {}});
+  }
+}
+CircleImplCandidate *moreSpecializedCircleImpl(Sema &S, CircleImplCandidate &A,
+                                              CircleImplCandidate &B,
+                                              SourceLocation Loc) {
+  if (!A.Template || !B.Template)
+    return A.Template ? &B : B.Template ? &A : nullptr;
+  auto &C = S.Context;
+  auto *DC = C.getTranslationUnitDecl();
+  // The specification defines ordering as partial specializations of a single
+  // (target, interface) primary. These unregistered query declarations let the
+  // existing Clang ordering and constraint-subsumption engine compare that
+  // exact pair; they never become user types, emitted symbols or PCM entities.
+  auto *Name = &C.Idents.get("__circle_impl_order_query");
+  auto *Record = CXXRecordDecl::Create(C, A.Pattern->getTagKind(), DC, Loc, Loc, Name);
+  SmallVector<NamedDecl *, 2> Params;
+  for (unsigned I = 0; I != 2; ++I)
+    Params.push_back(TemplateTypeParmDecl::Create(C, DC, Loc, Loc, 0, I, nullptr, true, false));
+  auto *List = TemplateParameterList::Create(C, Loc, Loc, Params, Loc, nullptr);
+  auto *Primary = ClassTemplateDecl::Create(C, DC, Loc, Name, List, Record);
+  Record->setDescribedClassTemplate(Primary);
+  auto MakePartial = [&](CircleImplCandidate &Candidate) {
+    SmallVector<TemplateArgument, 2> Args{TemplateArgument(C.getCanonicalType(Candidate.Self)),
+                                        TemplateArgument(C.getCanonicalType(Candidate.Interface))};
+    auto Injected = C.getCanonicalType(C.getCanonicalTemplateSpecializationType(
+        ElaboratedTypeKeyword::None, TemplateName(Primary), Args));
+    return ClassTemplatePartialSpecializationDecl::Create(C, Candidate.Pattern->getTagKind(),
+        DC, Loc, Loc, Candidate.Template->getTemplateParameters(), Primary, Args, Injected, nullptr);
+  };
+  auto *PA = MakePartial(A), *PB = MakePartial(B);
+  auto *Winner = S.getMoreSpecializedPartialSpecialization(PA, PB, Loc);
+  return Winner == PA ? &A : Winner == PB ? &B : nullptr;
 }
+CXXRecordDecl *circleMemberImpl(Sema &S, DeclContext *DC,
+                               QualType Target, QualType Contract,
+                               SourceLocation Loc) {
+  ASTContext &C = S.Context;
+  SmallVector<CircleImplCandidate, 8> Patterns, Candidates;
+  llvm::SmallPtrSet<const Decl *, 16> Seen;
+  collectCircleImpls(DC, Patterns, Seen);
+  for (auto Candidate : Patterns) {
+    auto *Template = Candidate.Template;
+    if (!Template) {
+      if (C.hasSameUnqualifiedType(Candidate.Self, Target) &&
+          C.hasSameType(Candidate.Interface, Contract)) {
+        Candidate.Instance = C.getCanonicalTagType(Candidate.Pattern);
+        Candidates.push_back(Candidate);
+      }
+      continue;
+    }
+    SmallVector<TemplateArgument, 2> Ps{TemplateArgument(Candidate.Self), TemplateArgument(Candidate.Interface)};
+    SmallVector<TemplateArgument, 2> As{TemplateArgument(Target.getUnqualifiedType()), TemplateArgument(Contract)};
+    SmallVector<DeducedTemplateArgument, 8> Deduced(Template->getTemplateParameters()->size());
+    TemplateDeductionInfo Info(Loc);
+    if (S.DeduceTemplateArguments(Template->getTemplateParameters(), Ps,
+            As, Info, Deduced, true) != TemplateDeductionResult::Success)
+      continue;
+    TemplateArgumentListInfo Args(Loc, Loc);
+    bool Missing = false;
+    unsigned Count = Deduced.size();
+    while (Count && Deduced[Count - 1].isNull()) --Count;
+    for (unsigned Index = 0; Index < Count; ++Index) {
+      const auto &Arg = Deduced[Index];
+      if (Arg.isNull()) { Missing = true; break; }
+      Args.addArgument(S.getTrivialTemplateArgumentLoc(Arg, {}, Loc));
+    }
+    if (Missing) continue;
+    {
+      Sema::SFINAETrap Trap(S);
+      Candidate.Instance = S.CheckTemplateIdType(ElaboratedTypeKeyword::None,
+          TemplateName(Template), Loc, Args, nullptr, false);
+      if (Trap.hasErrorOccurred()) continue;
+    }
+    if (!Candidate.Instance.isNull()) Candidates.push_back(Candidate);
+  }
+  if (Candidates.empty()) return nullptr;
+  auto *Best = &Candidates.front();
+  for (auto &Candidate : llvm::drop_begin(Candidates))
+    if (auto *Winner = moreSpecializedCircleImpl(S, *Best, Candidate, Loc)) Best = Winner;
+  // A candidate must dominate every other candidate. This avoids selecting a
+  // winner merely because it appeared first or was in a particular namespace.
+  for (auto &Candidate : Candidates)
+    if (&Candidate != Best && moreSpecializedCircleImpl(S, *Best, Candidate, Loc) != Best) {
+      S.Diag(Loc, S.getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+          "Circle impl selection is ambiguous"));
+      return nullptr;
+    }
+  // Instantiate and validate only the selected implementation; a losing
+  // generic body must not cause substitution errors in an explicit override.
+  if (S.RequireCompleteType(Loc, Best->Instance, diag::err_incomplete_type)) return nullptr;
+  auto *R = Best->Instance->getAsCXXRecordDecl();
+  return R && !R->isInvalidDecl() ? R : nullptr;
+}
 
