+/// A native slice type, seen through a borrow or a reference to one.
+static const NativeSliceType *circleSliceType(QualType T) {
+  T = T.getNonReferenceType();
+  if (const auto *Borrow = T->getAs<BorrowValueType>())
+    T = Borrow->getPointeeType();
+  return T->getAs<NativeSliceType>();
+}
+
+/// Whether the slice addressed by an operand addresses const elements.
+static bool circleSliceIsConst(QualType T) {
+  T = T.getNonReferenceType();
+  if (const auto *Borrow = T->getAs<BorrowValueType>())
+    T = Borrow->getPointeeType();
+  if (const auto *Slice = T->getAs<NativeSliceType>())
+    return Slice->getElementType().isConstQualified();
+  return T.isConstQualified();
+}
