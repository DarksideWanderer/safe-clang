+  // Every relocation is noexcept, including a legacy move/copy fallback.
+  EHStack.pushTerminate();
+  emitCircleRelocationValue(*this, Query, E->getType(),
+      MakeAddrLValue(Slot.getAddress(), E->getType()), Source, E->getOperatorLoc());
+  EHStack.popTerminate();
