+/// `__rel_read(T*)` relocates the value out of an owning place. It lowers to
+/// the relocation operator, which carries the checked object model's code
+/// generation.
+static ExprResult CircleRelRead(Sema &S, CallExpr *TheCall) {
+  if (S.checkArgCount(TheCall, 1))
+    return ExprError();
+  if (TheCall->getArg(0)->containsErrors())
+    return ExprError();
+  QualType P = TheCall->getArg(0)->getType().getNonReferenceType();
+  if (!P->isPointerType()) {
+    S.Diag(TheCall->getBeginLoc(), S.getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error,
+        "native relocation read requires a pointer to an owning place"));
+    return ExprError();
+  }
+  ExprResult Place = S.BuildUnaryOp(nullptr, TheCall->getExprLoc(), UO_Deref,
+                                    TheCall->getArg(0));
+  if (Place.isInvalid())
+    return ExprError();
+  QualType Value = P->getPointeeType().getNonReferenceType();
+  return UnaryOperator::Create(S.Context, Place.get(), UO_Relocate, Value,
+                               VK_PRValue, OK_Ordinary, TheCall->getExprLoc(),
+                               /*CanOverflow=*/false, FPOptionsOverride());
+}
