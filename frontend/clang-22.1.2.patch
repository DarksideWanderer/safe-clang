+  if (T->getAs<BorrowValueType>()) return true;
+  auto *Ref = T->getAs<ReferenceType>();
+  return Ref && Ref->isSafetyBorrow();
+}
+
+static SmallVector<unsigned, 8>
+inferNativeBorrowBindings(const FunctionProtoType *Proto,
+                         const FunctionProtoType::ExtProtoInfo &EPI) {
+  bool Result = isNativeBorrowType(Proto->getReturnType());
+  auto Sources = FunctionProtoType::decodeReturnBorrow(EPI.ReturnBorrow, EPI.ReturnBorrowSources);
+  if (!Result || Sources.empty()) return {};
+  for (unsigned I : Sources) {
+    if (I >= Proto->getNumParams()) return {};
+    if (!isNativeBorrowType(Proto->getParamType(I))) return {};
+  }
+  SmallVector<unsigned, 8> Bindings(Proto->getNumParams() + 1, 0);
+  unsigned Next = 1, ResultID = 0;
+  for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
+    if (!isNativeBorrowType(Proto->getParamType(I))) continue;
+    if (llvm::is_contained(Sources, I)) {
+      if (!ResultID) ResultID = Next++;
+      Bindings[I + 1] = ResultID;
+    } else Bindings[I + 1] = Next++;
+  }
+  Bindings[0] = ResultID;
+  return Bindings;
+}
+
+static TypeSourceInfo *normalizeNativeFunctionLifetimes(Sema &S, Declarator &D,
+                                               TypeSourceInfo *Info) {
+  if (!Info) return Info;
+  auto Error = [&](StringRef Message) {
+    S.Diag(D.getIdentifierLoc(), S.getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error, "%0")) << Message;
+    D.setInvalidType();
+  };
+  const DeclaratorChunk::FunctionTypeInfo *NativeFTI = nullptr;
+  for (auto &Chunk : D.type_objects())
+    if (Chunk.Kind == DeclaratorChunk::Function) { NativeFTI = &Chunk.Fun; break; }
+  auto *Proto = Info->getType()->getAs<FunctionProtoType>();
+  if (Proto && !D.NativeLifetimeParameters.empty()) {
+    // Contract normalization inspects a bound class's carried fields. Resolve
+    // concrete specializations first: otherwise the same declaration gains a
+    // different binding merely because an unrelated sizeof instantiated the
+    // class. Dependent patterns and classes currently being defined keep their
+    // existing deferred treatment; no primary-template layout is guessed.
+    auto CompleteBoundClass = [&](QualType Type) {
+      if (const auto *Pack = Type->getAs<PackExpansionType>())
+        Type = Pack->getPattern();
+      if (const auto *Borrow = Type->getAs<BorrowValueType>())
+        Type = Borrow->getPointeeType();
+      if (const auto *Binding = circleClassLifetimeBinding(Type)) {
+        QualType Wrapped = Binding->getWrappedType();
+        if (!Wrapped->isDependentType())
+          if (auto *Spec = dyn_cast_or_null<ClassTemplateSpecializationDecl>(
+                  Wrapped->getAsCXXRecordDecl()))
+            if (!Spec->isBeingDefined())
+              S.isCompleteType(D.getIdentifierLoc(), Wrapped);
+      }
+    };
+    CompleteBoundClass(Proto->getReturnType());
+    for (QualType Parameter : Proto->getParamTypes()) CompleteBoundClass(Parameter);
+  }
+  if (Proto && circleClassHasStaticArguments(Proto->getReturnType())) {
+    auto EPI = Proto->getExtProtoInfo();
+    EPI.ReturnBorrow = 0x40000000u;
+    EPI.ReturnBorrowSources = {};
+    auto Type = S.Context.getFunctionType(Proto->getReturnType(), Proto->getParamTypes(), EPI);
+    auto *Adjusted = S.Context.CreateTypeSourceInfo(Type);
+    if (Adjusted->getTypeLoc().getFullDataSize() == Info->getTypeLoc().getFullDataSize())
+      memcpy(Adjusted->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getFullDataSize());
+    Info = Adjusted;
+    Proto = Type->getAs<FunctionProtoType>();
+  }
+  if (Proto && D.NativeLifetimeParameters.empty()) {
+    SmallVector<unsigned, 12> Projections(Proto->getClassLifetimeBindings());
+    SmallVector<FunctionProtoType::ExtParameterInfo, 8> Parameters;
+    bool Changed = false;
+    for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
+      QualType ParameterType = Proto->getParamType(I);
+      auto Parameter = Proto->getExtParameterInfo(I);
+      if (circleClassHasStaticArguments(ParameterType)) {
+        Changed |= !Parameter.hasStaticTypeLifetimes();
+        Parameter = Parameter.withStaticLifetime(true);
+      }
+      Parameters.push_back(Parameter);
+      if (const auto *Borrow = ParameterType->getAs<BorrowValueType>())
+        ParameterType = Borrow->getPointeeType();
+      if (const auto *Class = circleClassLifetimeBinding(ParameterType)) {
+        unsigned Region = 0;
+        for (const auto *Argument : Class->getArguments()) {
+          ++Region;
+          if (!Argument || !Argument->isStr("static")) continue;
+          bool Present = false;
+          for (unsigned J = 0; J + 2 < Projections.size(); J += 3)
+            Present |= Projections[J] == I + 1 && Projections[J + 1] == Region;
+          if (!Present) {
+            Projections.append({I + 1, Region, 0x40000000u});
+            Changed = true;
+          }
+        }
+      }
+    }
+    if (Changed) {
+      auto EPI = Proto->getExtProtoInfo();
+      EPI.ClassLifetimeBindings = Projections;
+      EPI.ExtParameterInfos = Parameters.empty() ? nullptr : Parameters.data();
+      auto Type = S.Context.getFunctionType(Proto->getReturnType(), Proto->getParamTypes(), EPI);
+      auto *Adjusted = S.Context.CreateTypeSourceInfo(Type);
+      if (Adjusted->getTypeLoc().getFullDataSize() == Info->getTypeLoc().getFullDataSize())
+        memcpy(Adjusted->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getFullDataSize());
+      Info = Adjusted;
+      Proto = Type->getAs<FunctionProtoType>();
+    }
+  }
+  if (Proto && NativeFTI != nullptr) {
+    auto &FTI = *NativeFTI;
+    SmallVector<FunctionProtoType::ExtParameterInfo, 8> Parameters;
+    bool StaticParameter = false;
+    // A user-defined string literal receives a pointer to the literal object,
+    // whose storage duration is static ([lex.string]). Preserve that as a
+    // checked parameter contract: literal syntax supplies a permanent origin,
+    // while an explicit call with local storage is rejected like any other
+    // use of a static lifetime parameter.
+    bool StaticStringLiteral =
+        D.getName().getKind() == UnqualifiedIdKind::IK_LiteralOperatorId &&
+        Proto->getReturnBorrow() == 0x40000000u && Proto->getNumParams() == 2 &&
+        Proto->getParamType(0)->isPointerType();
+    for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
+      auto Parameter = Proto->getExtParameterInfo(I);
+      if (StaticStringLiteral && I == 0) {
+        Parameter = Parameter.withStaticLifetime();
+        StaticParameter = true;
+      }
+      if (circleClassHasStaticArguments(Proto->getParamType(I))) {
+        Parameter = Parameter.withStaticLifetime(true);
+        StaticParameter = true;
+      }
+      if (auto *P = dyn_cast_or_null<ParmVarDecl>(FTI.Params[I].Param))
+        for (auto *A : P->specific_attrs<AnnotateAttr>())
+          if (A->isImplicit() && A->getAnnotation() == "safecpp.native.lifetime:static") {
+            if (!isNativeBorrowType(Proto->getParamType(I))) {
+              Error("module-safety: static lifetime parameter requires a native borrow");
+              return Info;
+            }
+            Parameter = Parameter.withStaticLifetime();
+            StaticParameter = true;
+          }
+      if (D.NativeLifetimeParameters.empty())
+        if (auto *Record = dyn_cast<CXXRecordDecl>(S.CurContext))
+          if (auto *P = dyn_cast_or_null<ParmVarDecl>(FTI.Params[I].Param))
+            for (auto *A : P->specific_attrs<AnnotateAttr>()) {
+              auto Text = A->getAnnotation();
+              if (A->isImplicit() && Text.consume_front("safecpp.native.lifetime:") &&
+                  circleClassRegionIsStatic(Record, circleClassLifetimeIndex(Record, Text))) {
+                Parameter = Parameter.withStaticLifetime();
+                StaticParameter = true;
+              }
+            }
+      Parameters.push_back(Parameter);
+    }
+    if (StaticParameter) {
+      auto EPI = Proto->getExtProtoInfo();
+      EPI.ExtParameterInfos = Parameters.data();
+      auto Type = S.Context.getFunctionType(Proto->getReturnType(), Proto->getParamTypes(), EPI);
+      auto *Adjusted = S.Context.CreateTypeSourceInfo(Type);
+      if (Adjusted->getTypeLoc().getFullDataSize() == Info->getTypeLoc().getFullDataSize())
+        memcpy(Adjusted->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getFullDataSize());
+      Info = Adjusted;
+      Proto = Type->getAs<FunctionProtoType>();
+    }
+  }
+  if (!D.NativeStaticLifetimeConstraints.empty()) {
+    if (!Proto) {
+      Error("module-safety: lifetime kind constraint requires a function type");
+      return Info;
+    }
+    SmallVector<FunctionProtoType::ExtParameterInfo, 8> ParamInfo;
+    for (unsigned I = 0; I < Proto->getNumParams(); ++I)
+      ParamInfo.push_back(Proto->getExtParameterInfo(I));
+    auto &FTI = *NativeFTI;
+    for (auto [Name, Pack] : D.NativeStaticLifetimeConstraints) {
+      LookupResult Lookup(S, Name, D.getIdentifierLoc(), Sema::LookupOrdinaryName);
+      S.LookupName(Lookup, S.getCurScope());
+      auto *TypeParameter = Lookup.isSingleResult()
+          ? dyn_cast<TemplateTypeParmDecl>(Lookup.getFoundDecl()) : nullptr;
+      if (TypeParameter && Pack != TypeParameter->isParameterPack()) {
+        Error("module-safety: static kind pack constraint must match its type parameter");
+        return Info;
+      }
+      bool Found = false;
+      if (TypeParameter)
+        if (auto *Record = dyn_cast<CXXRecordDecl>(S.CurContext))
+          if (auto *Template = Record->getDescribedClassTemplate())
+            for (auto *Parameter : *Template->getTemplateParameters())
+              if (Parameter == TypeParameter) {
+                Error("module-safety: static kind type projection is not yet modeled for a class receiver");
+                return Info;
+              }
+      for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
+        if (TypeParameter) {
+          QualType Param = Proto->getParamType(I);
+          if (auto *Expansion = Param->getAs<PackExpansionType>())
+            Param = Expansion->getPattern();
+          auto *Type = Param->getAs<TemplateTypeParmType>();
+          if (Type && Type->getDecl() == TypeParameter) {
+            ParamInfo[I] = ParamInfo[I].withStaticLifetime(true);
+            Found = true;
+          } else {
+            class MentionsParameter : public RecursiveASTVisitor<MentionsParameter> {
+            public:
+              const TemplateTypeParmDecl *Parameter;
+              bool Found = false;
+              explicit MentionsParameter(const TemplateTypeParmDecl *P) : Parameter(P) {}
+              bool shouldWalkTypesOfTypeLocs() const { return true; }
+              bool VisitTemplateTypeParmType(TemplateTypeParmType *T) {
+                Found |= T->getDepth() == Parameter->getDepth() &&
+                         T->getIndex() == Parameter->getIndex() &&
+                         T->isParameterPack() == Parameter->isParameterPack();
+                return true;
+              }
+            } Mentions(TypeParameter);
+            Mentions.TraverseType(Param);
+            if (Mentions.Found) {
+              Error("module-safety: static kind type projection is not yet modeled for this parameter");
+              return Info;
+            }
+          }
+        } else if (auto *P = dyn_cast_or_null<ParmVarDecl>(FTI.Params[I].Param)) {
+          for (auto *A : P->specific_attrs<AnnotateAttr>()) {
+            auto Text = A->getAnnotation();
+            if (Text.consume_front("safecpp.native.lifetime:") &&
+                Text == Name->getName()) {
+              ParamInfo[I] = ParamInfo[I].withStaticLifetime();
+              Found = true;
+            }
+          }
+        }
+      }
+      if (TypeParameter && !Found) {
+        Error("module-safety: static kind type projection is not yet modeled for this signature");
+        return Info;
+      }
+      if (!TypeParameter) {
+        Found |= circleSimpleClassValueRegion(Proto->getReturnType()) == Name;
+        if (Pack || (!Found && D.NativeLifetimeName != Name)) {
+          Error("module-safety: static kind constraint names an unbound lifetime");
+          return Info;
+        }
+        if (!llvm::is_contained(D.NativeLifetimeParameters, Name))
+          D.NativeLifetimeParameters.push_back(Name);
+      }
+    }
+    auto EPI = Proto->getExtProtoInfo();
+    EPI.ExtParameterInfos = ParamInfo.empty() ? nullptr : ParamInfo.data();
+    auto Type = S.Context.getFunctionType(Proto->getReturnType(),
+                                         Proto->getParamTypes(), EPI);
+    auto *Adjusted = S.Context.CreateTypeSourceInfo(Type);
+    if (Adjusted->getTypeLoc().getFullDataSize() ==
+        Info->getTypeLoc().getFullDataSize())
+      memcpy(Adjusted->getTypeLoc().getOpaqueData(),
+             Info->getTypeLoc().getOpaqueData(),
+             Info->getTypeLoc().getFullDataSize());
+    Info = Adjusted;
+    Proto = Type->getAs<FunctionProtoType>();
+  }
+  // Existing member signatures bind class regions through their receiver and
+  // constructor source contracts. A callable storage field instead captures
+  // the lexical class scope. Keep these two established representations
+  // distinct; treating a constructor parameter as a free callback capture
+  // would discard its class-source contract.
+  if (D.getContext() == DeclaratorContext::Member && D.isFunctionDeclarator())
+    if (auto *Record = dyn_cast<CXXRecordDecl>(S.CurContext);
+        Record && !D.NativeLifetimeOuterParameters.empty()) {
+      auto ClassNames = circleClassLifetimeNames(Record);
+      auto &Scope = D.NativeLifetimeOuterParameters.back();
+      bool Same = !ClassNames.empty() && ClassNames.size() == Scope.size();
+      for (unsigned I = 0; Same && I < Scope.size(); ++I)
+        Same &= ClassNames[I] == Scope[I]->getName();
+      if (Same) D.NativeLifetimeOuterParameters.pop_back();
+    }
+  bool UsesOuterLifetime = false;
+  if (Proto && NativeFTI && !D.NativeLifetimeOuterParameters.empty()) {
+    auto IsOuter = [&](StringRef Label) {
+      if (llvm::any_of(D.NativeLifetimeParameters, [&](auto *N) { return N->getName() == Label; })) return false;
+      for (const auto &Scope : D.NativeLifetimeOuterParameters)
+        for (auto *N : Scope) if (N->getName() == Label) return true;
+      return false;
+    };
+    UsesOuterLifetime = D.NativeLifetimeName && IsOuter(D.NativeLifetimeName->getName());
+    auto &FTI = *NativeFTI;
+    for (unsigned I = 0; I < Proto->getNumParams(); ++I)
+      if (auto *P = dyn_cast_or_null<ParmVarDecl>(FTI.Params[I].Param))
+        for (auto *A : P->specific_attrs<AnnotateAttr>()) {
+          auto Text = A->getAnnotation();
+          if (Text.consume_front("safecpp.native.lifetime:")) UsesOuterLifetime |= IsOuter(Text);
+        }
+    auto ClassUsesOuter = [&](QualType T) {
+      if (const auto *B = T->getAs<BorrowValueType>()) T = B->getPointeeType();
+      if (const auto *B = circleClassLifetimeBinding(T))
+        for (auto *N : B->getArguments())
+          if (N) UsesOuterLifetime |= IsOuter(N->getName());
+    };
+    ClassUsesOuter(Proto->getReturnType());
+    for (auto T : Proto->getParamTypes()) ClassUsesOuter(T);
+  }
+  if (D.NativeLifetimeParameters.empty() && !UsesOuterLifetime) {
+    if (D.NativeLifetimeName) {
+      // Static needs no binder, but a function's result must still carry
+      // the promise in its canonical type (including indirect calls/PCM).
+      if (D.NativeLifetimeName->isStr("static")) {
+        if (Proto) {
+          if (!isNativeBorrowType(Proto->getReturnType())) {
+            Error("module-safety: lifetime result qualifier requires a native borrow");
+            return Info;
+          }
+          auto EPI = Proto->getExtProtoInfo();
+          EPI.ReturnBorrow = 0x40000000u;
+          EPI.ReturnBorrowSources = {};
+          // Elision may already have inferred a result/input equality. An
+          // explicit static result replaces that equality; it does not make
+          // the otherwise unrestricted input static.
+          SmallVector<unsigned, 8> Bindings(EPI.LifetimeBindings);
+          if (!Bindings.empty()) Bindings[0] = 0;
+          EPI.LifetimeBindings = Bindings;
+          auto Type = S.Context.getFunctionType(Proto->getReturnType(),
+                                               Proto->getParamTypes(), EPI);
+          auto *Adjusted = S.Context.CreateTypeSourceInfo(Type);
+          if (Adjusted->getTypeLoc().getFullDataSize() ==
+              Info->getTypeLoc().getFullDataSize())
+            memcpy(Adjusted->getTypeLoc().getOpaqueData(),
+                   Info->getTypeLoc().getOpaqueData(),
+                   Info->getTypeLoc().getFullDataSize());
+          return Adjusted;
+        }
+        return Info;
+      }
+      // A name bound by the enclosing record's lifetime parameters is in scope
+      // for every member, including the return types of member functions.
+      if (auto *Record = dyn_cast<CXXRecordDecl>(S.CurContext))
+        for (const auto *A : Record->specific_attrs<AnnotateAttr>()) {
+          auto Names = A->getAnnotation();
+          if (!Names.consume_front("safecpp.native.class.lifetimes:")) continue;
+          SmallVector<StringRef, 4> Parameters;
+          Names.split(Parameters, ',');
+          if (llvm::is_contained(Parameters, D.NativeLifetimeName->getName())) {
+            if (!Proto) return Info;
+            if (!NativeFTI ||
+                !isNativeBorrowType(Proto->getReturnType())) {
+              Error("module-safety: class lifetime result requires a native borrow function result");
+              return Info;
+            }
+            auto &FTI = *NativeFTI;
+            std::optional<unsigned> Self;
+            for (unsigned I = 0; I < Proto->getNumParams(); ++I)
+              if (auto *P = dyn_cast_or_null<ParmVarDecl>(FTI.Params[I].Param);
+                  P && P->isExplicitObjectParameter()) {
+                const auto *Owner = circleClassRecord(Proto->getParamType(I));
+                if (Owner && Owner->getCanonicalDecl() == Record->getCanonicalDecl())
+                  Self = I;
+              }
+            if (!Self) {
+              Error("module-safety: class lifetime result requires an explicit self source");
+              return Info;
+            }
+            auto EPI = Proto->getExtProtoInfo();
+            unsigned Source = *Self;
+            FunctionProtoType::setReturnBorrowSources(EPI, {Source});
+            EPI.ReturnBorrowClassRegion = circleClassLifetimeIndex(
+                Record, D.NativeLifetimeName->getName());
+            if (circleClassRegionIsStatic(Record, EPI.ReturnBorrowClassRegion)) {
+              EPI.ReturnBorrowClassRegion = 0;
+              EPI.ReturnBorrow = 0x40000000u;
+              EPI.ReturnBorrowSources = {};
+            }
+            auto T = S.Context.getFunctionType(Proto->getReturnType(),
+                                               Proto->getParamTypes(), EPI);
+            auto *Adjusted = S.Context.CreateTypeSourceInfo(T);
+            if (Adjusted->getTypeLoc().getFullDataSize() == Info->getTypeLoc().getFullDataSize())
+              memcpy(Adjusted->getTypeLoc().getOpaqueData(), Info->getTypeLoc().getOpaqueData(),
+                     Info->getTypeLoc().getFullDataSize());
+            return Adjusted;
+          }
+        }
+      // A type that stands in for a declaration's result is bound by that
+      // declaration's own lifetime parameters, which the function type records
+      // once its declarator completes.
+      bool BoundByEnclosingDeclaration =
+          D.getContext() == DeclaratorContext::TrailingReturn ||
+          D.getContext() == DeclaratorContext::TrailingReturnVar ||
+          D.getContext() == DeclaratorContext::TypeName ||
+          D.getContext() == DeclaratorContext::TemplateArg ||
+          D.getContext() == DeclaratorContext::ConversionId;
+      if (!BoundByEnclosingDeclaration &&
+          (!D.isPrototypeContext() || !isNativeBorrowType(Info->getType())))
+        Error("module-safety: lifetime qualifier requires a native borrow in a bound function signature");
+    }
+    return Info;
+  }
+  if (!Proto) {
+    Error("module-safety: lifetime binder requires a function type");
+    return Info;
+  }
+  bool Mixed = false;
+  auto CheckAttrs = [&](const ParsedAttributesView &Attrs) {
+    for (auto &A : Attrs) Mixed |= A.getKind() == ParsedAttr::AT_ReturnsBorrow;
+  };
+  CheckAttrs(D.getAttributes()); CheckAttrs(D.getDeclSpec().getAttributes());
+  for (auto &Chunk : D.type_objects()) CheckAttrs(Chunk.getAttrs());
+  if (Mixed) {
+    Error("module-safety: native lifetime binding cannot mix returns_borrow attributes");
+    return Info;
+  }
+  std::map<StringRef, unsigned> Names;
+  for (auto *Name : D.NativeLifetimeParameters) {
+    if (!Names.emplace(Name->getName(), Names.size()).second) {
+      Error("module-safety: duplicate lifetime binder");
+      return Info;
+    }
+  }
+  std::map<unsigned, unsigned> Captures;
+  unsigned Distance = 0;
+  for (auto Scope = D.NativeLifetimeOuterParameters.rbegin();
+       Scope != D.NativeLifetimeOuterParameters.rend(); ++Scope) {
+    ++Distance;
+    if (Distance >= 8192 || Scope->size() >= 65536) {
+      Error("module-safety: lifetime scope exceeds representable binder space");
+      return Info;
+    }
+    for (unsigned I = 0; I < Scope->size(); ++I) {
+      auto [Entry, Added] = Names.emplace((*Scope)[I]->getName(), Names.size());
+      if (Added) Captures[Entry->second] = circleCapturedRegion(Distance, I + 1);
+    }
+  }
+  unsigned N = Names.size();
+  std::vector<std::set<unsigned>> Edges(N), Reach(N);
+  struct TypeOutlives {
+    const TemplateTypeParmDecl *Parameter;
+    unsigned Short;
+  };
+  SmallVector<TypeOutlives, 4> TypeOutlivesConstraints;
+  for (auto [Long, Short] : D.NativeLifetimeOutlives) {
+    auto L = Names.find(Long->getName()), R = Names.find(Short->getName());
+    if (R == Names.end()) {
+      Error("module-safety: outlives constraint names an unbound lifetime");
+      return Info;
+    }
+    if (L == Names.end()) {
+      // A where-clause may constrain a type parameter, for example
+      // `/(a, where T: a)`. Its lifetime arguments are substituted during
+      // specialization; model the parameter as the node carrying T's
+      // lifetimes and let the edge constrain that node at the call site.
+      LookupResult Lookup(S, Long, D.getIdentifierLoc(),
+                          Sema::LookupOrdinaryName);
+      S.LookupName(Lookup, S.getCurScope());
+      auto *TypeParameter = Lookup.isSingleResult()
+          ? dyn_cast<TemplateTypeParmDecl>(Lookup.getFoundDecl()) : nullptr;
+      if (!TypeParameter) {
+        Error("module-safety: outlives constraint names an unbound lifetime");
+        return Info;
+      }
+      TypeOutlivesConstraints.push_back({TypeParameter, R->second});
+      continue;
+    }
+    Edges[L->second].insert(R->second);
+  }
+  std::map<unsigned, unsigned> TypeParameterNodes;
+  for (const auto &Constraint : TypeOutlivesConstraints) {
+    bool Found = false;
+    for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
+      QualType Param = Proto->getParamType(I);
+      if (auto *Expansion = Param->getAs<PackExpansionType>())
+        Param = Expansion->getPattern();
+      class MentionsParameter : public RecursiveASTVisitor<MentionsParameter> {
+      public:
+        const TemplateTypeParmDecl *Parameter;
+        bool Found = false;
+        explicit MentionsParameter(const TemplateTypeParmDecl *P) : Parameter(P) {}
+        bool shouldWalkTypesOfTypeLocs() const { return true; }
+        bool VisitTemplateTypeParmType(TemplateTypeParmType *T) {
+          Found |= T->getDecl() == Parameter;
+          return true;
+        }
+      } Mentions(Constraint.Parameter);
+      Mentions.TraverseType(Param);
+      if (!Mentions.Found)
+        continue;
+      auto [It, Inserted] = TypeParameterNodes.emplace(I, N);
+      if (Inserted) {
+        ++N;
+        Edges.emplace_back();
+        Reach.emplace_back();
+      }
+      Edges[It->second].insert(Constraint.Short);
+      Found = true;
+    }
+    if (!Found) {
+      Error("module-safety: type outlives constraint is not used by a "
+            "function parameter");
+      return Info;
+    }
+  }
+  // Compute the least transitive relation; cycles mean region equality.
+  for (unsigned I = 0; I < N; ++I) {
+    SmallVector<unsigned, 8> Pending{I};
+    while (!Pending.empty()) {
+      unsigned V = Pending.pop_back_val();
+      if (!Reach[I].insert(V).second) continue;
+      Pending.append(Edges[V].begin(), Edges[V].end());
+    }
+  }
+  std::vector<unsigned> Representative(N);
+  for (unsigned I = 0; I < N; ++I) {
+    Representative[I] = I;
+    for (unsigned J : Reach[I])
+      if (Reach[J].count(I) && !Captures.count(I) && !Captures.count(J))
+        Representative[I] = std::min(Representative[I], J);
+  }
+  std::vector<std::optional<unsigned>> ParameterNodes(Proto->getNumParams());
+  for (auto [I, Node] : TypeParameterNodes)
+    ParameterNodes[I] = Node;
+  auto Resolve = [&](StringRef Label) -> std::optional<unsigned> {
+    auto I = Names.find(Label);
+    if (I == Names.end()) {
+      Error("module-safety: borrow qualifier names an unbound lifetime");
+      return std::nullopt;
+    }
+    return I->second;
+  };
+  auto &FTI = *NativeFTI;
+  for (unsigned I = 0; I < Proto->getNumParams(); ++I) {
