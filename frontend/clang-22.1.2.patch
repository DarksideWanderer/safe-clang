+void StmtPrinter::VisitCircleMatchExpr(CircleMatchExpr *Node) {
+  OS << "match(";
+  PrintExpr(Node->getOperand());
   OS << ")";
+  if (!Node->getResultType().isNull()) {
+    OS << " -> ";
+    Node->getResultType().print(OS, Policy);
+  }
+  auto Patterns = Node->patterns();
+  std::function<void(unsigned)> PrintPattern = [&](unsigned I) {
+    const auto &P = Patterns[I];
+    switch (P.Kind) {
+    case 0: // alternative
+      OS << '.' << P.Name->getName();
+      if (P.BindingName || P.Payload != ~0u) {
+        OS << '(';
+        if (P.BindingName) {
+          if (P.Borrow) OS << '^';
+          OS << P.BindingName->getName();
+        } else
+          PrintPattern(P.Payload);
+        OS << ')';
+      }
+      break;
+    case 1: OS << '_'; break;
+    case 2: OS << (P.BoolValue ? "true" : "false"); break;
+    case 3: PrintExpr(P.Low); break;
+    case 4: PrintExpr(P.Low); OS << " ... "; PrintExpr(P.High); break;
+    case 5:
+      for (unsigned J = P.FirstAlternative; J != ~0u;
+           J = Patterns[J].NextAlternative) {
+        if (J != P.FirstAlternative) OS << " | ";
+        PrintPattern(J);
+      }
+      break;
+    case 6:
+      OS << '[';
+      for (unsigned J = P.FirstAlternative; J != ~0u;
+           J = Patterns[J].NextAlternative) {
+        if (J != P.FirstAlternative) OS << ", ";
+        PrintPattern(J);
+      }
+      OS << ']';
+      break;
+    case 7:
+      if (P.Borrow) OS << '^';
+      OS << P.BindingName->getName();
+      if (P.Payload != ~0u) { OS << " @ "; PrintPattern(P.Payload); }
+      break;
+    default: llvm_unreachable("invalid Circle pattern");
+    }
+  };
+  OS << " { ";
+  for (const auto &A : Node->arms()) {
+    PrintPattern(A.PatternIndex);
+    if (A.Guard) { OS << " if ("; PrintExpr(A.Guard); OS << ')'; }
+    OS << " => ";
+    PrintExpr(A.Body);
+    OS << "; ";
+  }
+  OS << '}';
 }
 
