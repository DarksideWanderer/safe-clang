+/// A thread contract written in the template's own terms —
+/// `[[unsafe::send(T~is_send)]]` — reaches an instantiation as the claim the
+/// pattern wrote, whose argument the substitution is what makes concrete. The
+/// claim is recorded again here with the property it names evaluated for the
+/// arguments this instantiation supplies, so the checked model reads a value
+/// rather than a pattern's parameter.
+void Sema::ActOnThreadContractInstantiation(CXXRecordDecl *Pattern,
+                                            CXXRecordDecl *Instantiation) {
+  if (!Pattern || !Instantiation || Instantiation->isInvalidDecl() ||
+      Instantiation->isDependentContext())
+    return;
+  auto *Spec = dyn_cast<ClassTemplateSpecializationDecl>(Instantiation);
+  if (!Spec || !Spec->hasDefinition())
+    return;
+  MultiLevelTemplateArgumentList TemplateArgs = getTemplateInstantiationArgs(Spec);
+  for (const auto *A : Pattern->specific_attrs<AnnotateAttr>()) {
+    bool Sync;
+    if (A->getAnnotation() == "safecpp.send")
+      Sync = false;
+    else if (A->getAnnotation() == "safecpp.sync")
+      Sync = true;
+    else
+      continue;
+    // An unconditional claim holds as it stands; only a claim the pattern
+    // wrote in terms of its parameters has something to resolve here.
+    if (A->args().empty())
+      continue;
+    bool Holds = true;
+    for (Expr *Arg : A->args()) {
+      ExprResult Substituted = SubstExpr(Arg, TemplateArgs);
+      if (Substituted.isInvalid()) {
+        Holds = false;
+        break;
+      }
+      bool Value = false;
+      if (Substituted.get()->isValueDependent() ||
+          !Substituted.get()->EvaluateAsBooleanCondition(Value, Context))
+        continue;                 // not known here: the claim stands
+      if (!Value) {
+        Holds = false;
+        break;
+      }
+    }
+    // The class declares a thread contract, so its storage is its own
+    // business; what this instantiation adds is whether the property the
+    // contract names holds for it.
+    Instantiation->addAttr(AnnotateAttr::CreateImplicit(
+        Context, A->getAnnotation(), nullptr, 0, A->getRange()));
+    Instantiation->addAttr(AnnotateAttr::CreateImplicit(
+        Context,
+        Holds ? (Sync ? "safecpp.thread.sync" : "safecpp.thread.send")
+              : (Sync ? "safecpp.unsync" : "safecpp.unsend"),
+        nullptr, 0, A->getRange()));
+  }
+}
