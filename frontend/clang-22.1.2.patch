+void Sema::ActOnCircleMatchArmBody(ExprResult Body) {
+  if (CircleMatches.empty())
+    return;
+  assert(!CircleMatches.back().Arms.empty() && "arm body without a pattern");
+  CircleMatches.back().Arms.back().Body =
+      Body.isInvalid() ? nullptr : Body.get();
+}
