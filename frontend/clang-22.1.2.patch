+/// A template match retains its patterns until the operand is instantiated.
+/// Concrete matches are checked and lowered by Sema; this node never reaches
+/// CodeGen. Indices form an arena-owned pattern tree, including nested and OR
+/// patterns, without owning heap allocations that would escape ASTContext.
+class CircleMatchExpr final : public Expr {
+public:
+  struct Pattern {
+    unsigned Kind = 0;
+    IdentifierInfo *Name = nullptr, *BindingName = nullptr;
+    VarDecl *Binding = nullptr;
+    unsigned Payload = ~0u, FirstAlternative = ~0u, NextAlternative = ~0u;
+    bool Borrow = false, BoolValue = false;
+    bool LowInclusive = false, HighInclusive = false;
+    Expr *Low = nullptr, *High = nullptr;
+    SourceLocation Loc;
+  };
+  struct Arm {
+    unsigned PatternIndex = ~0u;
+    Expr *Body = nullptr;
+    SourceLocation Loc;
+    Expr *Guard = nullptr;
+  };
+
+private:
+  SourceLocation Loc;
+  QualType ResultType;
+  unsigned NumPatterns, NumArms;
+  Pattern *Patterns;
+  Arm *Arms;
+  Stmt **Children;
+
+public:
+  CircleMatchExpr(const ASTContext &C, QualType T, unsigned NP, unsigned NA);
+  static CircleMatchExpr *CreateEmpty(const ASTContext &C, unsigned NP,
+                                      unsigned NA);
+  void initialize(const ASTContext &C, SourceLocation L, QualType Result,
+                  Expr *Operand);
+  ArrayRef<Pattern> patterns() const { return {Patterns, NumPatterns}; }
+  MutableArrayRef<Pattern> patterns() { return {Patterns, NumPatterns}; }
+  ArrayRef<Arm> arms() const { return {Arms, NumArms}; }
+  MutableArrayRef<Arm> arms() { return {Arms, NumArms}; }
+  Expr *getOperand() const { return cast<Expr>(Children[0]); }
+  QualType getResultType() const { return ResultType; }
+  SourceLocation getBeginLoc() const { return Loc; }
+  SourceLocation getEndLoc() const {
+    return NumArms == 0 ? Loc : Arms[NumArms - 1].Body->getEndLoc();
+  }
+  child_range children() { return child_range(Children, Children + 1 + NumPatterns * 2 + NumArms * 2); }
+  const_child_range children() const {
+    return const_child_range(Children, Children + 1 + NumPatterns * 2 + NumArms * 2);
+  }
+  static bool classof(const Stmt *S) {
+    return S->getStmtClass() == CircleMatchExprClass;
+  }
+};
