+// Native contextual syntax. Reuse serializable AST nodes so that safety
+// boundaries survive PCM emission and template instantiation.
+StmtResult Parser::ParseUnsafeStatement() {
+  SourceLocation Loc = ConsumeToken();
+  // Circle's unsafe-block is a compound statement that does not open a
+  // lexical scope: declarations inside it stay visible afterwards.
+  StmtResult Body = ParseCompoundStatementBody();
+  if (Body.isInvalid()) return StmtError();
+  auto &C = Actions.getASTContext();
+  auto *Value = new (C) CXXBoolLiteralExpr(true, C.BoolTy, Loc);
