+/// A `match` pattern: `.alternative` with an optional payload pattern or a
+/// binding, `_`/`default`, `true`/`false`, a value, a range of values
+/// (`lo...hi`), or several alternatives joined by `|`.
+std::unique_ptr<Sema::CirclePattern> Parser::ParseCircleMatchPattern() {
+  std::unique_ptr<Sema::CirclePattern> First = ParseCircleMatchPrimaryPattern();
+  if (!First)
+    return nullptr;
+  if (!Tok.is(tok::pipe))
+    return First;
+  auto Or = std::make_unique<Sema::CirclePattern>();
+  Or->K = Sema::CirclePattern::Or;
+  Or->Loc = First->Loc;
+  Or->Alternatives.push_back(std::move(First));
+  while (TryConsumeToken(tok::pipe)) {
+    std::unique_ptr<Sema::CirclePattern> Next = ParseCircleMatchPrimaryPattern();
+    if (!Next)
+      return nullptr;
+    Or->Alternatives.push_back(std::move(Next));
+  }
+  return Or;
+}
