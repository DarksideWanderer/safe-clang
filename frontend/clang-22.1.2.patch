+//===--- CircleRelocation.h - checked relocation policy ---------*- C++ -*-===//
+#ifndef LLVM_CLANG_AST_CIRCLERELOCATION_H
+#define LLVM_CLANG_AST_CIRCLERELOCATION_H
+#include "clang/AST/ASTContext.h"
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclCXX.h"
+#include "llvm/ADT/DenseMap.h"
+namespace clang {
+inline bool circleRelocationMarked(const Decl *D, llvm::StringRef Name) {
+  if (!D) return false;
+  for (const auto *A : D->specific_attrs<AnnotateAttr>())
+    if ((A->isImplicit() || isa<FieldDecl>(D)) && A->getAnnotation() == Name) return true;
+  return false;
+}
+inline CXXMethodDecl *circleRelocationOperator(QualType T) {
+  auto *R = T.getNonReferenceType()->getAsCXXRecordDecl();
+  if (!R || !R->hasDefinition()) return nullptr;
+  for (auto *M : R->getDefinition()->methods())
+    if (circleRelocationMarked(M, "safecpp.native.relocation")) return M;
+  return nullptr;
+}
+enum class CircleRelocationKind { Trivial, Memberwise, Choice, User, Move, Deleted };
+struct CircleRelocationPlan {
+  CircleRelocationKind Kind = CircleRelocationKind::Trivial;
+  CXXMethodDecl *Method = nullptr;
+};
+// One query owns its cache: completed type graphs may contain many repeated
+// fields, while incomplete/dependent definitions must not poison later queries.
+class CircleRelocationQuery {
+  ASTContext &C;
+  llvm::DenseMap<const Type *, CircleRelocationPlan> Cache;
+public:
+  explicit CircleRelocationQuery(ASTContext &C) : C(C) {}
+  CircleRelocationPlan get(QualType T) {
+    T = C.getCanonicalType(T);
+    if (auto I = Cache.find(T.getTypePtr()); I != Cache.end()) return I->second;
+    auto Result = compute(T);
+    Cache[T.getTypePtr()] = Result;
+    return Result;
+  }
+private:
+  CircleRelocationPlan compute(QualType T) {
+    using K = CircleRelocationKind;
+    if (const auto *A = C.getAsArrayType(T)) return get(A->getElementType());
+    auto *R = T->getAsCXXRecordDecl();
+    if (!R) return {};
+    if (!R->hasDefinition()) return {K::Deleted};
+    R = R->getDefinition();
+    CXXMethodDecl *Hook = nullptr;
+    for (auto *M : R->methods())
+      if (circleRelocationMarked(M, "safecpp.native.relocation")) {
+        if (Hook && Hook->getCanonicalDecl() != M->getCanonicalDecl())
+          return {K::Deleted};
+        Hook = M;
+      }
+    bool ConstructorDefault = false;
+    if (auto *D = Hook) {
+      if (D->isDeleted()) return {K::Deleted, D};
+      if (circleRelocationMarked(D, "safecpp.native.relocation.trivial")) return {};
+      if (!circleRelocationMarked(D, "safecpp.native.relocation.default")) return {K::User, D};
+      ConstructorDefault = circleRelocationMarked(D, "safecpp.native.relocation.constructor");
+    }
+    bool Nontrivial = false;
+    for (const auto &B : R->bases()) {
+      auto P = get(B.getType());
+      if (P.Kind == K::Deleted) return P;
+      Nontrivial |= P.Kind != K::Trivial;
+    }
+    bool Choice = circleRelocationMarked(R, "safecpp.native.choice");
+    for (auto *F : R->fields()) {
+      // Phantom members carry type/lifetime constraints without runtime storage.
+      if (circleRelocationMarked(F, "safecpp.native.phantom")) continue;
+      if (Choice && circleRelocationMarked(F, "safecpp.native.choice.payload")) {
+        auto *Storage = F->getType()->getAsRecordDecl();
+        for (auto *Payload : Storage->fields()) {
+          auto P = get(Payload->getType());
+          if (P.Kind == K::Deleted) return P;
+          Nontrivial |= P.Kind != K::Trivial;
+        }
+        continue;
+      }
+      auto P = get(F->getType());
+      if (P.Kind == K::Deleted) return P;
+      Nontrivial |= P.Kind != K::Trivial;
+    }
+    if (Choice) return {Nontrivial ? K::Choice : K::Trivial};
+    auto *Dtor = R->getDestructor();
+    bool SafeDrop = Dtor && !Dtor->isImplicit() &&
+        Dtor->getType()->castAs<FunctionProtoType>()->getExtInfo().getModuleSafe();
+    if (SafeDrop && !ConstructorDefault) return {};
+    // A union has no common active-member list. Its nontrivial relocation
+    // needs an explicit hook or a valid ordinary move/copy constructor.
+    bool ImplicitMemberwise = !R->hasUserDeclaredDestructor() &&
+                              !R->hasUserDeclaredMoveConstructor();
+    if (!R->isUnion() && (ImplicitMemberwise ||
+                          (!ConstructorDefault && R->isAggregate())))
+      return {Nontrivial ? K::Memberwise : K::Trivial};
+    if (R->isTriviallyCopyable()) return {};
+    CXXConstructorDecl *Copy = nullptr, *Move = nullptr;
+    for (auto *D : R->ctors()) {
+      if (D->isInvalidDecl() || D->isIneligibleOrNotSelected() || D->getNumParams() != 1) continue;
+      if (D->isMoveConstructor()) {
+        if (D->isDeleted() && D->isDefaulted()) continue;
+        if (!Move || !D->getParamDecl(0)->getType()->getPointeeType().isConstQualified()) Move = D;
+      } else if (D->isCopyConstructor() && !D->isDeleted()) Copy = D;
+    }
+    auto *Ctor = Move ? Move : Copy;
+    if (!Ctor || Ctor->isDeleted() || (Dtor && Dtor->isDeleted())) return {K::Deleted, Ctor};
+    return {K::Move, Ctor};
+  }
+};
+} // namespace clang
+#endif
