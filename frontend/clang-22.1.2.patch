+//===- CircleNiche.h - Native choice zero-niche representation ----*- C++ -*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_AST_CIRCLENICHE_H
+#define LLVM_CLANG_AST_CIRCLENICHE_H
+
+#include "clang/AST/Attr.h"
+#include "clang/AST/DeclCXX.h"
+#include "clang/AST/DeclTemplate.h"
+#include <iterator>
+#include <optional>
+
+namespace clang {
+struct CircleZeroNiche {
+  const FieldDecl *Tag;
+  const FieldDecl *Payload;
+  const FieldDecl *Pointer;
+  unsigned PayloadIndex;
+};
+
+inline bool hasTrustedCircleMarker(const CXXRecordDecl *R, llvm::StringRef Name) {
+  for (const auto *A : R->specific_attrs<AnnotateAttr>())
+    if (A->isImplicit() && A->getAnnotation() == Name)
+      return true;
+  // Instantiation recreates some attributes without their implicit flag. The
+  // template's compiler-owned marker remains the authority, never the text of
+  // a user-written annotate attribute on the specialization.
+  if (const auto *Pattern = R->getTemplateInstantiationPattern())
+    for (const auto *A : Pattern->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == Name)
+        return true;
+  return false;
+}
+
+/// The implemented zero niche has a single pointer as its physical value.
+/// Phantom fields carry type/lifetime information without occupying storage.
+/// This is the representation used by the official box<T> safety library.
+/// A general multi-field/byte-pattern niche is not inferred from padding.
+inline std::optional<CircleZeroNiche> getCircleZeroNiche(const RecordDecl *RD) {
+  const auto *R = dyn_cast_or_null<CXXRecordDecl>(RD ? RD->getDefinition() : nullptr);
+  if (!R || !R->isCompleteDefinition() || R->isDependentContext() ||
+      R->getNumBases() || R->isDynamicClass() ||
+      !hasTrustedCircleMarker(R, "safecpp.native.choice"))
+    return std::nullopt;
+  const FieldDecl *Tag = nullptr, *Payload = nullptr;
+  unsigned Fields = 0;
+  for (const FieldDecl *F : R->fields()) {
+    ++Fields;
+    for (const auto *A : F->specific_attrs<AnnotateAttr>()) {
+      if (A->getAnnotation() == "safecpp.native.choice.tag") Tag = F;
+      if (A->getAnnotation() == "safecpp.native.choice.payload") Payload = F;
+    }
+  }
+  if (Fields != 2 || !Tag || !Payload) return std::nullopt;
+  unsigned Alternatives = 0, Empty = 0;
+  for (const Decl *D : R->decls())
+    if (const auto *A = dyn_cast<TypeAliasDecl>(D))
+      for (const auto *M : A->specific_attrs<AnnotateAttr>())
+        if (M->getAnnotation().starts_with("safecpp.native.choice.alternative:")) {
+          ++Alternatives;
+          Empty += A->getUnderlyingType()->isVoidType();
+        }
+  if (Alternatives != 2 || Empty != 1) return std::nullopt;
+  const auto *Storage = Payload->getType()->getAsRecordDecl();
+  if (!Storage || !Storage->isUnion() ||
+      std::distance(Storage->field_begin(), Storage->field_end()) != 1)
+    return std::nullopt;
+  const FieldDecl *Value = *Storage->field_begin();
+  const auto *V = Value->getType()->getAsCXXRecordDecl();
+  if (V) V = V->getDefinition();
+  if (!V || !V->isCompleteDefinition() || V->getNumBases() ||
+      V->isDynamicClass() || !hasTrustedCircleMarker(V, "safecpp.niche.zero"))
+    return std::nullopt;
+  const FieldDecl *Pointer = nullptr;
+  for (const FieldDecl *F : V->fields()) {
+    if (F->isCirclePhantom()) continue;
+    if (Pointer || F->isBitField() || !F->getType()->isPointerType())
+      return std::nullopt;
+    Pointer = F;
+  }
+  if (!Pointer) return std::nullopt;
+  for (const auto *A : Value->specific_attrs<AnnotateAttr>()) {
+    llvm::StringRef Text = A->getAnnotation();
+    if (!Text.consume_front("safecpp.native.choice.alternative:")) continue;
+    unsigned Index;
+    if (!Text.getAsInteger(10, Index) && Index < 2)
+      return CircleZeroNiche{Tag, Payload, Pointer, Index};
+  }
+  return std::nullopt;
+}
+
+inline std::optional<CircleZeroNiche> getCircleZeroNicheTag(const FieldDecl *F) {
+  auto Info = getCircleZeroNiche(F->getParent());
+  if (Info && Info->Tag == F) return Info;
+  return std::nullopt;
+}
+} // namespace clang
+#endif
