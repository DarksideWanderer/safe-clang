+void CodeGenFunction::EmitSafetyRelocation(const UnaryOperator *E,
+                                           AggValueSlot Slot) {
+  auto [Owner, Path] = getSafetyOwnedPlace(E->getSubExpr());
+  LValue Source = EmitLValue(E->getSubExpr());
