+    ConsumeToken();
+    Pattern->K = Sema::CirclePattern::CatchAll;
+    return Pattern;
+  }
+  if (Tok.is(tok::kw_true) || Tok.is(tok::kw_false)) {
+    Pattern->K = Sema::CirclePattern::Bool;
+    Pattern->BoolValue = Tok.is(tok::kw_true);
+    ConsumeToken();
+    return Pattern;
+  }
+  if (Tok.is(tok::identifier)) {
+    Pattern->K = Sema::CirclePattern::Bind;
+    Pattern->BindingName = Tok.getIdentifierInfo();
+    ConsumeToken();
+    bool AtPattern = Tok.is(tok::at) ||
+                     (Tok.is(tok::unknown) && PP.getSpelling(Tok) == "@");
+    if (AtPattern) {
+      ConsumeToken();
+      Pattern->Payload = ParseCircleMatchPrimaryPattern();
+      if (!Pattern->Payload)
+        return nullptr;
+    }
+    return Pattern;
+  }
+  if (Tok.is(tok::minus) || Tok.is(tok::plus)) {
+    llvm::APInt Value;
+    if (ParseCirclePatternValue(Value, Pattern->LowType))
+      return nullptr;
+    Pattern->K = Sema::CirclePattern::Value;
+    Pattern->Low = Value;
+    Pattern->High = Value;
+    Pattern->HighType = Pattern->LowType;
+    Pattern->LowInclusive = true;
+    Pattern->HighInclusive = true;
+    return Pattern;
+  }
+  if (Tok.is(tok::numeric_constant)) {
+    // `lo...hi` is one pp-number: the dots inside its spelling are what
+    // separate the ends of the range.
+    std::string Spelling = PP.getSpelling(Tok);
+    llvm::StringRef Text = Spelling;
+    if (size_t Dots = Text.find(".."); Dots != llvm::StringRef::npos) {
+      if (Text.substr(Dots, 3) != "...")
+        return Fail("a range pattern uses '...' between its bounds");
+      llvm::APInt Low, High;
+      llvm::StringRef Ends = Text.substr(Dots + 3);
+      // Preserve C++ literal types and suffixes. Truncating each bound to the
+      // operand type would make `256` match an unsigned-char zero, and make
+      // `250...256` an empty interval for that same operand.
+      auto ReadBound = [&](llvm::StringRef Part, llvm::APInt &Value,
+                           QualType &Type) {
+        if (Part.empty())
+          return true;
+        std::string Padded = Part.str();
+        Token BoundToken = Tok;
+        BoundToken.setLength(Part.size());
+        BoundToken.setLiteralData(Padded.c_str());
+        BoundToken.clearFlag(Token::NeedsCleaning);
+        ExprResult E = Part.size() == 1 && llvm::isDigit(Part.front())
+                           ? Actions.ActOnIntegerConstant(Tok.getLocation(),
+                                                         Part.front() - '0')
+                           : Actions.ActOnNumericConstant(BoundToken,
+                                                          getCurScope());
+        Expr::EvalResult Result;
+        if (E.isInvalid() || !E.get()->getType()->isIntegerType() ||
+            !E.get()->EvaluateAsInt(Result, Actions.getASTContext()))
+          return true;
+        Value = Result.Val.getInt();
+        Type = E.get()->getType();
+        return false;
+      };
+      if (ReadBound(Text.substr(0, Dots), Low, Pattern->LowType) ||
+          ReadBound(Ends, High, Pattern->HighType)) {
+        Diag(Tok, Diags.getCustomDiagID(DiagnosticsEngine::Error,
+                                       "a range pattern's ends must be integer "
+                                       "constants: %0"))
+            << Text;
+        return nullptr;
+      }
+      ConsumeToken();
+      Pattern->K = Sema::CirclePattern::Range;
+      Pattern->Low = Low;
+      Pattern->High = High;
+      Pattern->LowInclusive = true;
+      Pattern->HighInclusive = false;
+      return Pattern;
+    }
+    llvm::APInt Low;
+    if (ParseCirclePatternValue(Low, Pattern->LowType))
+      return nullptr;
+    if (Tok.is(tok::ellipsis)) {
+      ConsumeToken();
+      llvm::APInt High;
+      if (ParseCirclePatternValue(High, Pattern->HighType))
+        return nullptr;
+      Pattern->K = Sema::CirclePattern::Range;
+      Pattern->Low = Low;
+      Pattern->High = High;
+      Pattern->LowInclusive = true;
+      Pattern->HighInclusive = false;
+      return Pattern;
+    }
+    Pattern->K = Sema::CirclePattern::Value;
+    Pattern->Low = Low;
+    Pattern->High = Low;
+    Pattern->HighType = Pattern->LowType;
+    Pattern->LowInclusive = true;
+    Pattern->HighInclusive = true;
+    return Pattern;
+  }
+  return Fail("expected a match pattern");
+}
+
+/// The integer constant a value or range pattern compares against.
+bool Parser::ParseCirclePatternValue(llvm::APInt &Value, QualType &Type) {
+  ExprResult Bound = ParseConstantExpression();
+  if (Bound.isInvalid())
+    return true;
+  Expr::EvalResult Result;
+  if (!Bound.get()->EvaluateAsInt(Result, Actions.getASTContext())) {
+    Diag(Bound.get()->getExprLoc(),
+         Actions.getDiagnostics().getCustomDiagID(
+             DiagnosticsEngine::Error,
+             "a pattern value must be an integer constant"));
+    return true;
+  }
+  Value = Result.Val.getInt();
+  Type = Bound.get()->getType();
+  return false;
+}
