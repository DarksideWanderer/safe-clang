+                                               F->getParamTypes(), EPI);
+        }
+    bool Found = false;
+    for (auto *Candidate : Record->methods()) {
+      if (Candidate->isImplicit() || Candidate->getDeclName() != Method->getDeclName())
+        continue;
+      auto *Want = Expected->getAs<FunctionProtoType>();
+      auto *Have = Candidate->getType()->getAs<FunctionProtoType>();
+      if (!Want || !Have || Want->getNumParams() != Have->getNumParams())
+        continue;
