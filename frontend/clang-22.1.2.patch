+  // Substitute the referent as a type so native slice lowering can replace it.
+  // BorrowValueTypeLoc is pointer-like and still requires the complete inner
+  // TypeLoc chain after that replacement.
+  QualType Pointee =
+      getDerived().TransformType(TL.getType()->castAs<BorrowValueType>()
+                                     ->getPointeeType());
