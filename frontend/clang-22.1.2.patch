+enum class Variance { Bivariant = 0, Covariant = 1, Contravariant = 2, Invariant = 3 };
+inline Variance joinVariance(Variance A, Variance B) {
+  return static_cast<Variance>(static_cast<unsigned>(A) | static_cast<unsigned>(B));
+}
+
+inline bool sharedBorrow(ASTContext &C, QualType T) {
+  if (const auto *B = T->getAs<BorrowValueType>()) return C.circleBorrowIsShared(B);
+  return T->isReferenceType() && T->getPointeeType().isConstQualified();
+}
+
+// Region arguments of a mutable referent are invariant. Its own borrow
+// duration is still covariant. Read-only records compose their field variance;
+// shared access that exposes mutable region-carrying storage is interior
+// mutation, regardless of the record's spelling.
+class ClassVariance {
+  ASTContext &C;
+  std::map<std::pair<const CXXRecordDecl *, unsigned>, Variance> Values;
+  std::function<Variance(QualType, unsigned)> CallableVariance;
+  bool Solving = false;
+
+  Variance compute(const CXXRecordDecl *R, unsigned Region, unsigned Depth) {
+    if (R->getNumBases()) return Variance::Invariant;
+    Variance Result = Variance::Bivariant;
+    for (auto *M : R->methods()) {
+      if (isa<CXXConstructorDecl>(M) || isa<CXXDestructorDecl>(M)) continue;
+      bool Shared = M->isConst();
+      if (M->isExplicitObjectMemberFunction() && M->getNumParams())
+        Shared = sharedBorrow(C, M->getParamDecl(0)->getType());
+      auto Result = M->getReturnType();
+      if (Shared && (Result->isPointerType() || Result->isReferenceType() ||
+                     Result->getAs<BorrowValueType>())) {
+        QualType Pointee = Result->getAs<BorrowValueType>()
+            ? Result->castAs<BorrowValueType>()->getPointeeType() : Result->getPointeeType();
+        QualType Element = Pointee;
+        while (const auto *Array = C.getAsArrayType(Element))
+          Element = Array->getElementType();
+        if (!Pointee.isConstQualified() &&
+            (Element->isVoidType() || circleTypeCarriesLifetimes(Element)))
+          return Variance::Invariant;
+      }
+    }
+    for (auto *F : R->fields()) {
+      auto T = F->getType();
+      // Arrays repeat the element's region mapping; array bounds do not create
+      // fresh regions. Inspect the leaf before deciding whether its referent
+      // carries mutable storage. Peel every array rank before classifying it.
+      while (const auto *Array = C.getAsArrayType(T))
+        T = Array->getElementType();
+      bool Mutable = F->isMutable();
+      for (auto *A : F->specific_attrs<AnnotateAttr>())
+        Mutable |= A->getAnnotation() == "safecpp.unsafe.object";
+      const auto *Borrow = T->getAs<BorrowValueType>();
+      bool Handle = !circleIsCallableValue(T) &&
+                    (Borrow || T->isReferenceType() || T->isPointerType());
+      QualType Payload = Borrow ? Borrow->getPointeeType()
+                               : Handle ? T->getPointeeType() : T;
+      // A borrow's first field lifetime describes the borrow itself, not its
+      // pointee's embedded regions. Their explicit class arguments are mapped
+      // separately below.
+      if ((Borrow || T->isReferenceType()) && circleMappedFieldRegion(F, 1) == Region)
+        Result = joinVariance(Result, Mutable ? Variance::Invariant : Variance::Covariant);
+      const auto *Nested = circleClassRecord(Payload);
+      unsigned Count = circleTypeLifetimeCount(Payload);
+      for (unsigned I = 1; I <= Count; ++I) {
+        unsigned Mapped = circleMappedFieldRegion(F, I);
+        if (Handle) {
+          const auto *Binding = circleClassLifetimeBinding(Payload);
+          if (!Binding || I > Binding->getArguments().size()) return Variance::Invariant;
+          const auto *Name = Binding->getArguments()[I - 1];
+          if (!Name) return Variance::Invariant;
+          Mapped = Name->isStr("static") ? 0x40000000u
+              : circleClassLifetimeIndex(R, Name->getName());
+        }
+        if (!Mapped) return Variance::Invariant;
+        if (Mapped != Region) continue;
+        bool WritablePayload = Handle && !sharedBorrow(C, T);
+        if (Handle && T->isPointerType()) WritablePayload = !Payload.isConstQualified();
+        if (Mutable || WritablePayload) return Variance::Invariant;
+        Variance Field = circleIsCallableValue(Payload)
+            ? CallableVariance(Payload, I) : get(Nested, I, Depth + 1);
+        Result = joinVariance(Result, Field);
+        if (Result == Variance::Invariant) return Result;
+      }
+    }
+    return Result;
+  }
+
+public:
+  ClassVariance(ASTContext &C, std::function<Variance(QualType, unsigned)> Callable)
+      : C(C), CallableVariance(std::move(Callable)) {}
+
+  Variance get(const CXXRecordDecl *R, unsigned Region, unsigned Depth = 0) {
+    if (!R || !R->hasDefinition()) return Variance::Invariant;
+    R = R->getDefinition();
+    auto Key = std::make_pair(R, Region);
+    Values.emplace(Key, Variance::Bivariant);
+    if (Solving) return Values.at(Key);
+    // The four-point variance lattice has finite height. Iterate the finite
+    // record graph from bivariant, including cycles and shared subgraphs.
+    Solving = true;
+    bool Changed;
+    do {
+      Changed = false;
+      auto Size = Values.size();
+      for (auto I = Values.begin(); I != Values.end(); ++I) {
+        auto Next = joinVariance(I->second, compute(I->first.first, I->first.second, 0));
+        Changed |= Next != I->second;
+        I->second = Next;
+      }
+      Changed |= Size != Values.size();
+    } while (Changed);
+    Solving = false;
+    return Values.at(Key);
+  }
+};
+
+// Reduced ordered decision diagrams implement the quantified region-order
+// formula. At each prototype the target binders are universal and the source
+// binders existential. A nested prototype closes only its own variables;
+// captures remain free until the enclosing prototype closes them. In
+// particular, an earlier existential cannot depend on a later universal.
+//
+// Region inclusion is pointwise implication. Quantifying the point-membership
+// bits proves the relation for arbitrary region sets, including the empty and
+// static regions. Target where-clauses are local implication guards, never
+// assumptions leaked into a sibling prototype.
+class RegionFormula {
+  struct Node { unsigned Var, Low, High; };
+  std::vector<Node> Nodes{{~0u, 0, 0}, {~0u, 1, 1}};
+  std::map<std::tuple<unsigned, unsigned, unsigned>, unsigned> Unique;
+  std::map<std::pair<unsigned, unsigned>, unsigned> AndCache;
+  std::map<unsigned, unsigned> NotCache;
+  unsigned Variables = 0;
+  bool Exhausted = false;
+public:
+  unsigned make(unsigned Var, unsigned Low, unsigned High) {
+    if (Low == High) return Low;
+    auto Key = std::make_tuple(Var, Low, High);
+    if (auto I = Unique.find(Key); I != Unique.end()) return I->second;
+    // A hostile signature must fail closed without unbounded allocation.
+    if (Nodes.size() >= 262144) { Exhausted = true; return 0; }
+    unsigned ID = Nodes.size(); Nodes.push_back({Var, Low, High});
+    Unique.emplace(Key, ID); return ID;
+  }
+  unsigned variable() { return make(Variables++, 0, 1); }
+  unsigned conjunction(unsigned A, unsigned B) {
+    if (!A || !B) return 0;
+    if (A == 1 || A == B) return B;
+    if (B == 1) return A;
+    if (A > B) std::swap(A, B);
+    auto Key = std::make_pair(A, B);
+    if (auto I = AndCache.find(Key); I != AndCache.end()) return I->second;
+    auto X = Nodes[A], Y = Nodes[B];
+    unsigned V = std::min(X.Var, Y.Var);
+    unsigned Low = conjunction(X.Var == V ? X.Low : A, Y.Var == V ? Y.Low : B);
+    unsigned High = conjunction(X.Var == V ? X.High : A, Y.Var == V ? Y.High : B);
+    unsigned Result = make(V, Low, High);
+    AndCache.emplace(Key, Result); return Result;
+  }
+  unsigned negate(unsigned A) {
+    if (A < 2) return 1 - A;
+    if (auto I = NotCache.find(A); I != NotCache.end()) return I->second;
+    auto N = Nodes[A];
+    unsigned Low = negate(N.Low), High = negate(N.High);
+    unsigned Result = make(N.Var, Low, High);
+    NotCache.emplace(A, Result); return Result;
+  }
+  unsigned implication(unsigned Long, unsigned Short) {
+    // Long outlives Short: membership in Short implies membership in Long.
+    return negate(conjunction(Short, negate(Long)));
+  }
+  unsigned quantify(unsigned Root, ArrayRef<unsigned> Variables, bool Universal) {
+    std::set<unsigned> Selected;
+    for (unsigned ID : Variables) Selected.insert(Nodes[ID].Var);
+    std::map<unsigned, unsigned> Cache;
+    auto Visit = [&](auto &&Self, unsigned A) -> unsigned {
+      if (A < 2) return A;
+      if (auto I = Cache.find(A); I != Cache.end()) return I->second;
+      auto N = Nodes[A];
+      unsigned Low = Self(Self, N.Low), High = Self(Self, N.High);
+      unsigned Result = Selected.count(N.Var)
+          ? Universal ? conjunction(Low, High)
+                      : negate(conjunction(negate(Low), negate(High)))
+          : make(N.Var, Low, High);
+      Cache.emplace(A, Result); return Result;
+    };
+    return Visit(Visit, Root);
+  }
+  bool valid(unsigned Root) const { return !Exhausted && Root == 1; }
+};
+
+inline bool hasCaptures(QualType T) { return !circleCallableCaptures(T).empty(); }
+
+class FunctionRelation {
+  ASTContext &C;
+  ClassVariance ClassRegions;
+  llvm::DenseSet<std::pair<QualType, QualType>> ProvenValues;
+  RegionFormula Regions;
+  unsigned Formula = 1;
+  struct Scope {
+    std::map<unsigned, unsigned> Nodes;
+    SmallVector<unsigned, 8> Variables;
+  };
+  using Scopes = std::vector<Scope>;
+  Scopes Left, Right;
+  Scopes *Source = &Left, *Target = &Right;
+  std::map<std::tuple<unsigned, unsigned, unsigned>, unsigned> Ambient;
+  unsigned TestedCapture = 0;
+  SmallVector<unsigned, 8> AmbientVariables;
+
+  unsigned node(unsigned ID, Scopes &Side) {
+    if (ID == 0x40000000u) return 1;
+    unsigned Distance = circleRegionIsCapture(ID) ? circleCaptureDepth(ID) : 0;
+    unsigned Slot = circleRegionIsCapture(ID) ? circleCaptureSlot(ID) : ID;
+    if (Distance >= Side.size()) {
+      unsigned Outside = Distance - Side.size();
+      bool Tested = TestedCapture && Outside + 1 == circleCaptureDepth(TestedCapture) &&
+                    Slot == circleCaptureSlot(TestedCapture);
+      auto Key = std::make_tuple(Outside, Slot, Tested ? (&Side == &Left ? 1u : 2u) : 0u);
+      auto [I, Added] = Ambient.emplace(Key, 0);
+      if (Added) { I->second = Regions.variable(); AmbientVariables.push_back(I->second); }
+      return I->second;
+    }
+    auto &S = Side[Side.size() - Distance - 1];
+    auto [I, Added] = S.Nodes.emplace(Slot, 0);
+    if (Added) { I->second = Regions.variable(); S.Variables.push_back(I->second); }
+    return I->second;
+  }
+  unsigned assumptions(const FunctionProtoType *F, Scopes &Side) {
+    // Set static aliases before creating variables for any occurrence.
+    for (unsigned I = 0; I < F->getNumParams(); ++I)
+      if (F->getExtParameterInfo(I).hasStaticLifetime()) {
+        unsigned ID = circleFunctionRegion(F, I + 1);
+        if (ID && !circleRegionIsCapture(ID)) Side.back().Nodes[ID] = 1;
+      }
+    unsigned Result = 1;
+    auto E = F->getLifetimeOutlives();
+    for (unsigned I = 0; I + 1 < E.size(); I += 2)
+      Result = Regions.conjunction(Result, Regions.implication(node(E[I], Side), node(E[I + 1], Side)));
+    return Result;
+  }
+  bool relate(unsigned From, unsigned To, bool Parameter, Variance V) {
+    if (!From || !To) return From == To;
+    if (V == Variance::Bivariant) return true;
+    if (V == Variance::Contravariant) Parameter = !Parameter;
+    unsigned A = node(From, *Source), B = node(To, *Target);
+    unsigned Edge = Regions.implication(Parameter ? B : A, Parameter ? A : B);
+    if (V == Variance::Invariant)
+      Edge = Regions.conjunction(Edge, Regions.implication(Parameter ? A : B, Parameter ? B : A));
+    Formula = Regions.conjunction(Formula, Edge);
+    return true;
+  }
+
+
+  bool value(QualType From, QualType To, unsigned Depth) {
+    // Nested prototypes have independent scopes, so a completed value
+    // relation is reusable within this query. Cache successes only: a depth
+    // limit failure in one branch must not poison a shallower comparison.
+    QualType A = C.getCanonicalType(From), B = C.getCanonicalType(To);
+    auto Key = std::make_pair(A, B);
+    bool Captured = hasCaptures(From) || hasCaptures(To);
+    if (!Captured && ProvenValues.contains(Key)) return true;
+    unsigned Before = Formula;
+    bool Result = valueImpl(From, To, Depth);
+    if (Result && !Captured && Formula && Formula == Before) ProvenValues.insert(Key);
+    return Result;
+  }
+  bool valueImpl(QualType From, QualType To, unsigned Depth) {
+    if (C.hasSameType(From, To) && !hasCaptures(From)) return true;
+    if (Depth > 256 || From.getQualifiers() != To.getQualifiers()) return false;
+    auto *F = From->getAs<FunctionProtoType>(), *T = To->getAs<FunctionProtoType>();
+    if (F || T) return F && T && function(F, T, Depth + 1);
+    if (From->getAs<BorrowValueType>() || To->getAs<BorrowValueType>()) {
+      if (!From->getAs<BorrowValueType>() || !To->getAs<BorrowValueType>())
+        return false;
+      auto A = From->getPointeeType(), B = To->getPointeeType();
+      // Borrowing a function names immutable code; borrowing a pointer names
+      // a writable slot unless the slot itself is const. Do not confuse the
+      // borrow's duration with permission to replace its stored callback.
+      return (A->isFunctionType() ||
+              (sharedBorrow(C, From) && sharedBorrow(C, To))) &&
+             value(A, B, Depth + 1);
+    }
+    if (From->isPointerType() && To->isPointerType()) {
+      auto A = From->getPointeeType(), B = To->getPointeeType();
+      if (A->isFunctionType() && B->isFunctionType()) return value(A, B, Depth + 1);
+      // Mutable pointer slots are invariant, even if their function values
+      // could individually be converted in one direction.
+      return A.isConstQualified() && B.isConstQualified() && value(A, B, Depth + 1);
+    }
+    if (From->isReferenceType() && To->isReferenceType() &&
+        From->isLValueReferenceType() == To->isLValueReferenceType()) {
+      auto A = From->getPointeeType(), B = To->getPointeeType();
+      return (A->isFunctionType() || A.isConstQualified()) && value(A, B, Depth + 1);
+    }
+    if (const auto *A = From->getAs<MemberPointerType>()) {
+      const auto *B = To->getAs<MemberPointerType>();
+      // Member-data pointers designate storage; converting their stored
+      // callback type would permit writing through the wrong declaration.
+      if (!B || !A->getPointeeType()->isFunctionType() ||
+          !B->getPointeeType()->isFunctionType()) return false;
+      auto *AR = A->getMostRecentCXXRecordDecl(), *BR = B->getMostRecentCXXRecordDecl();
+      bool SameClass = AR && BR ? AR->getCanonicalDecl() == BR->getCanonicalDecl()
+                               : A->getQualifier() == B->getQualifier();
+      return SameClass && value(A->getPointeeType(), B->getPointeeType(), Depth + 1);
+    }
+    if (const auto *A = C.getAsArrayType(From)) {
+      const auto *B = C.getAsArrayType(To);
+      if (!B || A->getTypeClass() != B->getTypeClass() ||
+          A->getSizeModifier() != B->getSizeModifier() ||
+          A->getIndexTypeCVRQualifiers() != B->getIndexTypeCVRQualifiers()) return false;
+      if (const auto *Bound = dyn_cast<ConstantArrayType>(A)) {
+        if (Bound->getSize() != cast<ConstantArrayType>(B)->getSize()) return false;
+      } else if (!isa<IncompleteArrayType>(A)) return false;
+      auto X = A->getElementType(), Y = B->getElementType();
+      return X.isConstQualified() && Y.isConstQualified() && value(X, Y, Depth + 1);
+    }
+    return false;
+  }
+  unsigned region(const FunctionProtoType *F, unsigned Position) {
+    // A static kind constraint may retain a canonical binder ID as well as
+    // the static parameter bit. Its semantic duration is static, never a
+    // fresh source variable that inference is allowed to shorten.
+    if (Position && F->getExtParameterInfo(Position - 1).hasStaticLifetime())
+      return 0x40000000u;
+    if (!Position && F->getReturnBorrow() == 0x40000000u) return 0x40000000u;
+    unsigned R = circleFunctionRegion(F, Position);
+    if (R) return R;
+    if (!Position) return 0;
+    auto T = F->getParamType(Position - 1);
+    // An elided input borrow has a fresh call-local duration. It is not an
+    // unknown class-data projection, nor the binder numbered the same way in
+    // a surrounding callback.
+    return T->getAs<BorrowValueType>() || T->isReferenceType()
+        ? 0x80000000u + Position : 0;
+  }
+  bool projections(const FunctionProtoType *F,
+                   const FunctionProtoType *T, unsigned Position) {
+    auto FromType = Position ? F->getParamType(Position - 1) : F->getReturnType();
+    auto ToType = Position ? T->getParamType(Position - 1) : T->getReturnType();
+    // Callable projections summarize value provenance for flow analysis.
+    // Their captures are already related, with the right quantifier scope,
+    // by value(). A closed polymorphic callback can replace a captured one
+    // even though their free-region layouts have different cardinalities.
+    if (circleIsCallableValue(FromType) && circleIsCallableValue(ToType)) return true;
+    auto A = F->getClassLifetimeBindings(), B = T->getClassLifetimeBindings();
+    unsigned CountA = 0, CountB = 0;
+    for (unsigned I = 0; I + 2 < A.size(); I += 3) CountA += A[I] == Position;
+    for (unsigned I = 0; I + 2 < B.size(); I += 3) CountB += B[I] == Position;
+    if (CountA != CountB) return false;
+    auto Type = Position ? F->getParamType(Position - 1) : F->getReturnType();
+    bool Handle = Type->isReferenceType() || Type->getAs<BorrowValueType>();
+    const auto *Record = circleClassRecord(Type);
+    for (unsigned I = 0; I + 2 < A.size(); I += 3) {
+      if (A[I] != Position) continue;
+      bool Found = false;
+      for (unsigned J = 0; J + 2 < B.size(); J += 3) {
+        if (B[J] != Position || B[J + 1] != A[I + 1]) continue;
+        auto V = Handle && !sharedBorrow(C, Type) ? Variance::Invariant
+                    : circleIsCallableValue(Type) ? callableVariance(Type, A[I + 1])
+                    : ClassRegions.get(Record, A[I + 1]);
+        if (!relate(A[I + 2], B[J + 2], Position != 0, V)) return false;
+        Found = true;
+      }
+      if (!Found) return false;
+    }
+    return true;
+  }
+
+public:
+  explicit FunctionRelation(ASTContext &C)
+      : C(C), ClassRegions(C, [this](QualType T, unsigned I) { return callableVariance(T, I); }) {}
+  bool varying(QualType Type, unsigned Capture, bool Covariant) {
+    TestedCapture = Capture;
+    if (!value(Type, Type, 0)) return false;
+    auto Key = [&](unsigned Side) {
+      return std::make_tuple(circleCaptureDepth(Capture) - 1, circleCaptureSlot(Capture), Side);
+    };
+    auto Variable = [&](unsigned Side) {
+      auto [I, Added] = Ambient.emplace(Key(Side), 0);
+      if (Added) { I->second = Regions.variable(); AmbientVariables.push_back(I->second); }
+      return I->second;
+    };
+    unsigned A = Variable(1), B = Variable(2);
+    unsigned Guard = Regions.implication(Covariant ? A : B, Covariant ? B : A);
+    return Regions.valid(Regions.quantify(Regions.implication(Formula, Guard), AmbientVariables, true));
+  }
+  Variance callableVariance(QualType Type, unsigned I) {
+    auto Captures = circleCallableCaptures(Type);
+    if (!I || I > Captures.size()) return Variance::Invariant;
+    bool Cov = FunctionRelation(C).varying(Type, Captures[I - 1], true);
+    bool Contra = FunctionRelation(C).varying(Type, Captures[I - 1], false);
+    return Cov ? Contra ? Variance::Bivariant : Variance::Covariant
+               : Contra ? Variance::Contravariant : Variance::Invariant;
+  }
+  bool function(const FunctionProtoType *From, const FunctionProtoType *To,
+                unsigned Depth = 0) {
+    if (C.hasSameType(QualType(From, 0), QualType(To, 0)) &&
+        !hasCaptures(QualType(From, 0))) return true;
+    if (Depth > 256 || From->getNumParams() != To->getNumParams() ||
+        From->isVariadic() != To->isVariadic() ||
+        From->getMethodQuals() != To->getMethodQuals() ||
+        From->getRefQualifier() != To->getRefQualifier()) return false;
+    auto A = From->getExtInfo(), B = To->getExtInfo();
+    if ((!A.getModuleSafe() && B.getModuleSafe()) ||
+        (!A.getExplicitSafe() && B.getExplicitSafe()) ||
+        (!A.getNoReturn() && B.getNoReturn()) ||
+        (!From->isNothrow() && To->isNothrow())) return false;
+    if (isUnresolvedExceptionSpec(From->getExceptionSpecType()) ||
+        isUnresolvedExceptionSpec(To->getExceptionSpecType()) ||
+        From->getExceptionSpecType() == EST_DependentNoexcept ||
+        To->getExceptionSpecType() == EST_DependentNoexcept ||
+        From->getExceptionSpecType() == EST_Unparsed ||
+        To->getExceptionSpecType() == EST_Unparsed) return false;
+    // Legacy class-result and generative summaries have additional provenance
+    // obligations, beyond this quantified graph. Do not reinterpret them as
+    // ordinary universally quantified borrow durations.
+    auto RawGenerative = [](const FunctionProtoType *F) {
+      return F->hasGenerativeReturnLifetime() && llvm::any_of(F->getParamTypes(), [](QualType T) {
+        return T->isPointerType() && !T->getPointeeType()->isFunctionType();
+      });
+    };
+    if (From->getReturnBorrowClassRegion() != To->getReturnBorrowClassRegion() ||
+        ((RawGenerative(From) || RawGenerative(To) ||
+          (!hasCaptures(QualType(From, 0)) && !hasCaptures(QualType(To, 0)))) &&
+         From->hasGenerativeReturnLifetime() != To->hasGenerativeReturnLifetime())) return false;
+    if ((!region(From, 0) || !region(To, 0)) &&
+        !circleSameReturnBorrowContract(From, To)) return false;
+    unsigned ParentFormula = Formula;
+    Formula = 1;
+    Source->emplace_back(); Target->emplace_back();
+    unsigned TargetGuard = assumptions(To, *Target);
+    unsigned SourceGuard = assumptions(From, *Source);
+    for (unsigned P = 0; P <= From->getNumParams(); ++P) {
+      if (!relate(region(From, P), region(To, P), P != 0, Variance::Covariant) ||
+          !projections(From, To, P)) return false;
+      if (P) {
+        auto X = From->getExtParameterInfo(P - 1), Y = To->getExtParameterInfo(P - 1);
+        // The static bits are checked as regions; every ABI/ownership bit
+        // still has to match. Type-wide static constraints remain exact.
+        if (X.hasStaticTypeLifetimes() != Y.hasStaticTypeLifetimes() ||
+            ((X.getOpaqueValue() ^ Y.getOpaqueValue()) & ~0x80u)) return false;
+        std::swap(Source, Target);
+        bool ParameterOK = value(To->getParamType(P - 1), From->getParamType(P - 1), Depth + 1);
+        std::swap(Source, Target);
+        if (!ParameterOK) return false;
+      }
+    }
+    if (!value(From->getReturnType(), To->getReturnType(), Depth + 1)) return false;
+    unsigned Local = Regions.conjunction(SourceGuard, Formula);
+    Local = Regions.quantify(Local, Source->back().Variables, false);
+    Local = Regions.implication(Local, TargetGuard);
+    Local = Regions.quantify(Local, Target->back().Variables, true);
+    Source->pop_back(); Target->pop_back();
+    Formula = Regions.conjunction(ParentFormula, Local);
+    // Rebuild only after proving substitutability. Canonical comparison then
+    // retains unmodeled target attributes, effects, ABI and shape requirements.
+    auto EPI = From->getExtProtoInfo(), Target = To->getExtProtoInfo();
+    EPI.ExtInfo = A.withModuleSafe(B.getModuleSafe()).withExplicitSafe(B.getExplicitSafe())
+                     .withNoReturn(B.getNoReturn());
+    EPI.ExceptionSpec = Target.ExceptionSpec;
+    EPI.ReturnBorrow = Target.ReturnBorrow;
+    EPI.ReturnBorrowSources = Target.ReturnBorrowSources;
+    EPI.ReturnBorrowClassRegion = Target.ReturnBorrowClassRegion;
+    EPI.LifetimeBindings = Target.LifetimeBindings;
+    EPI.ClassLifetimeBindings = Target.ClassLifetimeBindings;
+    EPI.LifetimeOutlives = Target.LifetimeOutlives;
+    EPI.ExtParameterInfos = Target.ExtParameterInfos;
+    return C.hasSameType(C.getFunctionType(To->getReturnType(), To->getParamTypes(), EPI), QualType(To, 0));
+  }
+  bool convertible(QualType From, QualType To) {
+    From = From.getNonReferenceType(); To = To.getNonReferenceType();
+    if (From->isFunctionType() && To->isFunctionPointerType()) To = To->getPointeeType();
+    if (To->isFunctionType() && From->isFunctionPointerType()) From = From->getPointeeType();
+    bool Shape = value(From, To, 0);
+    return Shape && Regions.valid(Regions.quantify(Formula, AmbientVariables, true));
+  }
+};
+} // namespace circle_relation
+
+inline bool circleFunctionTypeConvertible(ASTContext &C, QualType From, QualType To) {
+  return circle_relation::FunctionRelation(C).convertible(From, To);
+}
+
+// Runtime signature checks cannot compare quantified contracts: those are
+// checked by Sema and flow analysis and have no ABI representation. Normalize
+// nested callbacks as well as the outer prototype, retaining value types,
+// calling conventions and ownership/parameter ABI bits. Ordinary Clang types
+// without Circle contracts retain their original runtime identity.
+inline QualType circleCallableRuntimeType(ASTContext &C, QualType T) {
+  if (!circleContainsFunctionLifetimeContract(T)) return T;
+  llvm::DenseMap<QualType, QualType> Rewritten;
+  auto Rewrite = [&](auto &&Self, QualType Type) -> QualType {
+    Type = C.getCanonicalType(Type);
+    if (auto I = Rewritten.find(Type); I != Rewritten.end()) return I->second;
+    QualType Result = Type;
+    if (const auto *F = Type->getAs<FunctionProtoType>()) {
+      auto EPI = F->getExtProtoInfo();
+      EPI.ExtInfo = EPI.ExtInfo.withModuleSafe(false).withExplicitSafe(false)
+                       .withNoReturn(false);
+      EPI.ExceptionSpec = FunctionProtoType::ExceptionSpecInfo(EST_None);
+      EPI.ReturnBorrow = 0; EPI.ReturnBorrowClassRegion = 0;
+      EPI.ReturnBorrowSources = {};
+      EPI.LifetimeBindings = {}; EPI.ClassLifetimeBindings = {};
+      EPI.LifetimeOutlives = {};
+      SmallVector<QualType, 8> Params;
+      SmallVector<FunctionProtoType::ExtParameterInfo, 8> Infos;
+      for (unsigned I = 0; I < F->getNumParams(); ++I) {
+        Params.push_back(Self(Self, F->getParamType(I)));
+        Infos.push_back(FunctionProtoType::ExtParameterInfo::getFromOpaqueValue(
+            F->getExtParameterInfo(I).getOpaqueValue() & ~0x180u));
+      }
+      EPI.ExtParameterInfos = Infos.empty() ? nullptr : Infos.data();
+      Result = C.getFunctionType(Self(Self, F->getReturnType()), Params, EPI);
+    } else if (const auto *B = Type->getAs<BorrowValueType>()) {
+      Result = C.getBorrowValueType(Self(Self, B->getPointeeType()));
+    } else if (Type->isPointerType()) {
+      Result = C.getPointerType(Self(Self, Type->getPointeeType()));
+    } else if (Type->isBlockPointerType()) {
+      Result = C.getBlockPointerType(Self(Self, Type->getPointeeType()));
+    } else if (const auto *M = Type->getAs<MemberPointerType>()) {
+      Result = C.getMemberPointerType(Self(Self, M->getPointeeType()),
+                                      M->getQualifier(), M->getMostRecentCXXRecordDecl());
+    } else if (Type->isLValueReferenceType()) {
+      Result = C.getLValueReferenceType(Self(Self, Type->getPointeeType()));
+    } else if (Type->isRValueReferenceType()) {
+      Result = C.getRValueReferenceType(Self(Self, Type->getPointeeType()));
+    } else if (const auto *A = C.getAsConstantArrayType(Type)) {
+      Result = C.getConstantArrayType(Self(Self, A->getElementType()), A->getSize(),
+                                     A->getSizeExpr(), A->getSizeModifier(),
+                                     A->getIndexTypeCVRQualifiers());
+    } else if (const auto *A = C.getAsIncompleteArrayType(Type)) {
+      Result = C.getIncompleteArrayType(Self(Self, A->getElementType()),
+                                       A->getSizeModifier(), A->getIndexTypeCVRQualifiers());
+    }
+    Result = C.getQualifiedType(Result, Type.getLocalQualifiers());
+    Rewritten[Type] = Result;
+    return Result;
+  };
+  return Rewrite(Rewrite, T);
+}
+} // namespace clang
