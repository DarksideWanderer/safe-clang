+void Sema::ActOnCircleMatchArmGuard(ExprResult Guard) {
+  if (CircleMatches.empty())
+    return;
+  assert(!CircleMatches.back().Arms.empty() && "guard without a pattern");
+  if (Guard.isUsable() && !Guard.get()->isTypeDependent())
+    Guard = CheckBooleanCondition(Guard.get()->getExprLoc(), Guard.get());
+  CircleMatches.back().Arms.back().Guard =
+      Guard.isInvalid() ? nullptr : Guard.get();
+}
+
+ExprResult Sema::ActOnCircleMatchFinish(SourceLocation Loc, ParsedType ResultTy) {
+  if (CircleMatches.empty()) {
+    assert(false && "match expression without a start");
+    return ExprError();
+  }
+  CircleMatchState State = std::move(CircleMatches.back());
+  CircleMatches.pop_back();
+  Expr *Operand = State.Operand;
+  if (!Operand)
+    return ExprError();
+  // Parser recovery still closes the match state after an invalid pattern.
+  // An unfinished arm must not reach coverage or lowering with a null body.
+  for (const auto &Arm : State.Arms)
+    if (!Arm.Pattern || !Arm.Body) return ExprError();
+
+  auto &C = Context;
+  QualType ResultType = ResultTy ? GetTypeFromParser(ResultTy) : QualType();
+
+  // A value whose type is still a placeholder — `auto opt = …` in a template,
+  // whose deduction waits for the initializer's type — leaves that placeholder
+  // on the operand; the match resolves it, exactly as every other use of the
+  // value does.
+  if (Operand->getType()->isPlaceholderType()) {
+    // `rel x` keeps the type of what it relocates, so the placeholder a
+    // deferred deduction leaves on `x` reaches the operand: the value it names
+    // is resolved, and the relocation is rebuilt over the value that has a
+    // type.
+    if (auto *Relocation = dyn_cast<UnaryOperator>(Operand);
+        Relocation && Relocation->getOpcode() == UO_Relocate) {
+      ExprResult Inner = CheckPlaceholderExpr(Relocation->getSubExpr());
+      if (Inner.isInvalid())
+        return ExprError();
+      if (!Inner.get()->getType()->isPlaceholderType())
+        Operand = UnaryOperator::Create(
+            Context, Inner.get(), UO_Relocate, Inner.get()->getType(),
+            VK_PRValue, OK_Ordinary, Relocation->getOperatorLoc(),
+            /*CanOverflow=*/false, FPOptionsOverride());
+    } else if (ExprResult Resolved = CheckPlaceholderExpr(Operand);
+               Resolved.isUsable())
+      Operand = Resolved.get();
+    State.Operand = Operand;
+  }
+
+  CircleChoice Choice;
+  QualType OperandType =
+      Operand->getType().getNonReferenceType().getUnqualifiedType();
+  CXXRecordDecl *Record = OperandType->getAsCXXRecordDecl();
+  bool Described = Record && describeChoice(Record, Choice);
+  bool BoolSubject = OperandType->isBooleanType();
+  bool IntegerSubject = OperandType->isIntegralType(Context);
+  bool TupleSubject = IsCircleTupleType(OperandType);
+  // An operand whose type is not known yet is what the arms are tested against
+  // once the template around it is instantiated.
+  bool DependentOperand =
+      Operand->isTypeDependent() || OperandType->isDependentType() ||
+      OperandType->isInstantiationDependentType();
+  if (DependentOperand) {
+    if (State.Arms.empty())
+      return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+          DiagnosticsEngine::Error, "match expression requires at least one arm")));
+    SmallVector<CircleMatchExpr::Pattern, 8> Patterns;
+    std::function<unsigned(const CirclePattern &)> Store =
+        [&](const CirclePattern &P) -> unsigned {
+      unsigned I = Patterns.size();
+      Patterns.emplace_back();
+      auto &Saved = Patterns[I];
+      Saved.Kind = P.K;
+      Saved.Name = P.Name;
+      Saved.BindingName = P.BindingName;
+      Saved.Binding = P.Binding;
+      Saved.Borrow = P.Borrow;
+      Saved.BoolValue = P.BoolValue;
+      Saved.LowInclusive = P.LowInclusive;
+      Saved.HighInclusive = P.HighInclusive;
+      Saved.Loc = P.Loc;
+      if (P.K == CirclePattern::Value || P.K == CirclePattern::Range) {
+        Saved.Low = IntegerLiteral::Create(C, P.Low, P.LowType, P.Loc);
+        Saved.High = IntegerLiteral::Create(C, P.High, P.HighType, P.Loc);
+      }
+      if (P.Payload) {
+        unsigned Child = Store(*P.Payload);
+        Patterns[I].Payload = Child;
+      }
+      unsigned Previous = ~0u;
+      // Tuple elements and OR branches share the serialized child list; the
+      // pattern kind determines how that list is interpreted on restoration.
+      const auto &Children = P.K == CirclePattern::Tuple ? P.Elements : P.Alternatives;
+      for (const auto &Alternative : Children) {
+        unsigned Child = Store(*Alternative);
+        if (Previous == ~0u)
+          Patterns[I].FirstAlternative = Child;
+        else
+          Patterns[Previous].NextAlternative = Child;
+        Previous = Child;
+      }
+      return I;
+    };
+    SmallVector<CircleMatchExpr::Arm, 4> Arms;
+    for (const auto &A : State.Arms) {
+      if (!A.Pattern || !A.Body)
+        return ExprError();
+      Arms.push_back({Store(*A.Pattern), A.Body, A.Loc, A.Guard});
+    }
+    auto *Deferred = CircleMatchExpr::CreateEmpty(C, Patterns.size(), Arms.size());
+    llvm::copy(Patterns, Deferred->patterns().begin());
+    llvm::copy(Arms, Deferred->arms().begin());
+    Deferred->initialize(C, Loc, ResultType, Operand);
+    return Deferred;
+  }
+  if (!DependentOperand && !Described && !BoolSubject && !IntegerSubject &&
+      !TupleSubject)
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "a match operand must be a choice, a bool or "
+                                  "an integer cannot be matched")));
+
+  // A pattern with no test at all matches the operand whatever it holds.
+  std::function<bool(const CirclePattern &)> MatchesAnything =
+      [&](const CirclePattern &P) {
+        if (P.K == CirclePattern::CatchAll)
+          return true;
+        if (P.K == CirclePattern::Bind)
+          return !P.Payload || MatchesAnything(*P.Payload);
+        if (P.K == CirclePattern::Tuple)
+          return llvm::all_of(P.Elements,
+                              [&](const auto &E) { return MatchesAnything(*E); });
+        if (P.K == CirclePattern::Or)
+          for (const auto &Alternative : P.Alternatives)
+            if (MatchesAnything(*Alternative))
+              return true;
+        return false;
+      };
+
+  // A match covers every value the operand can hold: a choice names each of its
+  // alternatives, a bool names both of its values, and a value needs an arm
+  // that matches anything.
+  bool HasCatchAll = false;
+  {
+    bool BoolCovered[2] = {false, false};
+    SmallVector<bool, 8> Covered(Choice.Alternatives.size(), false);
+    // An arm that names an alternative without matching further into it is the
+    // arm for that alternative, so naming one twice is a mistake; a nested
+    // pattern names the alternative around the payload it matches.
+    SmallVector<bool, 8> Named(Choice.Alternatives.size(), false);
+    for (const CircleMatchArm &Arm : State.Arms) {
+      if (!Arm.Pattern)
+        continue;
+      if (MatchesAnything(*Arm.Pattern) && !Arm.Guard) {
+        HasCatchAll = true;
+        continue;
+      }
+      bool Repeated = false;
+      std::function<void(const CirclePattern &)> Cover =
+          [&](const CirclePattern &P) {
+            if (P.K == CirclePattern::Or) {
+              for (const auto &Alternative : P.Alternatives)
+                Cover(*Alternative);
+              return;
+            }
+            if (P.K == CirclePattern::Bool) {
+              BoolCovered[P.BoolValue ? 1 : 0] = true;
+              return;
+            }
+            if (P.K != CirclePattern::Alternative || !Described)
+              return;
+            unsigned Index = circleAlternativeIndex(Choice, P.Name);
+            if (Index == ~0u)
+              return;
+            if (!P.Payload && Named[Index])
+              Repeated = true;
+            if (!P.Payload)
+              Named[Index] = true;
+            Covered[Index] = true;
+          };
+      if (!Arm.Guard) Cover(*Arm.Pattern);
+      if (Repeated)
+        return ExprError(Diag(Arm.Loc, getDiagnostics().getCustomDiagID(
+                                       DiagnosticsEngine::Error,
+                                       "match expression repeats an arm")));
+    }
+    if (!HasCatchAll && !DependentOperand) {
+      if (Described) {
+        for (unsigned I = 0; I != Covered.size(); ++I)
+          if (!Covered[I])
+            return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                          DiagnosticsEngine::Error,
+                                          "match expression does not handle "
+                                          "every alternative of '%0'"))
+                             << Choice.Record->getName());
+      } else if (BoolSubject) {
+        if (!(BoolCovered[0] && BoolCovered[1]))
+          return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                        DiagnosticsEngine::Error,
+                                        "match expression does not handle both "
+                                        "values of the bool operand")));
+      } else if (!TupleSubject) {
+        return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                      DiagnosticsEngine::Error,
+                                      "a match over a value requires an arm "
+                                      "that matches anything")));
+      }
+    }
+  }
+
+  // Specialize a pattern matrix by each finite constructor. Checking columns
+  // independently misses holes such as (true,false) in a two-bool tuple.
+  using PatternRow = SmallVector<const CirclePattern *, 4>;
+  using PatternMatrix = SmallVector<PatternRow, 8>;
+  unsigned CoverageBudget = 65536;
+  auto Head = [](const CirclePattern *P) {
+    while (P && P->K == CirclePattern::Bind) P = P->Payload.get();
+    return P && P->K != CirclePattern::CatchAll ? P : nullptr;
+  };
+  auto Exhaustive = [&](auto &&Self, SmallVector<QualType, 4> Types,
+                        PatternMatrix Rows) -> bool {
+    if (!CoverageBudget) return false;
+    --CoverageBudget;
+    if (Rows.empty()) return false;
+    if (Types.empty()) return true;
+    PatternMatrix Expanded;
+    for (auto &Row : Rows) {
+      SmallVector<const CirclePattern *, 4> Pending{Head(Row.front())};
+      while (!Pending.empty()) {
+        if (!CoverageBudget) return false;
+        --CoverageBudget;
+        const auto *P = Head(Pending.pop_back_val());
+        if (P && P->K == CirclePattern::Or) {
+          for (const auto &A : P->Alternatives) Pending.push_back(A.get());
+        } else {
+          auto Copy = Row; Copy.front() = P; Expanded.push_back(std::move(Copy));
+        }
+      }
+    }
+    for (const auto &Row : Expanded)
+      if (llvm::all_of(Row, [&](auto *P) { return !Head(P); })) return true;
+    QualType Type = Types.front().getNonReferenceType().getUnqualifiedType();
+    SmallVector<QualType, 4> Tail(Types.begin() + 1, Types.end());
+    CircleChoice Ch;
+    bool IsChoice = Type->getAsCXXRecordDecl() && describeChoice(Type->getAsCXXRecordDecl(), Ch);
+    bool IsTuple = IsCircleTupleType(Type);
+    unsigned Constructors = IsChoice ? Ch.Alternatives.size() : Type->isBooleanType() ? 2u : 1u;
+    for (unsigned Constructor = 0; Constructor < Constructors; ++Constructor) {
+      SmallVector<QualType, 4> Children;
+      if (IsChoice) {
+        QualType Payload = Ch.Alternatives[Constructor]->getUnderlyingType();
+        if (!Payload->isVoidType()) Children.push_back(Payload);
+      } else if (IsTuple) {
+        for (auto *Field : Type->getAsCXXRecordDecl()->fields()) Children.push_back(Field->getType());
+      }
+      PatternMatrix Specialized;
+      for (const auto &Row : Expanded) {
+        const auto *P = Head(Row.front());
+        PatternRow Next;
+        if (!P) Next.resize(Children.size(), nullptr);
+        else if (IsChoice && P->K == CirclePattern::Alternative &&
+                 circleAlternativeIndex(Ch, P->Name) == Constructor) {
+          if (!Children.empty()) Next.push_back(P->Payload.get());
+        } else if (IsTuple && P->K == CirclePattern::Tuple) {
+          for (const auto &E : P->Elements) Next.push_back(E.get());
+        } else if (Type->isBooleanType() && P->K == CirclePattern::Bool &&
+                   P->BoolValue == bool(Constructor)) {
+        } else continue;
+        Next.append(Row.begin() + 1, Row.end());
+        Specialized.push_back(std::move(Next));
+      }
+      Children.append(Tail.begin(), Tail.end());
+      if (!Self(Self, std::move(Children), std::move(Specialized))) return false;
+    }
+    return true;
+  };
+  if (!HasCatchAll) {
+    PatternMatrix Rows;
+    for (const auto &Arm : State.Arms)
+      if (Arm.Pattern && !Arm.Guard) Rows.push_back({Arm.Pattern.get()});
+    if (!Exhaustive(Exhaustive, {OperandType}, std::move(Rows)))
+      return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(DiagnosticsEngine::Error,
+          "match expression does not exhaust its nested payload patterns")));
+  }
+
+  QualType SubjectType = Operand->getType();
+  bool OperandIsBorrow = SubjectType->isReferenceType() ||
+                         SubjectType->getAs<BorrowValueType>() ||
+                         SubjectType.isConstQualified();
+  // A place reached through a dereference belongs to the referent, not to
+  // this function. Keep its choice in place and relocate only the payload.
+  const Expr *OperandPlace = Operand->IgnoreParenImpCasts();
+  bool DerefOperand = false;
+  while (const auto *Member = dyn_cast<MemberExpr>(OperandPlace)) {
+    if (Member->isArrow()) {
+      OperandIsBorrow = true;
+      break;
+    }
+    OperandPlace = Member->getBase()->IgnoreParenImpCasts();
+  }
+  if (const auto *Deref = dyn_cast<UnaryOperator>(OperandPlace)) {
+    OperandIsBorrow |= Deref->getOpcode() == UO_Deref;
+    DerefOperand = Deref->getOpcode() == UO_Deref;
+  }
+  // A mutable dereference matched outside the mutable context relocates the
+  // payload it binds. The referent itself stays in place, so `match(mut *p)`
+  // remains the opt-in spelling for a borrowing match.
+  bool RelocatePayloads = DerefOperand &&
+                          !SubjectType.isConstQualified() &&
+                          !isCircleMutableExpr(Operand);
+  QualType OperandVarType;
+  if (Operand->isGLValue())
+    OperandVarType = C.getLValueReferenceType(SubjectType);
+  else
+    OperandVarType = SubjectType;
+  auto *OperandVar = VarDecl::Create(
+      C, CurContext, Loc, Loc, &C.Idents.get("__circle_match_subject"),
+      OperandVarType, C.getTrivialTypeSourceInfo(OperandVarType, Loc), SC_None);
+  OperandVar->setImplicit();
+  OperandVar->addAttr(AnnotateAttr::CreateImplicit(
+      C, "safecpp.native.match.subject", nullptr, 0));
+  OperandVar->setInit(Operand);
+  OperandVar->setInitStyle(VarDecl::CInit);
+  auto *SubjectStmt = new (C) DeclStmt(DeclGroupRef(OperandVar), Loc, Loc);
+  // Every test names the subject through its own reference: a test that is
+  // built twice — once for the arms, once for the check that some arm ran —
+  // cannot share one expression node.
+  auto SubjectRef = [&]() {
+    return DeclRefExpr::Create(
+        C, NestedNameSpecifierLoc(), SourceLocation(), OperandVar,
+        /*RefersToEnclosingVariableOrCapture=*/false, Loc,
+        OperandVarType.getNonReferenceType(),
+        VK_LValue);
+  };
+  auto FieldAccess = [&](Expr *Base, FieldDecl *Field) -> Expr * {
+    return MemberExpr::CreateImplicit(C, Base, /*IsArrow=*/false, Field,
+                                      Field->getType(), VK_LValue,
+                                      OK_Ordinary);
+  };
+  auto TagTest = [&](Expr *Place, const CircleChoice &Ch, unsigned Index,
+                     SourceLocation ArmLoc) -> Expr * {
+    Expr *Tag = FieldAccess(Place, Ch.Tag);
+    auto *Value = IntegerLiteral::Create(
+        C, llvm::APInt(C.getIntWidth(C.UnsignedIntTy), Index), C.UnsignedIntTy,
+        ArmLoc);
+    ExprResult Test = CreateBuiltinBinOp(ArmLoc, BO_EQ, Tag, Value);
+    return Test.isInvalid() ? nullptr : Test.get();
+  };
+
+  SmallVector<Stmt *, 4> BindingStmts;
+  bool GuardedBinding = false;
+  // The test a pattern makes against the place it matches. When `DoBind`, the
+  // statements that bind the names it introduces are appended, in the order the
+  // names appear: a name bound further in is read from the place the name
+  // around it left, so an outer binding's move happens first.
+  std::function<Expr *(Expr *, const CirclePattern &, SourceLocation, bool)>
+      BuildPattern = [&](Expr *Place, const CirclePattern &P,
+                         SourceLocation ArmLoc, bool DoBind) -> Expr * {
+    switch (P.K) {
+    case CirclePattern::CatchAll:
+      return new (C) CXXBoolLiteralExpr(true, C.BoolTy, ArmLoc);
+    case CirclePattern::Bind: {
+      if (DoBind && P.Binding) {
+        if (P.Binding->getType()->isDependentType())
+          P.Binding->setType(
+              C.getLValueReferenceType(Place->getType().getNonReferenceType()));
+        P.Binding->setInit(Place);
+        P.Binding->setInitStyle(VarDecl::CInit);
+        BindingStmts.push_back(
+            new (C) DeclStmt(DeclGroupRef(P.Binding), ArmLoc, ArmLoc));
+      }
+      if (P.Payload)
+        return BuildPattern(Place, *P.Payload, ArmLoc, DoBind);
+      return new (C) CXXBoolLiteralExpr(true, C.BoolTy, ArmLoc);
+    }
+    case CirclePattern::Tuple: {
+      QualType PlaceType =
+          Place->getType().getNonReferenceType().getUnqualifiedType();
+      CXXRecordDecl *Record =
+          IsCircleTupleType(PlaceType) ? PlaceType->getAsCXXRecordDecl()
+                                       : nullptr;
+      if (!Record || P.Elements.size() != Record->getNumFields())
+        return nullptr;
+      Expr *Test = new (C) CXXBoolLiteralExpr(true, C.BoolTy, ArmLoc);
+      for (unsigned I = 0; I != P.Elements.size(); ++I) {
+        Expr *Element =
+            FieldAccess(Place, *std::next(Record->field_begin(), I));
+        Expr *Part = BuildPattern(Element, *P.Elements[I], ArmLoc, DoBind);
+        if (!Part)
+          return nullptr;
+        ExprResult Both =
+            Test ? CreateBuiltinBinOp(ArmLoc, BO_LAnd, Test, Part)
+                 : ExprResult(Part);
+        if (Both.isInvalid())
+          return nullptr;
+        Test = Both.get();
+      }
+      return Test;
+    }
+    case CirclePattern::Bool: {
+      auto *Value = new (C) CXXBoolLiteralExpr(P.BoolValue, C.BoolTy, ArmLoc);
+      ExprResult Test = CreateBuiltinBinOp(ArmLoc, BO_EQ, Place, Value);
+      return Test.isInvalid() ? nullptr : Test.get();
+    }
+    case CirclePattern::Value:
+    case CirclePattern::Range: {
+      QualType ReadType =
+          Place->getType().getNonReferenceType().getUnqualifiedType();
+      if (ReadType->isDependentType() ||
+          ReadType->isInstantiationDependentType())
+        return nullptr;   // refused when the arm was parsed
+      Expr *Read = ImplicitCastExpr::Create(C, ReadType, CK_LValueToRValue,
+                                            Place, nullptr, VK_PRValue,
+                                            FPOptionsOverride());
+      // Keep the bound's original type. Builtin comparisons perform the usual
+      // promotions/conversions, exactly as `lo <= operand && operand < hi`.
+      auto Bound = [&](const llvm::APInt &Value, QualType Type) -> Expr * {
+        return IntegerLiteral::Create(
+            C, Value, Type, ArmLoc);
+      };
+      ExprResult Test;
+      if (P.K == CirclePattern::Value) {
+        Test = CreateBuiltinBinOp(ArmLoc, BO_EQ, Read, Bound(P.Low, P.LowType));
+      } else {
+        ExprResult Low = CreateBuiltinBinOp(
+            ArmLoc, P.LowInclusive ? BO_LE : BO_LT, Bound(P.Low, P.LowType), Read);
+        if (Low.isInvalid())
+          return nullptr;
+        ExprResult High = CreateBuiltinBinOp(
+            ArmLoc, P.HighInclusive ? BO_LE : BO_LT, Read, Bound(P.High, P.HighType));
+        if (High.isInvalid())
+          return nullptr;
+        Test = CreateBuiltinBinOp(ArmLoc, BO_LAnd, Low.get(), High.get());
+      }
+      return Test.isInvalid() ? nullptr : Test.get();
+    }
+    case CirclePattern::Or: {
+      Expr *Any = nullptr;
+      struct Branch { Expr *Test; std::map<VarDecl *, Expr *> Initializers; };
+      SmallVector<Branch, 4> Branches;
+      size_t Start = BindingStmts.size();
+      for (const auto &Alternative : P.Alternatives) {
+        Expr *Test = BuildPattern(Place, *Alternative, ArmLoc, DoBind);
+        if (!Test) return nullptr;
+        Branch B{Test, {}};
+        for (size_t I = Start; I < BindingStmts.size(); ++I)
+          for (Decl *D : cast<DeclStmt>(BindingStmts[I])->decls())
+            if (auto *VD = dyn_cast<VarDecl>(D)) B.Initializers[VD] = VD->getInit();
+        BindingStmts.resize(Start);
+        Branches.push_back(std::move(B));
+        ExprResult Both = Any ? CreateBuiltinBinOp(ArmLoc, BO_LOr, Any, Test) : ExprResult(Test);
+        if (Both.isInvalid()) return nullptr;
+        Any = Both.get();
+      }
+      if (DoBind && !Branches.empty())
+        for (auto [VD, Last] : Branches.back().Initializers) {
+          Expr *Init = Last;
+          for (unsigned I = Branches.size() - 1; I-- > 0;) {
+            Expr *Left = Branches[I].Initializers.at(VD);
+            Init = new (C) ConditionalOperator(Branches[I].Test, ArmLoc, Left,
+                ArmLoc, Init, Left->getType(), Left->getValueKind(), Left->getObjectKind());
+          }
+          VD->setInit(Init);
+          BindingStmts.push_back(new (C) DeclStmt(DeclGroupRef(VD), ArmLoc, ArmLoc));
+        }
+      return Any;
+    }
+    case CirclePattern::Alternative:
+      break;
+    }
+    CircleChoice Inner;
+    QualType PlaceType =
+        Place->getType().getNonReferenceType().getUnqualifiedType();
+    auto *PlaceRecord = PlaceType->getAsCXXRecordDecl();
+    if (!PlaceRecord || !describeChoice(PlaceRecord, Inner))
+      return nullptr;
+    unsigned Index = circleAlternativeIndex(Inner, P.Name);
+    if (Index == ~0u)
+      return nullptr;
+    Expr *Test = TagTest(Place, Inner, Index, ArmLoc);
+    if (!Test)
+      return nullptr;
+    FieldDecl *Field = Inner.payloadField(Index);
+    Expr *PayloadPlace =
+        Field ? FieldAccess(FieldAccess(Place, Inner.Payload), Field) : nullptr;
+    if (P.BindingName && !P.Binding)
+      return nullptr;   // reported when the arm was parsed
+    if (P.Binding && DoBind && PayloadPlace) {
+      // A name whose type was deferred — the alternatives were not known when
+      // the arm was parsed — takes the type of the payload it binds now.
+      if (P.Binding->getType()->isDependentType()) {
+        QualType Bound = P.Borrow ? C.getBorrowValueType(Field->getType())
+                                  : Field->getType();
+        P.Binding->setType(Bound);
+      }
+      ExprResult Init;
+      if (P.Borrow) {
+        const auto *Borrow = P.Binding->getType()->getAs<BorrowValueType>();
+        Init = UnaryOperator::Create(
+            C, PayloadPlace,
+            Borrow && Borrow->getPointeeType().isConstQualified()
+                ? UO_SharedBorrow
+                : UO_Borrow,
+            P.Binding->getType(), VK_PRValue, OK_Ordinary, ArmLoc,
+            /*CanOverflow=*/false, FPOptionsOverride());
+      } else if (RelocatePayloads && !GuardedBinding) {
+        // The pattern names an owned payload, not a watch of the referent.
+        // Relocating it here makes the method's receiver consumption visible
+        // to the checked-object classifier and runs the payload's relocation
+        // operator before the arm body.
+        QualType Bound = Field->getType();
+        P.Binding->setType(Bound);
+        Init = UnaryOperator::Create(
+            C, PayloadPlace, UO_Relocate, Bound, VK_PRValue, OK_Ordinary,
+            ArmLoc, /*CanOverflow=*/false, FPOptionsOverride());
+      } else {
+        // A plain pattern binding names the payload place. Relocation is
+        // explicit in the arm body (`rel x`), so binding must not consume the
+        // payload or run the bound value's destructor at the end of the arm.
+        QualType Bound = C.getLValueReferenceType(
+            PayloadPlace->getType().getNonReferenceType());
+        P.Binding->setType(Bound);
+        Init = PayloadPlace;
+      }
+      if (Init.isInvalid())
+        return nullptr;
+      P.Binding->setInit(Init.get());
+      P.Binding->setInitStyle(VarDecl::CInit);
+      BindingStmts.push_back(
+          new (C) DeclStmt(DeclGroupRef(P.Binding), ArmLoc, ArmLoc));
+    }
+    if (P.Payload && PayloadPlace) {
+      Expr *Nested = BuildPattern(PayloadPlace, *P.Payload, ArmLoc, DoBind);
+      if (!Nested)
+        return nullptr;
+      ExprResult Both = CreateBuiltinBinOp(ArmLoc, BO_LAnd, Test, Nested);
+      if (Both.isInvalid())
+        return nullptr;
+      return Both.get();
+    }
+    return Test;
+  };
+
+  ExprResult Chain;
+  SmallVector<Stmt *, 8> PreludeStmts;
+  for (unsigned I = State.Arms.size(); I-- > 0;) {
+    CircleMatchArm &Arm = State.Arms[I];
+    ExprResult Body = Arm.Body;
+    if (Body.isInvalid())
+      return ExprError();
+    if (!ResultType.isNull() && !Body.get()->getType()->isVoidType()) {
+      // Coerce a bottom-typed arm (a call that never returns) to the result
+      // type, as the language does for throw-expressions.
+      Body = PerformCopyInitialization(
+          InitializedEntity::InitializeTemporary(ResultType), Arm.Loc, Body);
+      if (Body.isInvalid())
+        return ExprError();
+    } else if (!ResultType.isNull() && Body.get()->getType()->isVoidType()) {
+      if (const auto *Call = dyn_cast<CallExpr>(Body.get()->IgnoreParenImpCasts()))
+        if (const FunctionDecl *Callee = Call->getDirectCallee();
+            Callee && Callee->isNoReturn())
+          Body.get()->setType(ResultType);
+      // A choice-arm shorthand (`=> .ok(value)`) is built as an aggregate
+      // initializer before the match result type is known. Give the arm its
+      // declared result type so the initializer writes that result rather
+      // than leaving a void-typed aggregate for CodeGen to recover.
+      if (Body.get()->getType()->isVoidType())
+        if (isa<InitListExpr>(Body.get()->IgnoreParenImpCasts()))
+          Body.get()->setType(ResultType);
+    }
+
+    BindingStmts.clear();
+    GuardedBinding = Arm.Guard != nullptr;
+    Expr *Test = nullptr;
+    bool CatchAllArm = false;
+    if (Arm.Pattern) {
+      bool PatternCatchAll = MatchesAnything(*Arm.Pattern);
+      CatchAllArm = PatternCatchAll && !Arm.Guard;
+      Test = BuildPattern(SubjectRef(), *Arm.Pattern, Arm.Loc,
+                          /*DoBind=*/true);
+      if (!PatternCatchAll && !Test)
+        return ExprError(Diag(Arm.Loc, getDiagnostics().getCustomDiagID(
+                                       DiagnosticsEngine::Error,
+                                       "match arm pattern cannot test this "
+                                       "operand")));
+    }
+    if (Arm.Guard) {
+      // Bind only after the structural test succeeds. The fallback remains
+      // inside the binding scope so a false guard can safely continue.
+      if (!Chain.isUsable())
+        return ExprError(Diag(Arm.Loc, getDiagnostics().getCustomDiagID(
+            DiagnosticsEngine::Error, "a guarded match arm requires a following fallback")));
+      QualType Common = ResultType.isNull() ? Body.get()->getType() : ResultType;
+      Body = new (C) ConditionalOperator(Arm.Guard, Arm.Loc, Body.get(), Arm.Loc,
+          Chain.get(), Common, Body.get()->getValueKind(), Body.get()->getObjectKind());
+    }
+
+    ExprResult ArmExpr;
+    if (!BindingStmts.empty()) {
+      SmallVector<Stmt *, 4> Stmts(BindingStmts.begin(), BindingStmts.end());
+      Stmts.push_back(Body.get());
+      auto *Block = CompoundStmt::Create(C, Stmts, FPOptionsOverride(),
+                                         Arm.Loc, Arm.Loc);
+      ArmExpr = new (C) StmtExpr(Block, Body.get()->getType(), Arm.Loc, Arm.Loc,
+                                 /*TemplateDepth=*/0);
+    } else
+      ArmExpr = Body;
+
+    if (!Chain.isUsable()) {
+      Chain = ArmExpr;
+      continue;
+    }
+    if (CatchAllArm)
+      return ExprError(Diag(Arm.Loc, getDiagnostics().getCustomDiagID(
+                                     DiagnosticsEngine::Error,
+                                     "catch-all match arm must come last")));
+    QualType Common = ResultType.isNull() ? ArmExpr.get()->getType() : ResultType;
+    Chain = new (C) ConditionalOperator(
+        Test, Arm.Loc, ArmExpr.get(), Arm.Loc, Chain.get(), Common,
+        ArmExpr.get()->getValueKind(), ArmExpr.get()->getObjectKind());
+  }
+  if (!Chain.isUsable())
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "match expression requires at least one arm")));
+
+  SmallVector<Stmt *, 2> Stmts;
+  Stmts.push_back(SubjectStmt);
+  Stmts.insert(Stmts.end(), PreludeStmts.begin(), PreludeStmts.end());
+  if (!HasCatchAll) {
+    // The arms are a chain of tests whose last arm stands in for a value that
+    // did not match, so a value no arm names would silently take that last arm.
+    // The tests are made again — without binding anything — to check that some
+    // arm runs, exactly as an out-of-range subscript faults.
+    Expr *Any = nullptr;
+    for (const CircleMatchArm &Arm : State.Arms) {
+      if (!Arm.Pattern || MatchesAnything(*Arm.Pattern))
+        continue;
+      Expr *Test = BuildPattern(SubjectRef(), *Arm.Pattern, Arm.Loc,
+                                /*DoBind=*/false);
+      if (!Test)
+        continue;
+      ExprResult Both =
+          Any ? CreateBuiltinBinOp(Loc, BO_LOr, Any, Test) : ExprResult(Test);
+      if (Both.isInvalid())
+        return ExprError();
+      Any = Both.get();
+    }
+    if (Any) {
+      auto *False = new (C) CXXBoolLiteralExpr(false, C.BoolTy, Loc);
+      ExprResult Missed = CreateBuiltinBinOp(Loc, BO_EQ, Any, False);
+      if (Missed.isInvalid())
+        return ExprError();
+      ExprResult Trap = BuildCircleIntrinsic(Loc, "__builtin_trap", {});
+      if (Trap.isInvalid())
+        return ExprError();
+      Stmts.push_back(IfStmt::Create(C, Loc, IfStatementKind::Ordinary, nullptr,
+                                     nullptr, Missed.get(), Loc, Loc,
+                                     Trap.get()));
+    }
+  }
+  Stmts.push_back(Chain.get());
+  auto *Block = CompoundStmt::Create(C, Stmts, FPOptionsOverride(), Loc, Loc);
+  return new (C) StmtExpr(Block, Chain.get()->getType(), Loc, Loc,
+                          /*TemplateDepth=*/0);
+}
+
+ExprResult Sema::ActOnCircleSafetyConstraint(SourceLocation Loc,
+                                             ExprResult E) {
+  // `safe(e)` is an expression trait: it is value-dependent until the call
+  // target is substituted, then asks whether the target carries a written
+  // safe effect. A resolved call to a checked-but-unsuffixed definition is
+  // still unsafe as a function value.
+  if (E.isInvalid())
+    return ExprError();
+  return ActOnExpressionTrait(ET_IsSafeExpr, Loc, E.get(), Loc);
+}
+
+/// Circle's `~string` trait: the spelling of a type, as a string literal.
+static ExprResult BuildCircleTypeNameString(Sema &S, SourceLocation Loc,
+                                            QualType T) {
+  ASTContext &C = S.Context;
+  if (T->isDependentType() || T->isInstantiationDependentType()) {
+    auto *Result = SYCLUniqueStableNameExpr::Create(
+        C, Loc, Loc, Loc, C.getTrivialTypeSourceInfo(T, Loc));
+    Result->setCircleTypeName();
+    return Result;
+  }
+  T = C.getCanonicalType(T);
+  std::string Spelling = T.getAsString(S.getPrintingPolicy());
+  QualType ArrayTy = C.getConstantArrayType(
+      C.CharTy, llvm::APInt(64, Spelling.size() + 1), nullptr,
+      ArraySizeModifier::Normal, 0);
+  return StringLiteral::Create(C, Spelling, StringLiteralKind::Ordinary,
+                               /*Pascal=*/false, ArrayTy, Loc);
+}
+
+ExprResult Sema::ActOnCircleStringFormat(SourceLocation Loc, Expr *Base,
+                                         ArrayRef<Expr *> Args) {
+  if (llvm::any_of(Args, [](const Expr *E) {
+        return E->isTypeDependent() || E->isValueDependent() ||
+               E->isInstantiationDependent();
+      })) {
+    // A compiler-owned deferred call keeps both format and typed operands in
+    // the AST. Instantiation rebuilds it into the concrete string literal
+    // before overload resolution on the enclosing expression.
+    auto EPI = FunctionProtoType::ExtProtoInfo();
+    EPI.ExtInfo = EPI.ExtInfo.withModuleSafe(true);
+    QualType FT = Context.getFunctionType(Context.DependentTy, {}, EPI);
+    auto *Fn = FunctionDecl::Create(Context, Context.getTranslationUnitDecl(),
+        Loc, Loc, &Context.Idents.get("__builtin_circle_deferred_format"), FT,
+        Context.getTrivialTypeSourceInfo(FT, Loc), SC_None);
+    Fn->setImplicit();
+    Fn->addAttr(AnnotateAttr::CreateImplicit(Context,
+        "safecpp.native.deferred.format", nullptr, 0));
+    auto *Callee = DeclRefExpr::Create(Context, NestedNameSpecifierLoc(),
+        SourceLocation(), Fn, false, Loc, FT, VK_LValue);
+    SmallVector<Expr *, 4> Operands{Base};
+    Operands.append(Args.begin(), Args.end());
+    return CallExpr::Create(Context, Callee, Operands, Context.DependentTy,
+        VK_PRValue, Loc, CurFPFeatureOverrides());
+  }
+  auto *Pattern = dyn_cast<StringLiteral>(Base->IgnoreParenImpCasts());
+  if (!Pattern || Pattern->getCharByteWidth() != 1)
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "format requires a narrow string literal")));
+  StringRef Text = Pattern->getString();
+  std::string Result;
+  unsigned Next = 0;
+  for (size_t I = 0; I < Text.size(); ++I) {
+    if (Text[I] != '{' || I + 1 >= Text.size() || Text[I + 1] != '}') {
+      Result += Text[I];
+      continue;
+    }
+    ++I;
+    if (Next >= Args.size())
+      return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                    DiagnosticsEngine::Error,
+                                    "format has more placeholders than arguments")));
+    Expr *Arg = Args[Next++]->IgnoreParenImpCasts();
+    if (auto *Literal = dyn_cast<StringLiteral>(Arg)) {
+      if (Literal->getCharByteWidth() != 1)
+        return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                      DiagnosticsEngine::Error,
+                                      "format argument must be a narrow string")));
+      Result += Literal->getString();
+      continue;
+    }
+    Expr::EvalResult Value;
+    QualType ArgTy = Arg->getType();
+    if (ArgTy->isIntegralOrEnumerationType() &&
+        Arg->EvaluateAsInt(Value, Context)) {
+      llvm::SmallString<32> Buffer;
+      llvm::APSInt(Value.Val.getInt(), ArgTy->isUnsignedIntegerType())
+          .toString(Buffer);
+      Result += Buffer.str().str();
+      continue;
+    }
+    if (ArgTy->isRealFloatingType() && Arg->EvaluateAsRValue(Value, Context)) {
+      llvm::SmallString<32> Buffer;
+      Value.Val.getFloat().toString(Buffer);
+      Result += Buffer.str().str();
+      continue;
+    }
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "format argument has no textual form")));
+  }
+  if (Next != Args.size())
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "format has more arguments than placeholders")));
+  QualType ArrayTy = Context.getConstantArrayType(
+      Context.CharTy, llvm::APInt(64, Result.size() + 1), nullptr,
+      ArraySizeModifier::Normal, 0);
+  return StringLiteral::Create(Context, Result, StringLiteralKind::Ordinary,
+                               /*Pascal=*/false, ArrayTy, Loc);
+}
+
+/// Whether a type is the compiler-provided `std2::string_constant<CharT>`.
+static QualType circleStringConstantElement(QualType T) {
+  if (T.isNull())
+    return QualType();
+  auto *Spec = dyn_cast_or_null<ClassTemplateSpecializationDecl>(
+      T.getNonReferenceType().getUnqualifiedType()->getAsCXXRecordDecl());
+  if (!Spec)
+    return QualType();
+  auto *Template = Spec->getSpecializedTemplate();
+  if (!Template || Template->getName() != "string_constant")
+    return QualType();
+  NamespaceDecl *NS =
+      dyn_cast_or_null<NamespaceDecl>(Template->getDeclContext());
+  while (NS && NS->isInlineNamespace())
+    NS = dyn_cast_or_null<NamespaceDecl>(NS->getDeclContext());
+  if (!NS || NS->getName() != "std2")
+    return QualType();
+  if (Spec->getTemplateArgs().size() != 1 ||
+      Spec->getTemplateArgs()[0].getKind() != TemplateArgument::Type)
+    return QualType();
+  return Spec->getTemplateArgs()[0].getAsType();
+}
+
+bool Sema::IsCircleStringConstantType(QualType Ty) {
+  return !circleStringConstantElement(Ty).isNull();
+}
+
+ExprResult Sema::BuildCircleStringConstant(SourceLocation Loc, QualType Type,
+                                           Expr *Literal) {
+  QualType CharT = circleStringConstantElement(Type);
+  if (CharT.isNull())
+    return ExprError();
+  auto *SL = dyn_cast<StringLiteral>(Literal->IgnoreParenImpCasts());
+  if (!SL)
+    return ExprError();
+  // The literal's characters become the slice the class holds. The class has
+  // no constructible form of its own, so the compiler forms the value: the
+  // class and its slice are the same single address-and-count aggregate.
+  if (CharT->isInstantiationDependentType())
+    return ExprError();
+  QualType SliceTy = Context.getCircleSliceType(Context.getConstType(CharT));
+  if (Context.circleSliceField(SliceTy, /*Count=*/false) == nullptr ||
+      Context.circleSliceField(SliceTy, /*Count=*/true) == nullptr)
+    return ExprError();
+  ExprResult Decayed = DefaultFunctionArrayLvalueConversion(SL);
+  if (Decayed.isInvalid())
+    return ExprError();
+  auto *Count = IntegerLiteral::Create(
+      Context,
+      llvm::APInt(Context.getIntWidth(Context.getSizeType()), SL->getLength()),
+      Context.getSizeType(), Loc);
+  SmallVector<Expr *, 2> Inits{Decayed.get(), Count};
+  auto *Slice = new (Context) InitListExpr(Context, Loc, Inits, Loc);
+  Slice->setType(SliceTy);
+  Slice->setValueKind(VK_PRValue);
+  auto *Syntactic = new (Context) InitListExpr(Context, Loc, Inits, Loc);
+  Slice->setSyntacticForm(Syntactic);
+  // The class and the slice it holds are the same address-and-count aggregate,
+  // so the compiler forms the value as that aggregate.
+  return ImplicitCastExpr::Create(Context, Type, CK_NoOp, Slice, nullptr,
+                                  VK_PRValue, FPOptionsOverride());
+}
+
+/// The slice a `string_constant<CharT>` holds. A class whose constructor takes
+/// the slice accepts the borrow through that constructor, so the checked model
+/// does not convert the slice into the class on its own.
+bool Sema::IsCircleStringConstantSlice(QualType Type, QualType Slice) {
+  QualType CharT = circleStringConstantElement(Type);
+  if (CharT.isNull() || CharT->isInstantiationDependentType())
+    return false;
+  // The element of a slice borrow is the slice's own element, so a borrow of
+  // the slice the class holds is the value of the class.
+  QualType Element = Context.circleSliceElement(Slice);
+  return !Element.isNull() && Element.isConstQualified() &&
+         Context.hasSameUnqualifiedType(Element, CharT);
+}
+
+ExprResult Sema::BuildCircleStringConstantFromSlice(SourceLocation Loc,
+                                                    QualType Type,
+                                                    Expr *Slice) {
+  QualType CharT = circleStringConstantElement(Type);
+  if (CharT.isNull() || CharT->isInstantiationDependentType())
+    return ExprError();
+  QualType SliceTy = Context.getCircleSliceType(Context.getConstType(CharT));
+  if (Context.circleSliceField(SliceTy, /*Count=*/false) == nullptr ||
+      Context.circleSliceField(SliceTy, /*Count=*/true) == nullptr)
+    return ExprError();
+  Expr *Value = Slice;
+  // A slice borrow names the record the class holds, so the value is the
+  // record it refers to; a slice record is already that value. The class and
+  // its slice are the same address-and-count aggregate, so the conversion
+  // adds nothing.
+  if (Slice->getType()->getAs<BorrowValueType>()) {
+    ExprResult Referent =
+        BuildUnaryOp(nullptr, Loc, UO_Deref, Slice, false, false);
+    if (Referent.isInvalid())
+      return ExprError();
+    ExprResult Loaded = DefaultLvalueConversion(Referent.get());
+    if (Loaded.isInvalid())
+      return ExprError();
+    Value = Loaded.get();
+  }
+  return ImplicitCastExpr::Create(Context, Type, CK_NoOp, Value, nullptr,
+                                  VK_PRValue, FPOptionsOverride());
+}
+
+/// The generated tuple record of a tuple type, or null.
+static CXXRecordDecl *circleTupleRecord(QualType T) {
+  if (T.isNull())
+    return nullptr;
+  auto *Record =
+      T.getNonReferenceType().getUnqualifiedType()->getAsCXXRecordDecl();
+  if (!Record)
+    return nullptr;
+  for (const auto *A : Record->specific_attrs<AnnotateAttr>())
+    if (A->isImplicit() && A->getAnnotation() == "safecpp.native.tuple")
+      return Record;
+  return nullptr;
+}
+
+static FieldDecl *circleTupleField(CXXRecordDecl *Record, unsigned Ordinal) {
+  if (!Record || !Record->hasDefinition())
+    return nullptr;
+  std::string Marker =
+      "safecpp.native.tuple.field:" + std::to_string(Ordinal);
+  for (FieldDecl *Field : Record->getDefinition()->fields())
+    for (const auto *A : Field->specific_attrs<AnnotateAttr>())
+      if (A->isImplicit() && A->getAnnotation() == Marker)
+        return Field;
+  return nullptr;
+}
+
+bool Sema::IsCircleTupleType(QualType Ty) {
+  return circleTupleRecord(Ty) != nullptr;
+}
+
+QualType Sema::getCircleTupleType(ArrayRef<QualType> Elements,
+                                  ArrayRef<TypeSourceInfo *> Infos) {
+  ASTContext &C = Context;
+  // Keep semantic identity separate from diagnostic spelling. Parameter names
+  // can repeat with different indices/depths, and punctuation in two distinct
+  // element types must not collapse to the same tuple record.
+  std::string Key, Signature;
+  llvm::raw_string_ostream Stream(Signature);
+  std::unique_ptr<ItaniumMangleContext> MC(
+      ItaniumMangleContext::create(C, C.getDiagnostics()));
+  for (QualType Element : Elements) {
+    QualType Canonical = C.getCanonicalType(Element);
+    // Canonical template type parameters are uniqued by depth/index, not by
+    // their declaration. Two independently declared packs named Args therefore
+    // look identical and would share one dependent tuple record, even though
+    // each pack belongs to a different template instantiation. Keep the
+    // declaration-bearing type in the cache key for dependent elements so each
+    // template can substitute its own pack; concrete tuples still merge through
+    // their canonical element types.
+    QualType KeyType =
+        Element->isDependentType() ? Element : Canonical;
+    Key += std::to_string(reinterpret_cast<uintptr_t>(KeyType.getAsOpaquePtr()));
+    Key += ';';
+    MC->mangleCanonicalTypeName(Canonical, Stream);
+    Stream << ';';
+  }
+  auto Found = C.CircleTupleTypes.find(Key);
+  if (Found != C.CircleTupleTypes.end()) return Found->second;
+  auto Digest = llvm::SHA256::hash(llvm::arrayRefFromStringRef(Signature));
+  std::string Name = "__circle_tuple_" + llvm::toHex(Digest, true);
+  // Load a reachable imported artifact before creating a local record. C++20
+  // named module declarations can otherwise remain lazily unread here.
+  auto Imported = C.getTranslationUnitDecl()->lookup(&C.Idents.get(Name));
+  // A lookup can deserialize the declaration before its RecordType has been
+  // registered in ASTContext::Types. Examine those declarations directly.
+  for (auto *D : Imported) {
+    auto *R = dyn_cast<CXXRecordDecl>(D);
+    if (!R || !R->hasDefinition()) continue;
+    bool Native = false;
+    for (const auto *A : R->specific_attrs<AnnotateAttr>())
+      Native |= A->isImplicit() && A->getAnnotation() == "safecpp.native.tuple";
+    if (!Native) continue;
+    unsigned Index = 0;
+    bool Equal = true;
+    for (auto *Field : R->getDefinition()->fields()) {
+      if (Index >= Elements.size() || !C.hasSameType(Field->getType(), Elements[Index])) {
+        Equal = false; break;
+      }
+      ++Index;
+    }
+    if (Equal && Index == Elements.size()) {
+      QualType Tuple = C.getCanonicalTagType(R);
+      C.CircleTupleTypes[Key] = Tuple;
+      return Tuple;
+    }
+  }
+  // Imported tuple records may already occur in function types while the
+  // context-local cache is empty. Reuse only the compiler-owned record with
+  // the exact canonical element sequence; do not create a second nominal type.
+  SmallVector<Type *, 128> Known(C.getTypes().begin(), C.getTypes().end());
+  for (Type *Type : Known) {
+    auto *RT = dyn_cast<RecordType>(Type);
+    auto *R = RT ? dyn_cast<CXXRecordDecl>(RT->getDecl()) : nullptr;
+    if (!R || R->getName() != Name || !R->hasDefinition()) continue;
+    bool Native = false;
+    for (const auto *A : R->specific_attrs<AnnotateAttr>())
+      Native |= A->isImplicit() && A->getAnnotation() == "safecpp.native.tuple";
+    if (!Native) continue;
+    unsigned Index = 0;
+    bool Equal = true;
+    for (auto *Field : R->getDefinition()->fields()) {
+      if (Index >= Elements.size() || !C.hasSameType(Field->getType(), Elements[Index])) {
+        Equal = false; break;
+      }
+      ++Index;
+    }
+    if (Equal && Index == Elements.size()) {
+      QualType Tuple = C.getCanonicalTagType(R);
+      C.CircleTupleTypes[Key] = Tuple;
+      return Tuple;
+    }
+  }
+  SourceLocation Loc;
+  auto *Record = CXXRecordDecl::Create(C, TagTypeKind::Struct,
+                                       C.getTranslationUnitDecl(), Loc, Loc,
+                                       &C.Idents.get(Name));
+  Record->setImplicit();
+  // A compiler tuple is one structural type across translation units, not a
+  // source entity private to whichever named module first requests it.
+  if (Record->hasOwningModule()) Record->setLocalOwningModule(nullptr);
+  Record->setModuleOwnershipKind(Decl::ModuleOwnershipKind::Unowned);
+  Record->setLexicalDeclContext(C.getTranslationUnitDecl());
+  Record->addAttr(
+      AnnotateAttr::CreateImplicit(C, "safecpp.native.tuple", nullptr, 0));
+  if (llvm::any_of(Elements, [](QualType T) { return T->isDependentType(); }))
+    Record->addAttr(AnnotateAttr::CreateImplicit(
+        C, "safecpp.native.tuple.dependent", nullptr, 0));
+  Record->startDefinition();
+  for (unsigned I = 0; I < Elements.size(); ++I) {
+    std::string FieldName = "__" + std::to_string(I);
+    TypeSourceInfo *TSI = I < Infos.size() && Infos[I]
+                              ? Infos[I]
+                              : C.getTrivialTypeSourceInfo(Elements[I], Loc);
+    QualType FieldType = Elements[I];
+    if (FieldType->isDependentType())
+      FieldType = C.getCanonicalType(FieldType);
+    FieldDecl *Field = FieldDecl::Create(C, Record, Loc, Loc,
+                                         &C.Idents.get(FieldName), FieldType,
+                                         TSI, nullptr, /*Mutable=*/false,
+                                         ICIS_NoInit);
+    Field->setImplicit();
+    Field->setAccess(AS_public);
+    if (Field->hasOwningModule()) Field->setLocalOwningModule(nullptr);
+    Field->setModuleOwnershipKind(Decl::ModuleOwnershipKind::Unowned);
+    Field->addAttr(AnnotateAttr::CreateImplicit(
+        C, "safecpp.native.tuple.field:" + std::to_string(I), nullptr, 0));
+    Record->addDecl(Field);
+  }
+  Record->completeDefinition();
+  // Circle tuples are synthesized outside ActOnFields, so the checked ABI
+  // marker that normally makes a by-value record's parameter cleanup belong
+  // to the callee is not installed by class completion. Without it a tuple
+  // temporary moved into a by-value parameter is also destroyed by its
+  // caller, which double-drops every owning element.
+  if (getLangOpts().ModuleSafetySafe || getLangOpts().ModuleSafetyUnsafe)
+    Record->setParamDestroyedInCallee(true);
+  // Make the implicit declaration discoverable to PCM's normal declaration
+  // merging, including when a local tuple type is parsed before an imported
+  // function's return type is lazily deserialized.
+  C.getTranslationUnitDecl()->addDecl(Record);
+  QualType Tuple = C.getCanonicalTagType(Record);
+  C.CircleTupleTypes[Key] = Tuple;
+  return Tuple;
+}
+
+ExprResult Sema::ActOnCircleTupleValue(SourceLocation Loc, QualType Type,
+                                       ArrayRef<Expr *> Elements) {
+  CXXRecordDecl *Record = circleTupleRecord(Type);
+  if (!Record)
+    return ExprError();
+  SmallVector<Expr *, 4> Inits;
+  for (unsigned I = 0; I < Elements.size(); ++I) {
+    FieldDecl *Field = circleTupleField(Record, I);
+    if (!Field)
+      return ExprError();
+    ExprResult Converted = PerformCopyInitialization(
+        InitializedEntity::InitializeTemporary(Field->getType()), Loc,
+        Elements[I]);
+    if (Converted.isInvalid())
+      return ExprError();
+    Inits.push_back(Converted.get());
+  }
+  auto *Result = new (Context) InitListExpr(Context, Loc, Inits, Loc);
+  Result->setType(Type);
+  Result->setValueKind(VK_PRValue);
+  auto *Syntactic = new (Context) InitListExpr(Context, Loc, Inits, Loc);
+  Result->setSyntacticForm(Syntactic);
+  // A tuple literal is a typed expression, not a braced-init-list. Keep the
+  // semantic aggregate behind an explicit cast so auto/template deduction
+  // uses the tuple type rather than C++ initializer_list deduction rules.
+  return CXXFunctionalCastExpr::Create(Context, Type, VK_PRValue,
+      Context.getTrivialTypeSourceInfo(Type, Loc), CK_NoOp, Result, nullptr,
+      FPOptionsOverride(), Loc, Loc);
+}
+
+ExprResult Sema::ActOnCircleTupleSplat(SourceLocation Loc, Expr *Base) {
+  if (!Base->isTypeDependent() && !IsCircleTupleType(Base->getType()))
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+        DiagnosticsEngine::Error, "whole tuple projection requires a tuple value")));
+  auto *Result = new (Context) ParenExpr(Loc, Base->getEndLoc(), Base);
+  Result->setCircleTupleSplat(true);
+  return Result;
+}
+
+ExprResult Sema::ActOnCircleTupleMember(SourceLocation Loc, Expr *Base,
+                                        unsigned Ordinal) {
+  if (Base->isTypeDependent()) {
+    CXXScopeSpec SS;
+    auto Name = DeclarationNameInfo(&Context.Idents.get("__" + std::to_string(Ordinal)), Loc);
+    return BuildMemberReferenceExpr(Base, Base->getType(), Loc, false, SS,
+        SourceLocation(), nullptr, Name, nullptr, nullptr);
+  }
+  CXXRecordDecl *Record = circleTupleRecord(Base->getType());
+  if (!Record)
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "tuple element access requires a tuple value")));
+  FieldDecl *Field = circleTupleField(Record, Ordinal);
+  if (!Field)
+    return ExprError(Diag(Loc, getDiagnostics().getCustomDiagID(
+                                  DiagnosticsEngine::Error,
+                                  "tuple element index is out of range")));
+  ExprResult Place = Base;
+  if (!Place.get()->isGLValue()) {
+    Place = MaybeBindToTemporary(Place.get());
+    if (Place.isInvalid())
+      return ExprError();
+  }
+  return MemberExpr::CreateImplicit(Context, Place.get(), /*IsArrow=*/false,
+                                    Field, Field->getType(), VK_LValue,
+                                    OK_Ordinary);
+}
+
+ExprResult Sema::ActOnCircleTupledCall(Scope *S, Expr *Fn,
+                                       SourceLocation LParenLoc,
+                                       ArrayRef<Expr *> Args,
+                                       SourceLocation RParenLoc) {
+  // `f.(args...)` spreads the tuple its single argument names: the elements of
+  // a generated tuple record become the call's arguments in element order, as
+  // if they had been written out. A parenthesized list of several arguments is
+  // a call with those arguments, as it is anywhere else.
+  if (Args.size() == 1 && !Args[0]->isTypeDependent() &&
+      IsCircleTupleType(Args[0]->getType())) {
+    CXXRecordDecl *Record = circleTupleRecord(Args[0]->getType());
+    ExprResult Tuple = Args[0];
+    Expr *Operand = Tuple.get()->IgnoreImplicit();
+    bool RelocateElements = false;
+    if (auto *U = dyn_cast<UnaryOperator>(Operand); U && U->getOpcode() == UO_Relocate) {
+      RelocateElements = true;
+      Tuple = U->getSubExpr();
+    }
+    if (!Tuple.get()->isGLValue()) {
+      Tuple = MaybeBindToTemporary(Tuple.get());
+      if (Tuple.isInvalid())
+        return ExprError();
+    }
+    // Bind the tuple expression once. Reusing the same AST node as the base
+    // of every member access does not imply one evaluation in CodeGen.
+    auto *Value = new (Context) OpaqueValueExpr(
+        LParenLoc, Tuple.get()->getType(), Tuple.get()->getValueKind(),
+        Tuple.get()->getObjectKind(), Tuple.get());
+    SmallVector<Expr *, 4> Elements;
+    for (unsigned I = 0;; ++I) {
+      FieldDecl *Field = circleTupleField(Record, I);
+      if (!Field)
+        break;
+      Expr *Element = MemberExpr::CreateImplicit(
+          Context, Value, /*IsArrow=*/false, Field, Field->getType(),
+          VK_LValue, OK_Ordinary);
+      ExprResult Read = RelocateElements
+          ? BuildUnaryOp(S, LParenLoc, UO_Relocate, Element)
+          : DefaultLvalueConversion(Element);
+      if (Read.isInvalid())
+        return ExprError();
+      Elements.push_back(Read.get());
+    }
+    ExprResult Call = ActOnCallExpr(S, Fn, LParenLoc, Elements, RParenLoc);
+    if (Call.isInvalid()) return ExprError();
+    return PseudoObjectExpr::Create(Context, Call.get(), {Value, Call.get()}, 1);
+  }
+  SmallVector<Expr *, 4> Passed(Args.begin(), Args.end());
+  return ActOnCallExpr(S, Fn, LParenLoc, Passed, RParenLoc);
+}
+
+ExprResult Sema::ActOnCircleImplQueryExpr(SourceLocation Loc,
+                                          ParsedType Target,
+                                          ParsedType Interface,
+                                          SourceLocation EndLoc) {
+  QualType T = GetTypeFromParser(Target);
+  QualType I = GetTypeFromParser(Interface);
+  if (T.isNull() || I.isNull())
+    return ExprError();
+
+  // `send` and `sync` are Circle's builtin thread-safety interfaces. Their
+  // value follows the same element/contract rules as the postfix
+  // `~is_send` / `~is_sync` trait, with the stricter pointer/reference rule
+  // from the interface: a legacy pointer or reference is transferable only
+  // when it names a function.
+  if (const auto *Record = I->getAsCXXRecordDecl()) {
+    llvm::StringRef Name = Record->getName();
+    if (Name == "send" || Name == "sync") {
+      bool Sync = Name == "sync";
+      auto Check = [&](auto &&Self, QualType Type, bool Sharing) -> bool {
+        if (Type.isNull() || Type->isDependentType())
+          return false;
+        if (const auto *Borrow = Type->getAs<BorrowValueType>()) {
+          bool Shared = Borrow->getPointeeType().isConstQualified() ||
+                        Context.circleBorrowIsShared(Borrow);
+          return Self(Self, Borrow->getPointeeType(), Sharing || Shared);
+        }
+        if (Type->isReferenceType())
+          return Type->getPointeeType()->isFunctionType();
+        if (Type->isPointerType())
+          return Type->getPointeeType()->isFunctionType();
+        if (const auto *Array = Context.getAsArrayType(Type))
+          return Self(Self, Array->getElementType(), Sharing);
+        if (const auto *Slice = Type->getAs<NativeSliceType>())
+          return Self(Self, Slice->getElementType(), Sharing);
+        if (QualType Element = Context.circleSliceElement(Type);
+            !Element.isNull())
+          return Self(Self, Element, Sharing);
+        ExprResult Trait = ActOnTypeTrait(
+            Sharing ? UTT_IsSync : UTT_IsSend, Loc,
+            {ParsedType::make(Type)}, Loc);
+        if (Trait.isInvalid())
+          return false;
+        bool Value = false;
+        return Trait.get()->EvaluateAsBooleanCondition(Value, Context) &&
+               Value;
+      };
+      bool Supported = Check(Check, T, Sync);
+      return IntegerLiteral::Create(Context, llvm::APInt(1, Supported),
+                                    Context.BoolTy, Loc);
+    }
+  }
+
+  bool Implemented = getCircleImplementation(T, I, Loc) != nullptr;
+  return IntegerLiteral::Create(Context, llvm::APInt(1, Implemented),
+                                Context.BoolTy, Loc);
+}
+
+ExprResult Sema::ActOnCircleTypeTrait(SourceLocation OpLoc, ParsedType Ty,
+                                      IdentifierInfo *Name,
+                                      SourceLocation NameLoc) {
+  QualType T = GetTypeFromParser(Ty);
+  if (T.isNull())
+    return ExprError();
+  llvm::StringRef Trait = Name->getName();
+  if (Trait == "string")
+    return BuildCircleTypeNameString(*this, NameLoc, T);
+  if (Trait == "is_trivially_destructible")
+    return ActOnTypeTrait(UTT_IsTriviallyDestructible, NameLoc,
+                          {ParsedType::make(T)}, NameLoc);
+  if (Trait == "is_trivially_copyable")
+    return ActOnTypeTrait(UTT_IsTriviallyCopyable, NameLoc, {ParsedType::make(T)},
+                          NameLoc);
+  // Send and sync require a validated thread contract. Types that name one are
+  // recognized by the module checker's annotation, not by this trait, so an
+  // unannotated operand is not thread-safe.
+  if (Trait == "is_send")
+    return ActOnTypeTrait(UTT_IsSend, NameLoc, {ParsedType::make(T)}, NameLoc);
+  if (Trait == "is_sync")
+    return ActOnTypeTrait(UTT_IsSync, NameLoc, {ParsedType::make(T)}, NameLoc);
+  Diag(NameLoc, getDiagnostics().getCustomDiagID(
+                    DiagnosticsEngine::Error,
+                    "unknown native type trait '%0'"))
+      << Name;
+  return ExprError();
+}
+
+bool Sema::isQualifiedMemberAccess(Expr *E) {
+  if (DeclRefExpr *DRE = dyn_cast<DeclRefExpr>(E)) {
+    if (!DRE->getQualifier())
+      return false;
+
+    ValueDecl *VD = DRE->getDecl();
+    if (!VD->isCXXClassMember())
+      return false;
+
+    if (isa<FieldDecl>(VD) || isa<IndirectFieldDecl>(VD))
+      return true;
+    if (CXXMethodDecl *Method = dyn_cast<CXXMethodDecl>(VD))
+      return Method->isImplicitObjectMemberFunction();
+
+    return false;
+  }
+
+  if (UnresolvedLookupExpr *ULE = dyn_cast<UnresolvedLookupExpr>(E)) {
+    if (!ULE->getQualifier())
+      return false;
+
+    for (NamedDecl *D : ULE->decls()) {
+      if (CXXMethodDecl *Method = dyn_cast<CXXMethodDecl>(D)) {
+        if (Method->isImplicitObjectMemberFunction())
+          return true;
+      } else {
+        // Overload set does not contain methods.
+        break;
+      }
+    }
+
+    return false;
+  }
+
+  return false;
+}
+
+ExprResult Sema::BuildUnaryOp(Scope *S, SourceLocation OpLoc,
+                              UnaryOperatorKind Opc, Expr *Input,
+                              bool IsAfterAmp,
+                              bool AllowBorrowedOperatorStar) {
+  // A native slice names its own elements, so `*slice` is the slice place.
+  if (Opc == UO_Deref && !Input->isTypeDependent() &&
+      Input->getType()->getAs<NativeSliceType>())
+    return Input;
+  if (Opc == UO_Deref && !Input->isTypeDependent() &&
+      !Context.circleSliceElement(Input->getType()).isNull())
+    return Input;
+  if (Opc == UO_Deref)
+    if (const auto *Borrow = Input->getType()->getAs<BorrowValueType>()) {
+      // A borrow of a slice carries the element address and count as the
+      // generated record, so the dereference names that value rather than an
+      // object reached through a pointer.
+      // Only a pointee that is itself the generated record is the pair; a
+      // borrow of a *borrow* names the handle's storage, which the ordinary
+      // pointer path below reaches.
+      if (Context.isCircleSliceRecord(Borrow->getPointeeType()))
+        return UnaryOperator::Create(Context, Input, Opc,
+                                     Borrow->getPointeeType(), VK_LValue,
+                                     OK_Ordinary, OpLoc, false,
+                                     CurFPFeatureOverrides());
+      // The referent is reached through an ordinary pointer, so constant
+      // evaluation and code generation agree on the access.
+      QualType Pointer = Context.getPointerType(Borrow->getPointeeType());
+      Expr *Borrowed = Input;
+      // The borrow is read for the address it carries, exactly as a pointer
+      // is: the referent is reached from the value, not from the borrow's own
+      // storage, and the value is what the access needs.
+      if (Borrowed->isGLValue())
+        Borrowed = ImplicitCastExpr::Create(
+            Context, Borrowed->getType().getNonReferenceType(),
+            CK_LValueToRValue, Borrowed, nullptr, VK_PRValue,
+            FPOptionsOverride());
+      Expr *Address = ImplicitCastExpr::Create(
+          Context, Pointer, CK_BitCast, Borrowed, nullptr, VK_PRValue,
+          FPOptionsOverride());
+      Expr *Referent = UnaryOperator::Create(
+          Context, Address, Opc, Borrow->getPointeeType(), VK_LValue,
+          OK_Ordinary, OpLoc, false, CurFPFeatureOverrides());
+      // A dereference of a borrow whose referent is a class with a unary
+      // `operator*` applies that operator to the referent. This is what lets
+      // `*box_borrow` and `**nested_box` name the boxed value while
+      // `*int_borrow` remains an ordinary pointer dereference.
+      if (auto *Record = Borrow->getPointeeType()->getAsCXXRecordDecl()) {
+        bool HasStar = false;
+        for (auto *Method : Record->methods())
+          HasStar |= Method->getOverloadedOperator() == OO_Star &&
+                     !Method->isDeleted();
+        if (S && HasStar && AllowBorrowedOperatorStar) {
+          UnresolvedSet<16> Functions;
+          if (S)
+            LookupOverloadedOperatorName(OO_Star, S, Functions);
+          return CreateOverloadedUnaryOp(OpLoc, Opc, Functions, Referent,
+                                         /*RequiresADL=*/true,
+                                         /*SuppressProjection=*/true);
+        }
+      }
+      return Referent;
+    }
+  if (Opc == UO_Deref && !Input->isTypeDependent())
+    if (const auto *Ref = Context.getReferenceQualifiedType(Input)
+                              ->getAs<ReferenceType>();
+        Ref && Ref->isSafetyBorrow())
+      return UnaryOperator::Create(Context, Input, Opc, Input->getType(),
+                                   VK_LValue, OK_Ordinary, OpLoc, false,
+                                   CurFPFeatureOverrides());
+  if (Opc == UO_Relocate) {
+    // A place whose type is still a template parameter has no ownership to
+    // judge yet: the relocation is checked when the template is instantiated,
+    // exactly as the other checked operations defer it.
+    if (!Input->isTypeDependent() && !Input->isInstantiationDependent() &&
+        !Input->getType()->isInstantiationDependentType()) {
+      const Expr *Place = Input->IgnoreParens();
+      // A choice records which alternative it holds in a tag, so moving the
+      // active alternative out of the generated storage is well defined: that
+      // is what a match binding does. The markers are compiler-reserved, and
+      // instantiating a choice template recreates them without the implicit
+      // flag, so the annotation text alone decides.
+      auto Marked = [](const Decl *D, llvm::StringRef Marker) {
+        for (const auto *A : D->specific_attrs<AnnotateAttr>())
+          if (A->getAnnotation() == Marker)
+            return true;
+        return false;
+      };
+      auto SourcePlace = [](const Expr *E) {
+        for (;;) {
+          E = E->IgnoreParens();
+          if (auto *V = dyn_cast<OpaqueValueExpr>(E); V && V->getSourceExpr()) E = V->getSourceExpr();
+          else return E;
+        }
+      };
+      Place = SourcePlace(Place);
+      while (auto *Member = dyn_cast<MemberExpr>(Place)) {
+        auto *Field = dyn_cast<FieldDecl>(Member->getMemberDecl());
+        auto *Record = Member->getBase()->getType()->getAsCXXRecordDecl();
+        if (Member->isArrow() || !Field || Field->getType()->isReferenceType() ||
+            Field->isBitField() || !Record ||
+            (!annotatedWith(Record, "safecpp.unsafe.moved.drop") &&
+             !Marked(Record, "safecpp.native.choice") &&
+             !Marked(Record, "safecpp.native.choice.storage") &&
+             (Record->hasUserDeclaredDestructor() ||
+            Record->getNumBases() || Record->isUnion() || Field->hasAttr<NoUniqueAddressAttr>()))) {
+          unsigned ID = Diags.getCustomDiagID(DiagnosticsEngine::Error,
+              "module-safety: partial relocation requires an owned path "
+              "without custom drop or bases");
+          return ExprError(Diag(OpLoc, ID));
+        }
+        Place = SourcePlace(Member->getBase());
+      }
+      auto *Ref = dyn_cast<DeclRefExpr>(Place);
+      auto *Owner = Ref ? dyn_cast<VarDecl>(Ref->getDecl()) : nullptr;
+      bool Captured = Ref && Ref->refersToEnclosingVariableOrCapture();
+      QualType T = Input->getType();
+      if (T->isRecordType() &&
+          RequireCompleteType(OpLoc, T, diag::err_typecheck_unary_expr))
+        return ExprError();
+      bool Scalar = T->isIntegralOrEnumerationType() || T->isRealFloatingType() ||
+                    T->isPointerType() || T->isMemberPointerType() ||
+                    isa<BorrowValueType>(T.getCanonicalType());
+      auto *OwnerRecord = Owner ? Owner->getType()->getAsCXXRecordDecl() : nullptr;
+      bool OwnsParameter = Scalar ||
+          (OwnerRecord && OwnerRecord->hasTrivialDestructor()) ||
+          // A checked by-value parameter names an owned copy in the callee.
+          // The C++ ABI may choose caller-side destruction for non-trivial
+          // records, but that does not make the parameter borrowed. Limit
+          // this to parameters of checked functions: a legacy `unsafe_fn`
+          // parameter keeps its caller-destroyed C++ ABI and cannot be
+          // relocated by the callee.
+          (isa_and_nonnull<ParmVarDecl>(Owner) &&
+           !Owner->getType()->isReferenceType() &&
+           !Owner->getType()->getAs<BorrowValueType>() &&
+           [&] {
+             const auto *FD = dyn_cast_or_null<FunctionDecl>(
+                 Owner->getParentFunctionOrMethod());
+             const auto *Proto =
+                 FD ? FD->getType()->getAs<FunctionProtoType>() : nullptr;
+             return Proto && Proto->getExtInfo().getModuleSafe();
+           }());
+      if (auto *R = T->getAsCXXRecordDecl()) {
+        // Materialize implicit move/copy declarations before the shared policy
+        // chooses its legacy fallback. Nested records use the same preparation.
+        llvm::SmallPtrSet<CXXRecordDecl *, 16> Seen;
+        auto Prepare = [&](auto &&Self, QualType Q) -> void {
+          Q = Context.getBaseElementType(Q);
+          auto *Record = Q->getAsCXXRecordDecl();
+          if (!Record || !Record->hasDefinition() || !Seen.insert(Record).second) return;
+          ForceDeclarationOfImplicitMembers(Record);
+          for (const auto &Base : Record->bases()) Self(Self, Base.getType());
+          for (auto *Field : Record->fields())
+            if (!circleRelocationMarked(Field, "safecpp.native.phantom"))
+              Self(Self, Field->getType());
+        };
+        Prepare(Prepare, T);
+        CircleRelocationQuery Query(Context);
+        auto Plan = Query.get(T);
+        if (Plan.Kind == CircleRelocationKind::Deleted) {
+          if (isSFINAEContext())
+            return ExprError(Diag(OpLoc, diag::err_typecheck_unary_expr) << T);
+          return ExprError(Diag(OpLoc, Diags.getCustomDiagID(DiagnosticsEngine::Error,
+              "module-safety: relocation is deleted for this type or a subobject")));
+        }
+        llvm::SmallPtrSet<const Type *, 32> Checked;
+        auto Check = [&](auto &&Self, QualType Q) -> bool {
+          Q = Context.getBaseElementType(Q);
+          if (!Checked.insert(Q.getCanonicalType().getTypePtr()).second) return false;
+          auto P = Query.get(Q);
+          if (P.Method) {
+            OpaqueValueExpr Object(OpLoc, Q, VK_LValue);
+            if (CheckMemberOperatorAccess(OpLoc, &Object, SourceRange(OpLoc),
+                DeclAccessPair::make(P.Method, P.Method->getAccess())) == AR_inaccessible) return true;
+            MarkFunctionReferenced(OpLoc, P.Method);
+            if (P.Kind == CircleRelocationKind::Move)
+              if (auto *Dtor = P.Method->getParent()->getDestructor()) {
+                if (CheckMemberOperatorAccess(OpLoc, &Object, SourceRange(OpLoc),
+                    DeclAccessPair::make(Dtor, Dtor->getAccess())) == AR_inaccessible) return true;
+                MarkFunctionReferenced(OpLoc, Dtor);
+              }
+          }
+          if (P.Kind == CircleRelocationKind::Memberwise || P.Kind == CircleRelocationKind::Choice)
+            if (auto *Record = Q->getAsCXXRecordDecl()) {
+              for (const auto &Base : Record->bases()) if (Self(Self, Base.getType())) return true;
+              for (auto *Field : Record->fields()) {
+                if (circleRelocationMarked(Field, "safecpp.native.phantom")) continue;
+                if (P.Kind == CircleRelocationKind::Choice &&
+                    circleRelocationMarked(Field, "safecpp.native.choice.payload")) {
+                  for (auto *F : Field->getType()->getAsRecordDecl()->fields())
+                    if (Self(Self, F->getType())) return true;
+                } else if (Self(Self, Field->getType())) return true;
+              }
+            }
+          return false;
+        };
+        if (Check(Check, T)) return ExprError();
+        (void)R;
+      }
+      bool RequirementParameter = Owner && isUnevaluatedContext() &&
+          isa<ParmVarDecl>(Owner) &&
+          isa<RequiresExprBodyDecl>(Owner->getDeclContext());
+      if (!Owner || Captured || Owner->isInitCapture() ||
+          (isa<ParmVarDecl>(Owner) && !OwnsParameter && !RequirementParameter) ||
+          (!RequirementParameter && (!Owner->hasLocalStorage() ||
+           Owner->getDeclContext() != getCurFunctionDecl())) ||
+          Owner->getType()->isReferenceType() || !Input->isLValue() ||
+          (!T->isRecordType() && !Scalar) || T.isConstQualified() || T.isVolatileQualified()) {
+        if (RequirementParameter)
+          return ExprError(Diag(OpLoc, diag::err_typecheck_unary_expr)
+                           << T);
+        unsigned ID = Diags.getCustomDiagID(DiagnosticsEngine::Error,
+            "module-safety: relocation requires a local owning record variable");
+        return ExprError(Diag(OpLoc, ID));
+      }
+    }
+    auto *Result = UnaryOperator::Create(Context, Input, Opc,
+        Input->getType(), VK_PRValue, OK_Ordinary, OpLoc, false,
+        CurFPFeatureOverrides());
+    return Input->isTypeDependent() ? ExprResult(Result) : MaybeBindToTemporary(Result);
+  }
+  if (Opc == UO_Borrow || Opc == UO_SharedBorrow) {
+    if (getLangOpts().CircleBorrowValues && !Input->isTypeDependent() &&
+        Input->getType()->getAs<BorrowValueType>()) {
+      // A borrow value is an address-and-count handle, so `^handle` borrows the
+      // storage that handle occupies: the handle's own place, reached exactly
+      // as any other object's borrow is. Reading through it yields the handle.
+      QualType Handle = Input->getType();
+      if (Opc == UO_SharedBorrow)
+        Handle = Handle.withConst();
+      return UnaryOperator::Create(
+          Context, Input, Opc, Context.getBorrowValueType(Handle), VK_PRValue,
+          OK_Ordinary, OpLoc, false, CurFPFeatureOverrides());
+    }
+    if (Input->getType()->isPlaceholderType()) {
+      unsigned ID = Diags.getCustomDiagID(DiagnosticsEngine::Error,
+          "module-safety: borrow operand must name a resolved owner");
+      return ExprError(Diag(OpLoc, ID));
+    }
+    // A slice value is its own place: `__slice_pointer` forms the
+    // address-and-count pair that the borrow carries, so borrowing it is the
+    // slice borrow itself rather than a borrow of a temporary record.
+    if (!Input->isTypeDependent() &&
+        !Context.circleSliceElement(Input->getType()).isNull()) {
+      QualType Pointee = Input->getType();
+      if (Opc == UO_SharedBorrow) Pointee = Pointee.withConst();
+      QualType Borrow =
+          getLangOpts().CircleBorrowValues
+              ? Context.getBorrowValueType(Pointee)
+              : Context.getLValueReferenceType(Pointee, /*SpelledAsLValue=*/false,
+                                               /*SafetyBorrow=*/true);
+      return UnaryOperator::Create(Context, Input, Opc, Borrow, VK_PRValue,
+                                   OK_Ordinary, OpLoc, false,
+                                   CurFPFeatureOverrides());
+    }
+    // An xvalue still names object storage: a temporary selected by the
+    // implicit borrow conversion, or a subobject of one, is addressable for
+    // the duration the borrow is used. Only a pure value has no place to
+    // borrow.
+    if (!Input->isTypeDependent() && !Input->isGLValue() &&
+        Input->getType()->isRecordType()) {
+      // A temporary record names storage for the duration of the full
+      // expression. Materialize it so `^lock()` can borrow the temporary
+      // guard before it is used by the following member call.
+      ExprResult Bound = MaybeBindToTemporary(Input);
+      if (Bound.isInvalid())
+        return ExprError();
+      Input = CreateMaterializeTemporaryExpr(Input->getType(), Bound.get(),
+                                             /*BoundToLvalueReference=*/true);
+    }
+    if (!Input->isTypeDependent() &&
+        (!Input->isGLValue() || Input->getObjectKind() != OK_Ordinary)) {
+      unsigned ID = Diags.getCustomDiagID(DiagnosticsEngine::Error,
+          "module-safety: borrow operand must be an addressable lvalue owner");
+      return ExprError(Diag(OpLoc, ID));
+    }
+    QualType T = Input->getType();
+    if (Opc == UO_SharedBorrow) T = T.withConst();
+    if (const auto *Slice = T->getAs<NativeSliceType>()) {
+      QualType Element = Slice->getElementType();
+      if (T.isConstQualified())
+        Element = Context.getConstType(Element);
+      // A slice whose element is not known yet has no record to name, so the
+      // borrow stays a borrow of the native slice; the substitution maps it to
+      // the generated record once the element is concrete, exactly as the
+      // declarator path does.
+      QualType Pointee = Context.getCircleSliceType(Element);
+      if (Element->isInstantiationDependentType())
+        Pointee = Context.getNativeSliceType(Element);
+      QualType Borrow =
+          getLangOpts().CircleBorrowValues
+              ? Context.getBorrowValueType(Pointee)
+              : Context.getLValueReferenceType(Pointee, /*SpelledAsLValue=*/false,
+                                               /*SafetyBorrow=*/true);
+      return UnaryOperator::Create(Context, Input, Opc, Borrow, VK_PRValue,
+                                   OK_Ordinary, OpLoc, false,
+                                   CurFPFeatureOverrides());
+    }
+    if (getLangOpts().CircleBorrowValues)
+      return UnaryOperator::Create(Context, Input, Opc,
+                                   Context.getBorrowValueType(T), VK_PRValue,
+                                   OK_Ordinary, OpLoc, false,
+                                   CurFPFeatureOverrides());
+    return UnaryOperator::Create(Context, Input, Opc, T, VK_LValue,
+                                 OK_Ordinary, OpLoc, false,
+                                 CurFPFeatureOverrides());
+  }
+  // First things first: handle placeholders so that the
+  // overloaded-operator check considers the right type.
+  if (const BuiltinType *pty = Input->getType()->getAsPlaceholderType()) {
+    // Increment and decrement of pseudo-object references.
+    if (pty->getKind() == BuiltinType::PseudoObject &&
+        UnaryOperator::isIncrementDecrementOp(Opc))
+      return PseudoObject().checkIncDec(S, OpLoc, Opc, Input);
+
+    // extension is always a builtin operator.
+    if (Opc == UO_Extension)
+      return CreateBuiltinUnaryOp(OpLoc, Opc, Input);
+
+    // & gets special logic for several kinds of placeholder.
+    // The builtin code knows what to do.
+    if (Opc == UO_AddrOf &&
+        (pty->getKind() == BuiltinType::Overload ||
+         pty->getKind() == BuiltinType::UnknownAny ||
+         pty->getKind() == BuiltinType::BoundMember))
+      return CreateBuiltinUnaryOp(OpLoc, Opc, Input);
+
+    // Anything else needs to be handled now.
+    ExprResult Result = CheckPlaceholderExpr(Input);
+    if (Result.isInvalid()) return ExprError();
+    Input = Result.get();
+  }
+
+  if (getLangOpts().CPlusPlus && Input->getType()->isOverloadableType() &&
+      UnaryOperator::getOverloadedOperator(Opc) != OO_None &&
+      !(Opc == UO_AddrOf && isQualifiedMemberAccess(Input))) {
+    // Find all of the overloaded operators visible from this point.
+    UnresolvedSet<16> Functions;
+    OverloadedOperatorKind OverOp = UnaryOperator::getOverloadedOperator(Opc);
+    if (S && OverOp != OO_None)
+      LookupOverloadedOperatorName(OverOp, S, Functions);
+
+    return CreateOverloadedUnaryOp(OpLoc, Opc, Functions, Input);
+  }
+
+  return CreateBuiltinUnaryOp(OpLoc, Opc, Input, IsAfterAmp);
+}
