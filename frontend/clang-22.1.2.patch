+std::pair<const VarDecl *, CodeGenFunction::SafetyFieldPath>
+CodeGenFunction::getSafetyOwnedPlace(const Expr *E) {
+  SafetyFieldPath Path;
+  auto Source = [](const Expr *E) {
+    for (;;) {
+      E = E->IgnoreParens();
+      if (auto *V = dyn_cast<OpaqueValueExpr>(E); V && V->getSourceExpr()) E = V->getSourceExpr();
+      else return E;
+    }
+  };
+  E = Source(E);
+  while (const auto *Member = dyn_cast<MemberExpr>(E)) {
+    Path.push_back(cast<FieldDecl>(Member->getMemberDecl()));
+    E = Source(Member->getBase());
+  }
+  std::reverse(Path.begin(), Path.end());
+  // Relocation and replacement also apply to places that are not named local
+  // variables, such as the referent of a borrow or a generated choice payload.
+  // Such places carry no drop flag of their own, so no flag is maintained.
+  if (auto *Ref = dyn_cast<DeclRefExpr>(E))
+    if (auto *Var = dyn_cast<VarDecl>(Ref->getDecl())) {
+      if (Path.empty()) {
+        auto I = SafetyMatchBindingSources.find(Var);
+        if (I != SafetyMatchBindingSources.end()) {
+          return {I->second, SafetyFieldPath()};
+        }
+      }
+      if (Var->getType()->isReferenceType() && Var->hasInit() &&
+          Var->getInit() != E) {
+        auto [Owner, InnerPath] = getSafetyOwnedPlace(Var->getInit());
+        if (Owner) {
+          InnerPath.insert(InnerPath.end(), Path.begin(), Path.end());
+          return {Owner, std::move(InnerPath)};
+        }
+      }
+      return {Var, Path};
+    }
+  return {nullptr, SafetyFieldPath()};
+}
+
+void CodeGenFunction::ClearSafetyOwnedPlace(const Expr *E) {
+  auto [Owner, Path] = getSafetyOwnedPlace(E);
+  if (!Path.empty()) {
+    for (const auto &Field : SafetyFieldDropFlags)
+      if (Field.first.first == Owner && Path.size() <= Field.first.second.size() &&
+          std::equal(Path.begin(), Path.end(), Field.first.second.begin()))
+        Builder.CreateFlagStore(false, Field.second);
+  } else if (auto I = SafetyDropFlags.find(Owner); I != SafetyDropFlags.end())
+    Builder.CreateFlagStore(false, I->second);
+}
