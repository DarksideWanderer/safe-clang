+QualType ASTContext::getBorrowValueType(QualType T) const {
+  // A slice's mutability belongs to its elements, not to a qualifier on the
+  // borrow: `const [T; dyn]` is the slice whose elements are const, so a
+  // const-qualified slice record names the record of its const elements. This
+  // is the form the declarator path builds, and the form a `const auto^`
+  // deduction reaches once the element is known.
+  // A const borrow handle is ordinary const storage. Looking through it with
+  // circleSliceElement would erase that const when forming a borrow of the
+  // handle, incorrectly turning '^const handle' into an exclusive borrow.
+  if (!T->getAs<BorrowValueType>()) {
+    QualType Element = circleSliceElement(T);
+    if (!Element.isNull()) {
+      // The same generated slice can arrive from independent modules. A
+      // borrow names the builtin slice type, rather than a module-specific
+      // record identity; all such records use the context's canonical slice.
+      Qualifiers StorageQuals = T.getQualifiers();
+      StorageQuals.removeConst();
+      T = getQualifiedType(
+          getCircleSliceType(T.isConstQualified() ? getConstType(Element)
+                                                 : Element),
+          StorageQuals);
+    }
+  }
+  llvm::FoldingSetNodeID ID;
+  BorrowValueType::Profile(ID, T);
+  void *InsertPos = nullptr;
+  if (auto *Existing = BorrowValueTypes.FindNodeOrInsertPos(ID, InsertPos))
+    return QualType(Existing, 0);
+  QualType Canonical;
+  if (!T.isCanonical()) {
+    Canonical = getBorrowValueType(getCanonicalType(T));
+    BorrowValueTypes.FindNodeOrInsertPos(ID, InsertPos);
+  }
+  auto *New = new (*this, alignof(BorrowValueType)) BorrowValueType(T, Canonical);
+  Types.push_back(New);
+  BorrowValueTypes.InsertNode(New, InsertPos);
+  return QualType(New, 0);
+}
